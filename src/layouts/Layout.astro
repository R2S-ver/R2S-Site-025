        time += 0.007;

        particles.forEach((p, index) => {
          /*
              organic movement
              */

          p.vx += Math.sin(time * 3 + p.phase) * 0.008;

          p.vy += Math.cos(time * 2.5 + p.phase) * 0.008;

          /*
              random drift
              */

          p.driftTimer--;

          if (p.driftTimer <= 0) {
            p.targetDriftVx = (Math.random() - 0.5) * 0.2;

            p.targetDriftVy = (Math.random() - 0.5) * 0.2;

            p.driftTimer = 120 + Math.random() * 80;
          }

          p.driftVx += (p.targetDriftVx - p.driftVx) * 0.02;

          p.driftVy += (p.targetDriftVy - p.driftVy) * 0.02;

          p.vx += p.driftVx * 0.07;

          p.vy += p.driftVy * 0.07;

          /*
              mouse interaction
              */

          if (mouse.x !== null) {
            const dx = p.x - mouse.x;

            const dy = p.y - mouse.y;

            const dist = Math.sqrt(dx * dx + dy * dy);

            if (dist < mouse.radius && dist > 0.1) {
              const force = (1 - dist / mouse.radius) * 0.12;

              p.vx += (dx / dist) * force;

              p.vy += (dy / dist) * force;
            }
          }

          /*
