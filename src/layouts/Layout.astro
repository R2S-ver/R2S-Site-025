      window.addEventListener("mousemove", (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      });

      window.addEventListener("mouseout", () => {
        mouse.x = null;
        mouse.y = null;
      });

      function resize() {
        canvas.width = window.innerWidth;

        canvas.height = window.innerHeight;
      }

      resize();

      window.addEventListener("resize", () => {
        resize();

        initParticles();
      });

