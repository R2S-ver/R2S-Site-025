              */

          p.vx *= 0.992;

          p.vy *= 0.992;

          /*
              prevent stopping
              */

          const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);

          if (speed < 0.15) {
            p.vx += (Math.random() - 0.5) * 0.04;

            p.vy += (Math.random() - 0.5) * 0.04;
          }

          /*
              position
              */

          p.x += p.vx;

          p.y += p.vy;

          /*
              boundary
              */

          if (p.x < 0) {
            p.x = 0;

            p.vx *= -0.7;
          }

          if (p.x > canvas.width) {
            p.x = canvas.width;

            p.vx *= -0.7;
          }

          if (p.y < 0) {
            p.y = 0;

            p.vy *= -0.7;
          }

          if (p.y > canvas.height) {
            p.y = canvas.height;

            p.vy *= -0.7;
          }

          /*
              draw particle
              */

          ctx.fillStyle = p.color;

          ctx.shadowColor = p.color;

          ctx.shadowBlur = 12;

          ctx.beginPath();

          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);

          ctx.fill();

          ctx.shadowBlur = 0;

          /*
              connections
              */

          for (let j = index + 1; j < particles.length; j++) {
            const p2 = particles[j];

            const dx = p.x - p2.x;

            const dy = p.y - p2.y;

            const dist = Math.sqrt(dx * dx + dy * dy);

            if (dist < 140) {
              ctx.beginPath();

              ctx.strokeStyle = `rgba(255,255,255,${0.35 - dist / 500})`;

              ctx.lineWidth = 1;

              ctx.moveTo(p.x, p.y);

              ctx.lineTo(p2.x, p2.y);

              ctx.stroke();
            }
          }
        });

        requestAnimationFrame(animate);
      }

      animate();
    })();
