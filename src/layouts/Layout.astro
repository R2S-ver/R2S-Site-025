---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollMeter from "../components/ScrollMeter.astro";
import {
  getLanguageFromPath,
  getLocalizedPath,
  languageCodes,
  languageLocales,
  type Language,
} from "../utils/i18n";
import { getTranslations } from "../utils/translations";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  /** explicit alternate-language versions; undefined → all other languages auto-assumed; null → no alternates */
  alternateHrefs?: { lang: string; href: string }[] | null;
  noIndex?: boolean;
}

const {
  title = "RrSuika",
  description,
  ogImage,
  alternateHrefs,
  noIndex = false,
} = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const isZh = language === "zh";
const t = getTranslations(language);

// Art pages are frozen — exclude them from global heading font changes.
const isArtRoute =
  Astro.url.pathname === "/art" ||
  Astro.url.pathname.startsWith("/zh/art") ||
  Astro.url.pathname.startsWith("/nl/art");

const metaDescription = description ?? t.meta.description;

const allLanguages: Language[] = ["en", "zh", "nl"];

const alternates: { lang: string; href: string }[] =
  alternateHrefs === null
    ? []
    : alternateHrefs && alternateHrefs.length > 0
      ? alternateHrefs
      : allLanguages
          .filter((l) => l !== language)
          .map((l) => ({
            lang: languageCodes[l],
            href: getLocalizedPath(Astro.url.pathname, l),
          }));

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : null;

// x-default: the default-language version of this page.
const xDefaultPath =
  language === "en"
    ? Astro.url.pathname
    : getLocalizedPath(Astro.url.pathname, "en");

const xDefaultUrl = Astro.site ? new URL(xDefaultPath, Astro.site).href : null;

// Default share card; detail pages override with their cover image.
const ogImageUrl =
  Astro.site && (ogImage || "/og-card.png")
    ? new URL(ogImage ?? "/og-card.png", Astro.site).href
    : null;

// Structured data — WebSite entity, declared on every page.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "RrSuika",
  url: "https://r2s-site-025.pages.dev/",
  inLanguage: ["en", "zh", "nl"],
};
---

<!doctype html>
<html lang={getLanguageFromPath(Astro.url.pathname) || "en"}>
  <head>
    <!--
      THEME GUARD — must be the first thing in <head>.
      1. Synchronous script sets data-theme on <html> before any paint.
      2. CSS guard hides <body> until data-theme is present — safety net
         for browsers that paint progressively before scripts execute.
    -->
    <script is:inline>
      (() => {
        var key = "r2s-theme", stored;
        try { stored = localStorage.getItem(key); } catch (_) { stored = null; }
        if (stored === "light" || stored === "dark") {
          document.documentElement.setAttribute("data-theme", stored);
        } else {
          // First visit: default to dark mode
          document.documentElement.setAttribute("data-theme", "dark");
        }
        document.documentElement.classList.add("js");
      })();
    </script>
    <style is:global>
      html:not([data-theme]) body { visibility: hidden; }
    </style>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f0ebe0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07070d" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800;900&family=Saira+Condensed:wght@500;600;700;800;900&family=VT323&display=swap"
      rel="stylesheet"
    />

    <!-- 得意黑 Smiley Sans Oblique — self-hosted subsets (OFL, cn-font-split) -->
    <link rel="stylesheet" href="/fonts/dyh/result.css" />

    <ClientRouter />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

    <title>{title}</title>

    <meta name="description" content={metaDescription} />

    {noIndex && <meta name="robots" content="noindex" />}

    {canonical && <link rel="canonical" href={canonical} />}

    {
      Astro.site &&
        alternates.map((a) => (
          <link
            rel="alternate"
            hreflang={a.lang}
            href={new URL(a.href, Astro.site).href}
          />
        ))
    }

    {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}

    <meta property="og:site_name" content="RrSuika" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languageLocales[language]} />
    {
      allLanguages
        .filter((l) => l !== language)
        .map((l) => (
          <meta property="og:locale:alternate" content={languageLocales[l]} />
        ))
    }
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteSchema)}
    />
  </head>

  <body class:list={{ "art-route": isArtRoute }}>
    <!-- =========================================
         SKIP LINK — keyboard navigation
    ========================================== -->

    <a class="skip-link" href="#main-content">SKIP_TO_CONTENT &gt;</a>

    <!-- =========================================
         MOBILE NOTICE — desktop mode recommended
         (mobile only, dismissible)
    ========================================== -->

    <div id="mobile-notice" role="status">
      <span class="notice-dot" aria-hidden="true"></span>
      <span class="notice-text">
        {language === "zh"
          ? "系统提示 // 建议使用电脑访问，桌面模式效果最佳"
          : language === "nl"
            ? "SYSTEEM_MELDING // HET BESTE TE BEKIJKEN IN DESKTOPMODUS"
            : "SYSTEM_NOTICE // BEST VIEWED IN DESKTOP MODE"}
      </span>
      <button class="notice-close" type="button" aria-label={isZh ? "关闭提示" : language === "nl" ? "Sluiten" : "Dismiss"}>
        ×
      </button>
    </div>

    <!-- =========================================
         NEURAL NETWORK BACKGROUND (weakened)
    ========================================== -->

    <canvas id="neural-canvas" aria-hidden="true"></canvas>

    <!-- =========================================
         GLOBAL CONTENT
    ========================================== -->

    <div class="site-content">
      <header>
        <Navbar />
      </header>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>

    <ScrollMeter />

    <!-- =========================================
         CRT OVERLAY
    ========================================== -->

    <div id="crt-overlay"></div>

    <div id="tube-vignette"></div>

    <div id="crt-glitch" aria-hidden="true"></div>

    <!-- =========================================
         NEURAL NETWORK SCRIPT — weakened version:
         fewer particles, softer glow, gentler
         mouse repulsion, dimmer connections.
         Tuning knobs: density / shadowBlur /
         CONNECTION_DIST / mouse.radius / force.
    ========================================== -->

    <script>
      (() => {
        // ClientRouter re-executes body scripts per navigation —
        // run the particle engine only once per session.
        const state = window as unknown as { __r2sNeuralStarted?: boolean };

        if (state.__r2sNeuralStarted) return;

        state.__r2sNeuralStarted = true;

        const canvas = document.getElementById(
          "neural-canvas",
        ) as HTMLCanvasElement | null;

        if (!canvas) return;

        const ctx = canvas.getContext("2d");

        if (!ctx) return;

        let particles: any[] = [];

        const mouse = {
          x: null as number | null,
          y: null as number | null,
          radius: 140,
        };

        const CONNECTION_DIST = 140;

        let time = 0;

        /* =========================================
           TELEMETRY PACKETS — small bright dots
           riding the connection lines (NASA-punk)
        ========================================== */

        const packetCap = window.innerWidth < 900 ? 3 : 7;

        const packets: {
          ax: number;
          ay: number;
          bx: number;
          by: number;
          t: number;
          speed: number;
          color: string;
        }[] = [];

        for (let i = 0; i < packetCap; i++) {
          packets.push({
            ax: 0,
            ay: 0,
            bx: 0,
            by: 0,
            t: Math.random(),
            speed: 0.004 + Math.random() * 0.008,
            color:
              Math.random() > 0.5
                ? "rgba(240,184,96,0.95)"
                : "rgba(94,223,255,0.9)",
          });
        }

        /* =========================================
           MOUSE
        ========================================== */

        window.addEventListener("mousemove", (event) => {
          mouse.x = event.clientX;
          mouse.y = event.clientY;
        });

        window.addEventListener("mouseout", () => {
          mouse.x = null;
          mouse.y = null;
        });

        /* =========================================
           RESIZE
        ========================================== */

        function resize() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }

        /* =========================================
           PARTICLES
        ========================================== */

        function initParticles() {
          particles = [];

          const density = window.innerWidth < 900 ? 70 : 140;

          for (let i = 0; i < density; i++) {
            particles.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,

              vx: (Math.random() - 0.5) * 0.4,

              vy: (Math.random() - 0.5) * 0.4,

              size: Math.random() * 2.2 + 1,

              color:
                Math.random() > 0.45
                  ? "rgba(255,95,31,0.9)"
                  : "rgba(0,176,255,0.9)",

              phase: Math.random() * Math.PI * 2,

              driftVx: 0,
              driftVy: 0,

              targetDriftVx: 0,
              targetDriftVy: 0,

              driftTimer: Math.random() * 100,
            });
          }
        }

        resize();

        initParticles();

        window.addEventListener("resize", () => {
          resize();
          initParticles();
        });

        /* =========================================
           ANIMATION
        ========================================== */

        function animate() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          time += 0.007;

          const connections: {
            ax: number;
            ay: number;
            bx: number;
            by: number;
          }[] = [];

          particles.forEach((particle, index) => {
            /* ---------------------------------
                 Organic movement
              --------------------------------- */

            particle.vx += Math.sin(time * 3 + particle.phase) * 0.008;

            particle.vy += Math.cos(time * 2.5 + particle.phase) * 0.008;

            /* ---------------------------------
                 Random drift
              --------------------------------- */

            particle.driftTimer--;

            if (particle.driftTimer <= 0) {
              particle.targetDriftVx = (Math.random() - 0.5) * 0.2;

              particle.targetDriftVy = (Math.random() - 0.5) * 0.2;

              particle.driftTimer = 120 + Math.random() * 80;
            }

            particle.driftVx +=
              (particle.targetDriftVx - particle.driftVx) * 0.02;

            particle.driftVy +=
              (particle.targetDriftVy - particle.driftVy) * 0.02;

            particle.vx += particle.driftVx * 0.07;

            particle.vy += particle.driftVy * 0.07;

            /* ---------------------------------
                 Mouse interaction
              --------------------------------- */

            if (mouse.x !== null && mouse.y !== null) {
              const dx = particle.x - mouse.x;

              const dy = particle.y - mouse.y;

              const distance = Math.sqrt(dx * dx + dy * dy);

              if (distance < mouse.radius && distance > 0.1) {
                const force = (1 - distance / mouse.radius) * 0.08;

                particle.vx += (dx / distance) * force;

                particle.vy += (dy / distance) * force;
              }
            }

            /* ---------------------------------
                 Damping
              --------------------------------- */

            particle.vx *= 0.992;
            particle.vy *= 0.992;

            /* ---------------------------------
                 Prevent stopping
              --------------------------------- */

            const speed = Math.sqrt(
              particle.vx * particle.vx + particle.vy * particle.vy,
            );

            if (speed < 0.15) {
              particle.vx += (Math.random() - 0.5) * 0.04;

              particle.vy += (Math.random() - 0.5) * 0.04;
            }

            /* ---------------------------------
                 Position
              --------------------------------- */

            particle.x += particle.vx;

            particle.y += particle.vy;

            /* ---------------------------------
                 Boundaries
              --------------------------------- */

            if (particle.x < 0) {
              particle.x = 0;

              particle.vx *= -0.7;
            }

            if (particle.x > canvas.width) {
              particle.x = canvas.width;

              particle.vx *= -0.7;
            }

            if (particle.y < 0) {
              particle.y = 0;

              particle.vy *= -0.7;
            }

            if (particle.y > canvas.height) {
              particle.y = canvas.height;

              particle.vy *= -0.7;
            }

            /* ---------------------------------
                 Draw particle
              --------------------------------- */

            ctx.fillStyle = particle.color;

            ctx.shadowColor = particle.color;

            ctx.shadowBlur = 8;

            ctx.beginPath();

            ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);

            ctx.fill();

            ctx.shadowBlur = 0;

            /* ---------------------------------
                 Connections
              --------------------------------- */

            for (let j = index + 1; j < particles.length; j++) {
              const other = particles[j];

              const dx = particle.x - other.x;

              const dy = particle.y - other.y;

              const distance = Math.sqrt(dx * dx + dy * dy);

              if (distance < CONNECTION_DIST) {
                ctx.beginPath();

                ctx.strokeStyle = `rgba(255,255,255,${0.22 - distance / 500})`;

                ctx.lineWidth = 1;

                ctx.moveTo(particle.x, particle.y);

                ctx.lineTo(other.x, other.y);

                ctx.stroke();

                connections.push({
                  ax: particle.x,
                  ay: particle.y,
                  bx: other.x,
                  by: other.y,
                });
              }
            }
          });

          /* ---------------------------------
               Draw telemetry packets
            --------------------------------- */

          if (connections.length > 0) {
            packets.forEach((packet) => {
              packet.t += packet.speed;

              if (packet.t >= 1) {
                const line =
                  connections[
                    (Math.random() * connections.length) | 0
                  ];

                packet.ax = line.ax;
                packet.ay = line.ay;
                packet.bx = line.bx;
                packet.by = line.by;

                packet.t = 0;
              }

              const px = packet.ax + (packet.bx - packet.ax) * packet.t;
              const py = packet.ay + (packet.by - packet.ay) * packet.t;

              ctx.fillStyle = packet.color;

              ctx.shadowColor = packet.color;

              ctx.shadowBlur = 6;

              ctx.beginPath();

              ctx.arc(px, py, 1.6, 0, Math.PI * 2);

              ctx.fill();

              ctx.shadowBlur = 0;
            });
          }

          requestAnimationFrame(animate);
        }

        animate();
      })();
    </script>

    <!-- ── Sound engine (B9) — synthesized cassette FX, default OFF ── -->
    <script>
      (() => {
        const KEY = "r2s-snd";

        let ctx: AudioContext | null = null;

        function ac(): AudioContext | null {
          if (!ctx) {
            const AC =
              window.AudioContext ||
              (window as unknown as { webkitAudioContext?: typeof AudioContext })
                .webkitAudioContext;

            if (!AC) return null;

            ctx = new AC();
          }

          if (ctx.state === "suspended") {
            ctx.resume().catch(() => {});
          }

          return ctx;
        }

        function blip(
          freqFrom: number,
          freqTo: number,
          dur: number,
          gain = 0.08,
          type: OscillatorType = "square",
        ) {
          const c = ac();

          if (!c) return;

          const osc = c.createOscillator();
          const g = c.createGain();

          osc.type = type;

          osc.frequency.setValueAtTime(freqFrom, c.currentTime);
          osc.frequency.exponentialRampToValueAtTime(
            Math.max(freqTo, 1),
            c.currentTime + dur,
          );

          g.gain.setValueAtTime(gain, c.currentTime);
          g.gain.exponentialRampToValueAtTime(0.0001, c.currentTime + dur);

          osc.connect(g);
          g.connect(c.destination);

          osc.start();
          osc.stop(c.currentTime + dur);
        }

        function hiss(dur: number, freq: number, gain = 0.05) {
          const c = ac();

          if (!c) return;

          const len = Math.floor(c.sampleRate * dur);
          const buffer = c.createBuffer(1, len, c.sampleRate);
          const data = buffer.getChannelData(0);

          for (let i = 0; i < len; i++) {
            data[i] = (Math.random() * 2 - 1) * (1 - i / len);
          }

          const src = c.createBufferSource();
          const filter = c.createBiquadFilter();
          const g = c.createGain();

          src.buffer = buffer;

          filter.type = "bandpass";
          filter.frequency.value = freq;
          filter.Q.value = 0.8;

          g.gain.value = gain;

          src.connect(filter);
          filter.connect(g);
          g.connect(c.destination);

          src.start();
        }

        const fx = {
          click() {
            blip(1700, 500, 0.05, 0.05);
            hiss(0.03, 3200, 0.03);
          },
          load() {
            hiss(0.16, 900, 0.05);
            blip(120, 320, 0.16, 0.05, "triangle");
          },
          rewind() {
            for (let i = 0; i < 4; i++) {
              setTimeout(() => blip(900 - i * 120, 300, 0.045, 0.05), i * 70);
            }
          },
          play() {
            blip(660, 990, 0.09, 0.06);
          },
        };

        window.__r2sSnd = {
          get enabled() {
            try {
              return localStorage.getItem(KEY) === "on";
            } catch (_) {
              return false;
            }
          },
          toggle() {
            const next = !this.enabled;

            try {
              localStorage.setItem(KEY, next ? "on" : "off");
            } catch (_) {}

            ac();

            if (next) fx.click();

            return next;
          },
          click: () => {
            if (window.__r2sSnd.enabled) fx.click();
          },
          load: () => {
            if (window.__r2sSnd.enabled) fx.load();
          },
          rewind: () => {
            if (window.__r2sSnd.enabled) fx.rewind();
          },
          play: () => {
            if (window.__r2sSnd.enabled) fx.play();
          },
        };

        // Sync SND toggle UI state (navbar button)
        document
          .querySelectorAll<HTMLElement>("[data-snd-btn]")
          .forEach((btn) => {
            btn.classList.toggle("on", window.__r2sSnd.enabled);
          });
      })();
    </script>

    <!-- ── CRT glitch (B7) — rare, switchable, reduced-motion aware ── -->
    <script>
      (() => {
        const el = document.getElementById("crt-glitch");

        if (!el) return;

        const reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        let enabled = true;

        try {
          enabled = localStorage.getItem("r2s-glitch") !== "off";
        } catch (_) {}

        window.__toggleGlitch = function () {
          enabled = !enabled;

          try {
            localStorage.setItem("r2s-glitch", enabled ? "on" : "off");
          } catch (_) {}

          el.style.display = enabled ? "" : "none";

          return enabled;
        };

        if (!enabled || reduced) {
          el.style.display = "none";
        }

        // Sync GLITCH toggle UI state (footer button)
        document
          .querySelectorAll<HTMLElement>("[data-glitch-btn]")
          .forEach((btn) => {
            btn.classList.toggle("off", !enabled);
          });

        function zap() {
          if (!enabled || reduced) return;

          el.classList.add("active");

          setTimeout(
            () => el.classList.remove("active"),
            120 + Math.random() * 160,
          );
        }

        function loop() {
          setTimeout(
            () => {
              zap();
              loop();
            },
            20000 + Math.random() * 24000,
          );
        }

        // Single glitch loop per session (ClientRouter re-runs scripts)
        const state = window as unknown as { __r2sGlitchLoop?: boolean };

        if (!state.__r2sGlitchLoop) {
          state.__r2sGlitchLoop = true;
          loop();
        }
      })();
    </script>

    <!-- ── Scroll reveal (B5) — sections marked [data-reveal] ── -->
    <script>
      (() => {
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          return;
        }

        const els = document.querySelectorAll("[data-reveal]");

        if (!els.length) return;

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );

        els.forEach((el) => io.observe(el));
      })();
    </script>

    <!-- ── Theme toggle (init is in <head> to prevent flash) ── -->
    <script>
      (() => {
        var KEY = "r2s-theme";
        window.__toggleTheme = function () {
          var cur = document.documentElement.getAttribute("data-theme");
          var next = cur === "light" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem(KEY, next); } catch (_) {}
        };
      })();
    </script>
    <!-- ── Mobile notice dismiss: click × (session-scoped) ── -->
    <script>
      (() => {
        var KEY = "r2s-mobile-notice";
        var notice = document.getElementById("mobile-notice");
        if (!notice) return;
        try {
          if (sessionStorage.getItem(KEY) === "dismissed") {
            notice.hidden = true;
            return;
          }
        } catch (_) {}

        var dismissed = false;
        function dismissNotice() {
          if (dismissed) return;
          dismissed = true;
          // 淡出动画结束后再移除
          notice.classList.add("notice-leave");
          setTimeout(() => {
            notice.hidden = true;
          }, 450);
          try { sessionStorage.setItem(KEY, "dismissed"); } catch (_) {}
        }

        var close = notice.querySelector(".notice-close");
        close?.addEventListener("click", dismissNotice);
      })();
    </script>
  </body>
</html>
