---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getProjectImage } from '../../../utils/images';
import { Image } from 'astro:assets';



export async function getStaticPaths() {


  const entries = await getCollection('entries');


  return entries.map((entry) => ({

    params:{

      type: entry.data.type,

      slug: entry.id,

    },


    props:{

      project: entry,

    },

  }));

}



const { project } = Astro.props;



const { Content } = await render(project);



const cover = project.data.cover
  ? getProjectImage(
      project.id,
      project.data.cover
    )
  : null;



const date = project.data.date.toLocaleDateString(
  'en-US',
  {
    year:'numeric',
    month:'long',
  }
);

---
<Layout title={project.data.title}>


<main class="project">



<section class="hero">



<div class="cover">


{
cover && (

<Image

src={cover}

alt={project.data.title}

/>

)
}


</div>





<div class="hero-text">


<h1>
{project.data.title}
</h1>


<p class="description">
{project.data.description}
</p>


</div>



</section>







<section class="info">


<div>

<h3>
Year
</h3>

<p>
{date}
</p>

</div>





<div>

<h3>
Type
</h3>

<p>
{project.data.type}
</p>

</div>





<div>

<h3>
Category
</h3>

<p>
{project.data.category}
</p>

</div>





<div>

<h3>
Tools
</h3>

<p>

{
project.data.tools?.join(" · ")
}

</p>

</div>



</section>







<div class="tags">


{
project.data.tags?.map((tag)=>(

<span class="tag">
#{tag}
</span>

))
}


</div>







<hr />






<article>

<Content />

</article>





</main>


</Layout>







<style>


.project{

max-width:1100px;

margin:auto;

}





.hero{

    display:grid;

    grid-template-columns:
    minmax(0,1fr)
    minmax(0,1fr);


    gap:60px;


    align-items:center;


    margin-bottom:80px;

    max-width:1000px;

}





.cover{

    width:100%;

    aspect-ratio:4 / 3;

    overflow:hidden;

    border-radius:24px;

}



.cover img{

    width:100%;

    height:100%;

    object-fit:cover;

    display:block;

}






.hero-text h1{


font-size:56px;


line-height:1.15;


margin-bottom:25px;


}






.description{


font-size:22px;


line-height:1.5;


color:#666;


}






.info{


display:grid;


grid-template-columns:

repeat(4,1fr);


gap:30px;


margin-bottom:40px;


}






.info h3{


font-size:13px;


text-transform:uppercase;


color:#777;


margin-bottom:8px;


letter-spacing:1px;


}






.info p{


font-size:18px;


}







.tags{


display:flex;


gap:10px;


flex-wrap:wrap;


margin-bottom:60px;


}






.tag{


background:#f1f1f1;


padding:

6px 14px;


border-radius:999px;


font-size:14px;


}







hr{


border:none;


border-top:

1px solid #ddd;


margin-bottom:60px;


}







article{


font-size:18px;


line-height:1.8;


}






article img{


max-width:100%;


border-radius:16px;


}






pre{


background:#f5f5f5;


padding:20px;


border-radius:12px;


overflow-x:auto;


}







@media(max-width:800px){



.hero{


grid-template-columns:

1fr;


}





.hero-text h1{


font-size:40px;


}






.info{


grid-template-columns:

1fr 1fr;


}



}



</style>