---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import ProjectDetail from "../../../components/ProjectDetail.astro";
import ArtGallery from "../../../components/ArtGallery.astro";
import { findTranslation, getLocalizedPath } from "../../../utils/i18n";
import { getProjectImage } from "../../../utils/images";

export async function getStaticPaths() {
  const entries = await getCollection("entries");

  const englishEntries = entries.filter((entry) => entry.data.lang === "en" && entry.data.type !== "art");

  return englishEntries.map((entry) => {
    const projectSlug = entry.id.split("/")[0];

    const translation = findTranslation(entries, entry, "zh");

    return {
      params: {
        type: entry.data.type,
        slug: projectSlug,
      },

      props: {
        project: entry,
        projectId: projectSlug,
        translation,
      },
    };
  });
}

const { project, projectId, translation } = Astro.props;

const { Content } = await render(project);

// getProjectImage returns a URL string, or an ImageMetadata object
// (Astro image globs) whose .src holds the final URL.
const coverRaw = project.data.cover
  ? (getProjectImage(projectId, project.data.cover) as
      | string
      | { src: unknown }
      | null)
  : null;

const coverImage =
  typeof coverRaw === "string"
    ? coverRaw
    : coverRaw && "src" in coverRaw
      ? String(coverRaw.src)
      : null;

const alternateHref = translation
  ? getLocalizedPath(Astro.url.pathname, translation.data.lang)
  : null;
---

<Layout
  title={project.data.title}
  description={project.data.description}
  ogImage={coverImage}
  alternateHref={alternateHref}
>
  {project.data.type === "art" ? (
    <ArtGallery project={project} projectId={projectId} />
  ) : (
    <ProjectDetail
      project={project}
      projectId={projectId}
      Content={Content}
      translation={translation}
    />
  )}
</Layout>
