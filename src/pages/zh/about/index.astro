---
import Layout from "../../../layouts/Layout.astro";
import { getLanguageFromPath } from "../../../utils/i18n";
import { getTranslations } from "../../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const about = t.sections.about;
---

<Layout title={`${about.title} | R2S Studio`}>
  <section class="about">
    <h1>{about.title}</h1>

    <p>{about.subtitle}</p>

    <p>{about.description}</p>
  </section>
</Layout>

<style>
  .about {
    max-width: 800px;
    margin: auto;
  }

  h1 {
    font-size: 64px;
    margin-bottom: 40px;
  }

  p {
    font-size: 20px;
    line-height: 1.8;
    margin-bottom: 20px;
  }
</style>
