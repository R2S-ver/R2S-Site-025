---
import { getCollection, render } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import ProjectDetail from "../../../../components/ProjectDetail.astro";
import ArtGallery from "../../../../components/ArtGallery.astro";
import { findTranslation, getLocalizedPath } from "../../../../utils/i18n";
import { getProjectImage } from "../../../../utils/images";

export async function getStaticPaths() {
  const entries = await getCollection("entries");

  const translatedEntries = entries.filter((entry) => entry.data.lang === "zh" && entry.data.type !== "art");

  return translatedEntries.map((entry) => {
    const projectSlug = entry.id.split("/")[0];

    const translation = findTranslation(entries, entry, "en");

    return {
      params: {
        lang: "zh",
        type: entry.data.type,
        slug: projectSlug,
      },

      props: {
        project: entry,
        projectId: projectSlug,
        translation,
      },
    };
  });
}

const { project, projectId, translation } = Astro.props;

const { Content } = await render(project);

// getProjectImage returns a URL string, or an ImageMetadata object
// (Astro image globs) whose .src holds the final URL.
const coverRaw = project.data.cover
  ? (getProjectImage(projectId, project.data.cover) as
      | string
      | { src: unknown }
      | null)
  : null;

const coverImage =
  typeof coverRaw === "string"
    ? coverRaw
    : coverRaw && "src" in coverRaw
      ? String(coverRaw.src)
      : null;

const alternateHref = translation
  ? getLocalizedPath(Astro.url.pathname, translation.data.lang)
  : null;

// 译文条目的封面图（供嵌套的 translationOfWork 项使用）
const translationCoverRaw = translation?.data.cover
  ? (getProjectImage(
      translation.id.split("/")[0],
      translation.data.cover,
    ) as string | { src: unknown } | null)
  : null;

const translationCover =
  typeof translationCoverRaw === "string"
    ? translationCoverRaw
    : translationCoverRaw && "src" in translationCoverRaw
      ? String(translationCoverRaw.src)
      : null;

const authorRef = {
  "@type": "Person",
  name: "R2S Studio",
  url: "https://r2s-site-025.pages.dev/about",
};

// 结构化数据 — 详情页 TechArticle 实体
// 日期为完整 ISO-8601 日期时间（schema.org 要求带时区信息）
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: project.data.title,
  description: project.data.description ?? undefined,
  image: coverImage ?? undefined,
  datePublished: project.data.date.toISOString(),
  // 无独立修改日期数据，回退为发布日期
  dateModified: project.data.date.toISOString(),
  inLanguage: project.data.lang === "zh" ? "zh-CN" : "en",
  author: authorRef,
  mainEntityOfPage: Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined,
  translationOfWork: translation
    ? {
        "@type": "TechArticle",
        headline: translation.data.title,
        description: translation.data.description ?? undefined,
        image: translationCover ?? undefined,
        datePublished: translation.data.date.toISOString(),
        dateModified: translation.data.date.toISOString(),
        inLanguage: translation.data.lang === "zh" ? "zh-CN" : "en",
        author: authorRef,
        url: Astro.site
          ? new URL(
              getLocalizedPath(Astro.url.pathname, translation.data.lang),
              Astro.site,
            ).href
          : undefined,
      }
    : undefined,
};
---

<Layout
  title={`${project.data.title} | R2S Studio`}
  description={project.data.description}
  ogImage={coverImage}
  alternateHref={alternateHref}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleSchema)}
  />

  {project.data.type === "art" ? (
    <ArtGallery project={project} projectId={projectId} />
  ) : (
    <ProjectDetail
      project={project}
      projectId={projectId}
      Content={Content}
      translation={translation}
    />
  )}
</Layout>
