---
import Layout from "../../layouts/Layout.astro";
import { getLanguageFromPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);
---

<Layout title={`${t.sections.about.title} | R2S Studio`}>
  <main class="about-page">
    <!-- ========================
    HERO
    ======================== -->

    <section class="about-hero">
      <div class="hero-meta">
        <span>{t.sections.about.pageTag}</span>
        <span>{t.sections.about.pageStatus}</span>
      </div>

      <div class="hero-content">
        <div class="hero-main">
          <div class="eyebrow">
            {t.sections.about.eyebrow}
          </div>

          <h1>
            {t.sections.about.title}
          </h1>

          <p class="subtitle">
            {t.sections.about.subtitle}
          </p>
        </div>

        <div class="hero-index">
          <span>MODULE</span>
          <strong>01</strong>
        </div>
      </div>
    </section>

    <!-- ========================
    INTRODUCTION
    ======================== -->

    <section class="intro-section">
      <div class="section-label">// 01 — INTRODUCTION</div>

      <div class="intro-grid">
        <div class="intro-heading">
          <h2>
            {t.sections.about.introTitle}
          </h2>
        </div>

        <div class="intro-text">
          <p class="intro-lead">
            {t.sections.about.description}
          </p>

          <p>
            {t.sections.about.introText}
          </p>
        </div>
      </div>
    </section>

    <!-- ========================
    IDENTITY
    ======================== -->

    <section class="identity-section">
      <div class="section-label">// 02 — IDENTITY</div>

      <div class="identity-grid">
        <div class="identity-title">
          <span>R2S_STUDIO</span>

          <h2>
            {t.sections.about.identity.title}
          </h2>
        </div>

        <div class="identity-text">
          <p>
            {t.sections.about.identity.text}
          </p>

          <p>
            {t.sections.about.identity.second}
          </p>
        </div>
      </div>
    </section>

    <!-- ========================
    DOSSIER
    ======================== -->

    <section class="dossier-section">
      <div class="section-label">// 03 — PERSONNEL DOSSIER</div>

      <div class="dossier">
        <div class="dossier-header">
          <span>
            {t.sections.about.dossier.header}
          </span>

          <span class="online">
            {t.sections.about.dossier.status}
          </span>
        </div>

        <div class="dossier-body">
          <div class="identity">
            <div class="identity-label">
              {t.sections.about.dossier.operator}
            </div>

            <h2>R2S Studio</h2>

            <p>
              {t.sections.about.dossier.role}
            </p>
          </div>

          <div class="dossier-data">
            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.locationLabel}
              </span>

              <span>
                {t.sections.about.dossier.location}
              </span>
            </div>

            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.fieldLabel}
              </span>

              <span>
                {t.sections.about.dossier.field}
              </span>
            </div>

            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.focusLabel}
              </span>

              <span>
                {t.sections.about.dossier.focus}
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================
    PHILOSOPHY
    ======================== -->

    <section class="philosophy-section">
      <div class="section-label">// 04 — PERSONAL PROTOCOL</div>

      <div class="philosophy-grid">
        <div class="philosophy-heading">
          <span class="small-label">
            {t.sections.about.philosophy.header}
          </span>

          <h2>
            {t.sections.about.philosophy.title}
          </h2>
        </div>

        <div class="philosophy-text">
          <p class="lead">
            {t.sections.about.philosophy.text}
          </p>

          <p>
            {t.sections.about.philosophy.second}
          </p>

          <div class="motto">
            <span>
              {t.sections.about.philosophy.mottoLabel}
            </span>

            <strong>
              {t.sections.about.philosophy.motto}
            </strong>

            <p>
              {t.sections.about.philosophy.mottoText}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================
    APPROACH
    ======================== -->

    <section class="approach-section">
      <div class="section-label">// 05 — DESIGN APPROACH</div>

      <div class="approach-grid">
        <article class="approach-card">
          <span class="card-number">01</span>

          <h3>
            {t.sections.about.approach.research.title}
          </h3>

          <p>
            {t.sections.about.approach.research.description}
          </p>
        </article>

        <article class="approach-card">
          <span class="card-number">02</span>

          <h3>
            {t.sections.about.approach.concept.title}
          </h3>

          <p>
            {t.sections.about.approach.concept.description}
          </p>
        </article>

        <article class="approach-card">
          <span class="card-number">03</span>

          <h3>
            {t.sections.about.approach.build.title}
          </h3>

          <p>
            {t.sections.about.approach.build.description}
          </p>
        </article>

        <article class="approach-card">
          <span class="card-number">04</span>

          <h3>
            {t.sections.about.approach.refine.title}
          </h3>

          <p>
            {t.sections.about.approach.refine.description}
          </p>
        </article>
      </div>
    </section>

    <!-- ========================
    WORKFLOW
    ======================== -->

    <section class="workflow-section">
      <div class="section-label">// 06 — CREATIVE PIPELINE</div>

      <div class="workflow-panel">
        <div class="workflow-header">
          <span>
            {t.sections.about.workflow.header}
          </span>

          <span> 05_STAGES </span>
        </div>

        <div class="workflow-grid">
          <div class="workflow-step">
            <span>01</span>

            <h3>
              {t.sections.about.workflow.concept.title}
            </h3>

            <p>
              {t.sections.about.workflow.concept.description}
            </p>
          </div>

          <div class="workflow-step">
            <span>02</span>

            <h3>
              {t.sections.about.workflow.design.title}
            </h3>

            <p>
              {t.sections.about.workflow.design.description}
            </p>
          </div>

          <div class="workflow-step">
            <span>03</span>

            <h3>
              {t.sections.about.workflow.prototype.title}
            </h3>

            <p>
              {t.sections.about.workflow.prototype.description}
            </p>
          </div>

          <div class="workflow-step">
            <span>04</span>

            <h3>
              {t.sections.about.workflow.system.title}
            </h3>

            <p>
              {t.sections.about.workflow.system.description}
            </p>
          </div>

          <div class="workflow-step">
            <span>05</span>

            <h3>
              {t.sections.about.workflow.iteration.title}
            </h3>

            <p>
              {t.sections.about.workflow.iteration.description}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================
    CAPABILITIES
    ======================== -->

    <section class="capabilities-section">
      <div class="section-label">// 07 — CAPABILITY MATRIX</div>

      <div class="capability-panel">
        <div class="capability-header">
          <span>
            {t.sections.about.capabilities.header}
          </span>

          <span>
            STATUS:
            <strong>ACTIVE</strong>
          </span>
        </div>

        <div class="capability-grid">
          <div class="capability">
            <span class="cap-index">01</span>

            <h3>
              {t.sections.about.capabilities.industrial.title}
            </h3>

            <p>
              {t.sections.about.capabilities.industrial.description}
            </p>
          </div>

          <div class="capability">
            <span class="cap-index">02</span>

            <h3>
              {t.sections.about.capabilities.mechanical.title}
            </h3>

            <p>
              {t.sections.about.capabilities.mechanical.description}
            </p>
          </div>

          <div class="capability">
            <span class="cap-index">03</span>

            <h3>
              {t.sections.about.capabilities.electronics.title}
            </h3>

            <p>
              {t.sections.about.capabilities.electronics.description}
            </p>
          </div>

          <div class="capability">
            <span class="cap-index">04</span>

            <h3>
              {t.sections.about.capabilities.embedded.title}
            </h3>

            <p>
              {t.sections.about.capabilities.embedded.description}
            </p>
          </div>

          <div class="capability">
            <span class="cap-index">05</span>

            <h3>
              {t.sections.about.capabilities.fabrication.title}
            </h3>

            <p>
              {t.sections.about.capabilities.fabrication.description}
            </p>
          </div>

          <div class="capability">
            <span class="cap-index">06</span>

            <h3>
              {t.sections.about.capabilities.visual.title}
            </h3>

            <p>
              {t.sections.about.capabilities.visual.description}
            </p>
          </div>

          <div class="capability">
            <span class="cap-index">07</span>

            <h3>
              {t.sections.about.capabilities.software.title}
            </h3>

            <p>
              {t.sections.about.capabilities.software.description}
            </p>
          </div>

          <div class="capability">
            <span class="cap-index">08</span>

            <h3>
              {t.sections.about.capabilities.teaching.title}
            </h3>

            <p>
              {t.sections.about.capabilities.teaching.description}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================
    JOURNEY
    ======================== -->

    <section class="journey-section">
      <div class="section-label">// 08 — DEVELOPMENT PATH</div>

      <div class="journey-grid">
        <div class="journey-heading">
          <span>
            {t.sections.about.journey.header}
          </span>

          <h2>
            {t.sections.about.journey.title}
          </h2>
        </div>

        <div class="journey-text">
          <p class="lead">
            {t.sections.about.journey.text}
          </p>

          <p>
            {t.sections.about.journey.second}
          </p>

          <p>
            {t.sections.about.journey.third}
          </p>

          <p>
            {t.sections.about.journey.fourth}
          </p>
        </div>
      </div>
    </section>

    <!-- ========================
    CURRENT RESEARCH
    ======================== -->

    <section class="current-section">
      <div class="section-label">// 09 — CURRENT RESEARCH</div>

      <div class="current-grid">
        <div class="current-item">
          <span>01</span>
          <p>{t.sections.about.current.design}</p>
        </div>

        <div class="current-item">
          <span>02</span>
          <p>{t.sections.about.current.technology}</p>
        </div>

        <div class="current-item">
          <span>03</span>
          <p>{t.sections.about.current.making}</p>
        </div>

        <div class="current-item">
          <span>04</span>
          <p>{t.sections.about.current.visual}</p>
        </div>

        <div class="current-item current-ai">
          <span>05</span>
          <p>{t.sections.about.current.ai}</p>
        </div>
      </div>
    </section>

    <!-- ========================
    FUTURE
    ======================== -->

    <section class="future-section">
      <div class="section-label">// 10 — NEXT ITERATION</div>

      <div class="future-grid">
        <div class="future-heading">
          <span>
            {t.sections.about.future.header}
          </span>

          <div class="future-symbol">→</div>
        </div>

        <div class="future-text">
          <p class="lead">
            {t.sections.about.future.text}
          </p>

          <p>
            {t.sections.about.future.second}
          </p>

          <p>
            {t.sections.about.future.third}
          </p>
        </div>
      </div>
    </section>

    <!-- ========================
    CLOSING
    ======================== -->

    <section class="closing-section">
      <div class="closing-line"></div>

      <p>
        {t.sections.about.closing}
      </p>

      <div class="closing-status">&gt; SYSTEM_READY_</div>
    </section>
  </main>
</Layout>

<style>
  .about-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 40px 120px;
    font-family: var(--font-mono);
  }

  .section-label {
    margin-bottom: 30px;
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 2px;
  }

  /* HERO */

  .about-hero {
    margin-bottom: 120px;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: 15px;
    border-bottom: 1px dashed var(--border);
    color: #777;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .hero-meta span:last-child {
    color: var(--terminal-green);
  }

  .hero-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 60px;
  }

  .eyebrow {
    margin-bottom: 20px;
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 3px;
  }

  h1 {
    margin: 0;
    font-size: clamp(64px, 10vw, 140px);
    line-height: 0.85;
    letter-spacing: -7px;
    font-weight: 900;
  }

  .subtitle {
    max-width: 700px;
    margin-top: 35px;
    color: #aaa;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-index {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    color: #555;
  }

  .hero-index span {
    font-size: 10px;
    letter-spacing: 2px;
  }

  .hero-index strong {
    color: var(--accent);
    font-size: 72px;
  }

  /* INTRO */

  .intro-section,
  .identity-section,
  .dossier-section,
  .philosophy-section,
  .approach-section,
  .workflow-section,
  .capabilities-section,
  .journey-section,
  .current-section,
  .future-section {
    margin-bottom: 120px;
  }

  .intro-grid,
  .identity-grid,
  .philosophy-grid,
  .journey-grid,
  .future-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 80px;
  }

  .intro-heading h2,
  .philosophy-heading h2,
  .journey-heading h2 {
    margin: 0;
    font-size: clamp(32px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -3px;
    text-transform: uppercase;
  }

  .intro-text,
  .identity-text,
  .philosophy-text,
  .journey-text,
  .future-text {
    max-width: 750px;
  }

  .intro-text p,
  .identity-text p,
  .philosophy-text p,
  .journey-text p,
  .future-text p {
    margin: 0 0 25px;
    color: #999;
    font-size: 16px;
    line-height: 1.9;
  }

  .intro-text .intro-lead,
  .philosophy-text .lead,
  .journey-text .lead,
  .future-text .lead {
    color: white;
    font-size: 20px;
  }

  /* IDENTITY */

  .identity-title span,
  .journey-heading span,
  .future-heading span {
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 2px;
  }

  .identity-title h2 {
    margin-top: 20px;
    font-size: clamp(30px, 4vw, 55px);
    line-height: 1;
  }

  /* DOSSIER */

  .dossier,
  .capability-panel,
  .workflow-panel {
    background: rgba(8, 8, 12, 0.9);
    border: 1px solid var(--border);
  }

  .dossier-header,
  .capability-header,
  .workflow-header {
    display: flex;
    justify-content: space-between;
    padding: 18px 25px;
    border-bottom: 1px dashed var(--border);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 2px;
  }

  .dossier-header .online,
  .capability-header strong {
    color: var(--terminal-green);
  }

  .dossier-body {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
  }

  .identity {
    padding: 55px;
    border-right: 1px solid var(--border);
  }

  .identity-label {
    margin-bottom: 15px;
    color: #777;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .identity h2 {
    margin: 0 0 15px;
    font-size: 44px;
    letter-spacing: -2px;
  }

  .identity p {
    margin: 0;
    color: var(--terminal-green);
    font-size: 11px;
    font-weight: bold;
  }

  .dossier-data {
    padding: 35px 45px;
  }

  .data-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
    color: #bbb;
    font-size: 12px;
    line-height: 1.6;
  }

  .data-row:last-child {
    border-bottom: none;
  }

  .data-label {
    color: #666;
    letter-spacing: 1px;
  }

  /* PHILOSOPHY */

  .small-label {
    color: #777;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .motto {
    margin-top: 45px;
    padding: 30px;
    border-left: 2px solid var(--accent);
    background: rgba(255, 255, 255, 0.02);
  }

  .motto span {
    display: block;
    margin-bottom: 15px;
    color: #666;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .motto strong {
    display: block;
    margin-bottom: 20px;
    color: white;
    font-size: 24px;
    letter-spacing: 1px;
  }

  .motto p {
    margin: 0 !important;
    font-size: 13px !important;
  }

  /* APPROACH */

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .approach-card {
    position: relative;
    min-height: 260px;
    padding: 30px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: rgba(8, 8, 12, 0.9);
  }

  .approach-card::after {
    content: "";
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 90px;
    height: 90px;
    border: 1px solid var(--border);
    transform: rotate(45deg);
  }

  .card-number {
    display: block;
    margin-bottom: 55px;
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 2px;
  }

  .approach-card h3 {
    margin: 0 0 15px;
    font-size: 22px;
    text-transform: uppercase;
  }

  .approach-card p {
    color: #888;
    font-size: 12px;
    line-height: 1.8;
  }

  /* WORKFLOW */

  .workflow-header {
    color: #777;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .workflow-step {
    min-height: 220px;
    padding: 30px;
    border-right: 1px solid var(--border);
  }

  .workflow-step:last-child {
    border-right: none;
  }

  .workflow-step > span {
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 2px;
  }

  .workflow-step h3 {
    margin: 35px 0 15px;
    font-size: 17px;
  }

  .workflow-step p {
    margin: 0;
    color: #777;
    font-size: 11px;
    line-height: 1.8;
  }

  /* CAPABILITIES */

  .capability-header {
    color: #777;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .capability {
    min-height: 190px;
    padding: 35px;
    border-bottom: 1px solid var(--border);
  }

  .capability:nth-child(odd) {
    border-right: 1px solid var(--border);
  }

  .capability:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .cap-index {
    color: #555;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .capability h3 {
    margin: 25px 0 12px;
    font-size: 21px;
  }

  .capability p {
    max-width: 550px;
    color: #888;
    font-size: 12px;
    line-height: 1.8;
  }

  /* JOURNEY */

  .journey-heading h2 {
    margin-top: 25px;
  }

  .journey-text p {
    border-left: 1px solid var(--border);
    padding-left: 25px;
  }

  /* CURRENT */

  .current-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .current-item {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 20px;
    min-height: 130px;
    padding: 30px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .current-item span {
    color: var(--accent);
    font-size: 11px;
  }

  .current-item p {
    margin: 0;
    color: #aaa;
    font-size: 13px;
    line-height: 1.8;
  }

  .current-ai {
    grid-column: span 2;
  }

  /* FUTURE */

  .future-heading {
    position: relative;
  }

  .future-symbol {
    margin-top: 40px;
    color: var(--accent);
    font-size: 80px;
    line-height: 1;
  }

  /* CLOSING */

  .closing-line {
    width: 100%;
    height: 1px;
    margin-bottom: 35px;
    background: var(--border);
  }

  .closing-section p {
    max-width: 850px;
    margin: 0 0 25px;
    color: #aaa;
    font-size: 18px;
    line-height: 1.8;
  }

  .closing-status {
    color: var(--terminal-green);
    font-size: 11px;
    letter-spacing: 2px;
  }

  /* RESPONSIVE */

  @media (max-width: 1000px) {
    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .workflow-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .workflow-step:nth-child(2n) {
      border-right: none;
    }

    .workflow-step {
      border-bottom: 1px solid var(--border);
    }

    .workflow-step:last-child {
