---
import Layout from "../../layouts/Layout.astro";
import { getLanguageFromPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const lang = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(lang);
---

<Layout title={`${t.sections.about.title} | R2S Studio`}>
  <main class="about-page">
    <!-- =====================================================
    HERO
    ====================================================== -->

    <section class="about-hero">
      <div class="hero-meta">
        <span>{t.sections.about.pageTag}</span>
        <span>{t.sections.about.pageStatus}</span>
      </div>

      <div class="hero-content">
        <div class="hero-main">
          <div class="eyebrow">
            {t.sections.about.eyebrow}
          </div>

          <h1>
            {t.sections.about.title}
          </h1>

          <p class="subtitle">
            {t.sections.about.subtitle}
          </p>
        </div>

        <div class="hero-index">
          <span>MODULE</span>
          <strong>01</strong>
        </div>
      </div>
    </section>

    <!-- =====================================================
    01 — INTRODUCTION + IDENTITY
    ====================================================== -->

    <section class="intro-section">
      <div class="section-label">// 01 — INTRODUCTION // IDENTITY</div>

      <div class="intro-layout">
        <div class="intro-heading">
          <span class="system-tag"> R2S_STUDIO / PROFILE </span>

          <h2>
            {t.sections.about.introTitle}
          </h2>

          <div class="intro-marker">
            <span>Design</span>
            <span>Engineering</span>
            <span>Visual Art</span>
          </div>
        </div>

        <div class="intro-content">
          <p class="intro-lead">
            {t.sections.about.description}
          </p>

          <p>
            {t.sections.about.introText}
          </p>

          <p>
            {t.sections.about.identity.text}
          </p>

          <div class="intro-statement">
            <span>// PATH</span>

            <strong>
              {t.sections.about.identity.title}
            </strong>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
    02 — PERSONNEL DOSSIER
    ====================================================== -->

    <section class="dossier-section">
      <div class="section-label">// 02 — PERSONNEL DOSSIER</div>

      <div class="dossier">
        <div class="dossier-header">
          <span>
            {t.sections.about.dossier.header}
          </span>

          <span class="online">
            {t.sections.about.dossier.status}
          </span>
        </div>

        <div class="dossier-body">
          <div class="identity">
            <div class="identity-label">
              {t.sections.about.dossier.operator}
            </div>

            <h2>R2S Studio</h2>

            <p>
              {t.sections.about.dossier.role}
            </p>
          </div>

          <div class="dossier-data">
            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.locationLabel}
              </span>

              <span>
                {t.sections.about.dossier.location}
              </span>
            </div>

            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.fieldLabel}
              </span>

              <span>
                {t.sections.about.dossier.field}
              </span>
            </div>

            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.focusLabel}
              </span>

              <span>
                {t.sections.about.dossier.focus}
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
    03 — PERSONAL PROTOCOL
    ====================================================== -->

    <section class="philosophy-section">
      <div class="section-label">// 03 — PERSONAL PROTOCOL</div>

      <div class="philosophy-layout">
        <div class="philosophy-main">
          <span class="system-tag">
            {t.sections.about.philosophy.header}
          </span>

          <h2>
            {t.sections.about.philosophy.title}
          </h2>
        </div>

        <div class="philosophy-copy">
          <p class="lead">
            {t.sections.about.philosophy.text}
          </p>

          <p>
            {t.sections.about.philosophy.second}
          </p>
        </div>
      </div>

      <div class="motto-panel">
        <div class="motto-label">
          {t.sections.about.philosophy.mottoLabel}
        </div>

        <div class="motto-content">
          <strong>
            {t.sections.about.philosophy.motto}
          </strong>

          <p>
            {t.sections.about.philosophy.mottoText}
          </p>
        </div>

        <div class="motto-symbol">→</div>
      </div>
    </section>

    <!-- =====================================================
    04 — DESIGN PROCESS
    ====================================================== -->

    <section class="process-section">
      <div class="section-label">// 04 — DESIGN PROCESS</div>

      <div class="process-header">
        <div class="process-heading">
          <span class="system-tag"> CREATIVE PIPELINE </span>

          <h2>
            IDEA
            <span class="process-arrow" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                width="100%"
                height="100%"
              >
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <polyline points="14 6 20 12 14 18"></polyline>
              </svg>
            </span>
            OBJECT
          </h2>
        </div>

        <p>
          {t.sections.about.approach.description}
        </p>
      </div>

      <div class="process-station" data-process-sequence>
        <div class="station-track">
          <span class="station-track-progress"></span>
        </div>

        <!-- 01 -->

        <div class="station-item process-active" data-process-step="0">
          <div class="station-light">
            <span></span>
          </div>

          <div class="station-number">01</div>

          <div class="station-content">
            <span class="station-state"> ACTIVE </span>

            <div class="station-code">RESEARCH</div>

            <h3>
              {t.sections.about.approach.research.title}
            </h3>

            <p>
              {t.sections.about.approach.research.description}
            </p>
          </div>
        </div>

        <!-- 02 -->

        <div class="station-item" data-process-step="1">
          <div class="station-light">
            <span></span>
          </div>

          <div class="station-number">02</div>

          <div class="station-content">
            <span class="station-state"> IDLE </span>

            <div class="station-code">CONCEPT</div>

            <h3>
              {t.sections.about.approach.concept.title}
            </h3>

            <p>
              {t.sections.about.approach.concept.description}
            </p>
          </div>
        </div>

        <!-- 03 -->

        <div class="station-item" data-process-step="2">
          <div class="station-light">
            <span></span>
          </div>

          <div class="station-number">03</div>

          <div class="station-content">
            <span class="station-state"> IDLE </span>

            <div class="station-code">BUILD</div>

            <h3>
              {t.sections.about.approach.build.title}
            </h3>

            <p>
              {t.sections.about.approach.build.description}
            </p>
          </div>
        </div>

        <!-- 04 -->

        <div class="station-item" data-process-step="3">
          <div class="station-light">
            <span></span>
          </div>

          <div class="station-number">04</div>

          <div class="station-content">
            <span class="station-state"> IDLE </span>

            <div class="station-code">ITERATE</div>

            <h3>
              {t.sections.about.approach.refine.title}
            </h3>

            <p>
              {t.sections.about.approach.refine.description}
            </p>
          </div>
        </div>
      </div>

      <div class="pipeline-progress">
        <div class="pipeline-progress-line">
          <span></span>
        </div>

        <div class="pipeline-progress-label">
          <span>SEQUENCE</span>
          <span>01 → 02 → 03 → 04 → REPEAT</span>
        </div>
      </div>
    </section>

    <!-- =====================================================
    05 — CAPABILITY MATRIX
    ====================================================== -->

    <section class="capabilities-section">
      <div class="section-label">// 05 — CAPABILITY MATRIX</div>

      <div class="capability-console">
        <div class="console-top">
          <span> R2S_CAPABILITY_MATRIX </span>

          <span>
            INPUT:
            <b>SELECT MODULE</b>
          </span>
        </div>

        <div class="capability-layout">
          <div class="capability-buttons">
            <button class="cap-button active" data-cap="industrial">
              <span>01</span>
              <strong>
                {t.sections.about.capabilities.industrial.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="mechanical">
              <span>02</span>
              <strong>
                {t.sections.about.capabilities.mechanical.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="electronics">
              <span>03</span>
              <strong>
                {t.sections.about.capabilities.electronics.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="embedded">
              <span>04</span>
              <strong>
                {t.sections.about.capabilities.embedded.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="fabrication">
              <span>05</span>
              <strong>
                {t.sections.about.capabilities.fabrication.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="visual">
              <span>06</span>
              <strong>
                {t.sections.about.capabilities.visual.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="software">
              <span>07</span>
              <strong>
                {t.sections.about.capabilities.software.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="teaching">
              <span>08</span>
              <strong>
                {t.sections.about.capabilities.teaching.title}
              </strong>
            </button>
          </div>

          <div class="capability-display">
            <div class="display-header">
              <span id="cap-status"> MODULE_01 </span>

              <span class="display-light"> ● ACTIVE </span>
            </div>

            <div class="display-visual">
              <canvas id="capabilityCanvas" aria-hidden="true"></canvas>

              <div class="cap-scanlines"></div>

              <div class="cap-corner cap-corner-tl">
                R2S // VISUAL TELEMETRY
              </div>

              <div class="cap-corner cap-corner-br">LIVE</div>
            </div>

            <div class="display-body">
              <span class="display-kicker"> CAPABILITY </span>

              <h3 id="cap-title">
                {t.sections.about.capabilities.industrial.title}
              </h3>

              <p id="cap-description">
                {t.sections.about.capabilities.industrial.description}
              </p>
            </div>

            <div class="display-footer">
              <span> AUTO SEQUENCE </span>

              <span> SELECT OTHER MODULE → </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
    06 — DEVELOPMENT PATH
    ====================================================== -->

    <section class="journey-section">
      <div class="section-label">// 06 — DEVELOPMENT PATH</div>

      <div class="journey-header">
        <span class="system-tag"> {t.sections.about.journey.header} </span>

        <h2>
          {t.sections.about.journey.title}
        </h2>
      </div>

      <!-- SKILL TREE -->

      <div class="skill-tree">
        <div class="skill-grid"></div>

        <div class="skill-tree-label">
          <span>KNOWLEDGE ACCUMULATION</span>
          <span>TIME →</span>
        </div>

        <!-- MAIN DEVELOPMENT PATH -->

        <div class="skill-main-line">
          <span></span>
        </div>

        <!-- =================================================
        LEVEL 01
        ================================================== -->

        <div class="skill-node skill-origin">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 01 / BASE </span>

            <strong> MAKING </strong>

            <small> Learning how things are made </small>
          </div>
        </div>

        <!-- =================================================
        LEVEL 02
        ================================================== -->

        <div class="skill-node skill-cad">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 02 / FORM </span>

            <strong> CAD </strong>

            <small> 3D Modeling · Geometry · Structure </small>
          </div>
        </div>

        <div class="skill-node skill-drawing">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 02 / VISUAL </span>

            <strong> DRAWING </strong>

            <small> Observation · Composition · Form </small>
          </div>
        </div>

        <!-- =================================================
        LEVEL 03
        ================================================== -->

        <div class="skill-node skill-render">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 03 / VISUALIZATION </span>

            <strong> 3D RENDERING </strong>

            <small> Materials · Lighting · Visual Communication </small>
          </div>
        </div>

        <div class="skill-node skill-print">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 03 / FABRICATION </span>

            <strong> 3D PRINTING </strong>

            <small> Prototyping · Iteration · Additive </small>
          </div>
        </div>

        <div class="skill-node skill-graphic">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 03 / GRAPHIC </span>

            <strong> GRAPHIC DESIGN </strong>

            <small> Typography · Layout · Visual Systems </small>
          </div>
        </div>

        <!-- =================================================
        LEVEL 04
        ================================================== -->

        <div class="skill-node skill-cmf">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 04 / MATERIAL </span>

            <strong> CMF </strong>

            <small> Color · Material · Finish · Surfaces </small>
          </div>
        </div>

        <div class="skill-node skill-prototype">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 04 / OBJECT </span>

            <strong> PROTOTYPING </strong>

            <small> From digital geometry to physical object </small>
          </div>
        </div>

        <div class="skill-node skill-character">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 04 / ART </span>

            <strong> CHARACTER ART </strong>

            <small> Anatomy · Expression · Visual Storytelling </small>
          </div>
        </div>

        <div class="skill-node skill-electronics">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 04 / SYSTEMS </span>

            <strong> ELECTRONICS </strong>

            <small> Circuits · Components · Signals </small>
          </div>
        </div>

        <!-- =================================================
        LEVEL 05
        ================================================== -->

        <div class="skill-node skill-welding">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 05 / FABRICATION </span>

            <strong> WELDING </strong>

            <small> Metal Joining · Structure · Fabrication </small>
          </div>
        </div>

        <div class="skill-node skill-soldering">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 05 / HARDWARE </span>

            <strong> SOLDERING </strong>

            <small> Assembly · Repair · Modification </small>
          </div>
        </div>

        <div class="skill-node skill-embedded">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 05 / COMPUTE </span>

            <strong> EMBEDDED SYSTEMS </strong>

            <small> Microcontrollers · Sensors · Control </small>
          </div>
        </div>

        <div class="skill-node skill-materials">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 05 / MATERIAL </span>

            <strong> MATERIAL RESEARCH </strong>

            <small> Properties · Processes · Behavior </small>
          </div>
        </div>

        <!-- =================================================
        LEVEL 06
        ================================================== -->

        <!-- Swapped positions: IDEA → OBJECT on left, SYSTEM DESIGN on right -->

        <div class="skill-node skill-integration">
          <div class="skill-node-dot"></div>

          <div class="skill-node-content">
            <span class="skill-index"> 06 / REALISATION </span>

            <strong> IDEA → OBJECT </strong>

            <small> Turning concepts into tangible things </small>
          </div>
        </div>

        <!-- BRANCH CONNECTIONS -->

        <div class="skill-branch branch-a"></div>
        <div class="skill-branch branch-b"></div>
        <div class="skill-branch branch-c"></div>
        <div class="skill-branch branch-d"></div>
        <div class="skill-branch branch-e"></div>
        <div class="skill-branch branch-f"></div>
        <div class="skill-branch branch-g"></div>
        <div class="skill-branch branch-h"></div>
        <div class="skill-branch branch-i"></div>
        <div class="skill-branch branch-j"></div>
      </div>

      <div class="journey-copy">
        <p class="lead">
          {t.sections.about.journey.text}
        </p>

        <p>
          {t.sections.about.journey.second}
        </p>

        <p>
          {t.sections.about.journey.third}
        </p>

        <p>
          {t.sections.about.journey.fourth}
        </p>
      </div>
    </section>

    <!-- =====================================================
    07 — CURRENT RESEARCH
    ====================================================== -->

    <section class="current-section">
      <div class="section-label">// 07 — CURRENT RESEARCH</div>

      <div class="research-terminal">
        <div class="terminal-bar">
          <span> CURRENT_RESEARCH.exe </span>

          <span> 2026 </span>
        </div>

        <div class="research-screen">
          <div class="research-column">
            <span> DESIGN_01 </span>

            <strong>
              {t.sections.about.current.modules.design.title}
            </strong>

            <p>
              {t.sections.about.current.design}
            </p>
          </div>

          <div class="research-column">
            <span> TECH_02 </span>

            <strong>
              {t.sections.about.current.modules.technology.title}
            </strong>

            <p>
              {t.sections.about.current.technology}
            </p>
          </div>

          <div class="research-column">
            <span> MAKING_03 </span>

            <strong>
              {t.sections.about.current.modules.making.title}
            </strong>

            <p>
              {t.sections.about.current.making}
            </p>
          </div>

          <div class="research-column">
            <span> ART_04 </span>

            <strong>
              {t.sections.about.current.modules.visual.title}
            </strong>

            <p>
              {t.sections.about.current.visual}
            </p>
          </div>

          <div class="research-column research-wide">
            <span> AI_05 </span>

            <strong>
              {t.sections.about.current.modules.ai.title}
            </strong>

            <p>
              {t.sections.about.current.ai}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
    08 — FUTURE
    ====================================================== -->

    <section class="future-section">
      <div class="section-label">// 08 — NEXT ITERATION</div>

      <div class="future-panel">
        <div class="future-heading">
          <span>
            {t.sections.about.future.header}
          </span>

          <div class="future-arrow">→</div>
        </div>

        <div class="future-text">
          <p class="lead">
            {t.sections.about.future.text}
          </p>

          <p>
            {t.sections.about.future.second}
          </p>

          <p>
            {t.sections.about.future.third}
          </p>
        </div>
      </div>
    </section>

    <!-- =====================================================
    CLOSING
    ====================================================== -->

    <section class="closing-section">
      <div class="closing-line"></div>

      <div class="closing-grid">
        <div class="closing-copy">
          <span class="closing-kicker"> // FINAL PROTOCOL </span>

          <p>{t.sections.about.closing}</p>
        </div>

        <div class="closing-terminal">
          <div class="closing-status">&gt; SYSTEM_READY_</div>

          <button class="enter-key" type="button" aria-label="Continue">
            <span>ENTER</span>
            <b>↵</b>
          </button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script
  define:vars={{
    industrial: {
      title: t.sections.about.capabilities.industrial.title,
      description: t.sections.about.capabilities.industrial.description,
    },
    mechanical: {
      title: t.sections.about.capabilities.mechanical.title,
      description: t.sections.about.capabilities.mechanical.description,
    },
    electronics: {
      title: t.sections.about.capabilities.electronics.title,
      description: t.sections.about.capabilities.electronics.description,
    },
    embedded: {
      title: t.sections.about.capabilities.embedded.title,
      description: t.sections.about.capabilities.embedded.description,
    },
    fabrication: {
      title: t.sections.about.capabilities.fabrication.title,
      description: t.sections.about.capabilities.fabrication.description,
    },
    visual: {
      title: t.sections.about.capabilities.visual.title,
      description: t.sections.about.capabilities.visual.description,
    },
    software: {
      title: t.sections.about.capabilities.software.title,
      description: t.sections.about.capabilities.software.description,
    },
    teaching: {
      title: t.sections.about.capabilities.teaching.title,
      description: t.sections.about.capabilities.teaching.description,
    },
  }}
>
  /* =====================================================
  04 — SEQUENTIAL DESIGN PROCESS
  ====================================================== */

  const processStation = document.querySelector("[data-process-sequence]");
  const processItems = processStation
    ? Array.from(processStation.querySelectorAll("[data-process-step]"))
    : [];
  const processProgress = document.querySelector(".station-track-progress");

  let processIndex = 0;
  let processTimer = null;
  let processStarted = false;

  function updateProcess(index) {
    if (!processItems.length) return;
    processIndex = index;

    processItems.forEach((item, i) => {
      item.classList.remove("process-active", "process-complete");
      const state = item.querySelector(".station-state");
      if (i < index) {
        item.classList.add("process-complete");
        if (state) state.textContent = "COMPLETE";
      } else if (i === index) {
        item.classList.add("process-active");
        if (state) state.textContent = "ACTIVE";
      } else {
        if (state) state.textContent = "IDLE";
      }
    });

    if (processProgress) {
      const progress =
        processItems.length <= 1 ? 0 : index / (processItems.length - 1);
      processProgress.style.width = `${progress * 100}%`;
    }
  }

  function nextProcessStation() {
    if (!processStarted) return;
    processIndex = (processIndex + 1) % processItems.length;
    updateProcess(processIndex);
  }

  function startProcessSequence() {
    if (processStarted || !processItems.length) return;
    processStarted = true;
    updateProcess(0);
    processTimer = window.setInterval(nextProcessStation, 1500);
  }

  if (processStation) {
    const processObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio > 0.2) {
            startProcessSequence();
          }
        });
      },
      { threshold: [0.2] },
    );
    processObserver.observe(processStation);
  }

  /* =====================================================
  05 — CAPABILITY MATRIX
  ====================================================== */

  const modules = {
    industrial,
    mechanical,
    electronics,
    embedded,
    fabrication,
    visual,
    software,
    teaching,
  };

  const buttons = Array.from(document.querySelectorAll(".cap-button"));
  const title = document.querySelector("#cap-title");
  const description = document.querySelector("#cap-description");
  const status = document.querySelector("#cap-status");
  const canvas = document.querySelector("#capabilityCanvas");
  const ctx = canvas?.getContext("2d");

  let activeIndex = 0;
  let animationFrame = null;
  let moduleTimer = null;

  let mouseX = 0.5;
  let mouseY = 0.5;
  let W = 0;
  let H = 0;
  let time = 0;
  let manualInteraction = false;

  function resizeCanvas() {
    if (!canvas || !ctx) return;
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = rect.width;
    H = rect.height;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function updateMouse(e) {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    mouseX = (e.clientX - rect.left) / rect.width;
    mouseY = (e.clientY - rect.top) / rect.height;
    mouseX = Math.max(0, Math.min(1, mouseX));
    mouseY = Math.max(0, Math.min(1, mouseY));
    manualInteraction = true;
  }

  canvas?.addEventListener("mousemove", updateMouse);
  canvas?.addEventListener("mouseleave", () => {
    mouseX = 0.5;
    mouseY = 0.5;
  });

  function roundedRect(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  function drawGrid() {
    ctx.strokeStyle = "rgba(255,255,255,0.035)";
    ctx.lineWidth = 0.5;
    const spacing = 38;
    for (let x = 0; x < W; x += spacing) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, H);
      ctx.stroke();
    }
    for (let y = 0; y < H; y += spacing) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(W, y);
      ctx.stroke();
    }
  }

  /* =====================================================
  DRAW: Industrial & Product Design — 3D Torus
  ====================================================== */
  function draw3DModel() {
    const cx = W / 2;
    const cy = H / 2;
    const R = Math.min(W, H) * 0.28;
    const r = R * 0.4;

    const rotX = time * 0.6;
    const rotY = time * 0.9;

    ctx.strokeStyle = "rgba(232,160,64,0.55)";
    ctx.lineWidth = 1.2;
    ctx.shadowColor = "rgba(232,160,64,0.25)";
    ctx.shadowBlur = 6;

    const stepU = (Math.PI * 2) / 16;
    const stepV = (Math.PI * 2) / 20;

    // Horizontal rings
    for (let v = 0; v < Math.PI * 2; v += stepV) {
      ctx.beginPath();
      for (let u = 0; u <= Math.PI * 2; u += 0.1) {
        const px = (R + r * Math.cos(v)) * Math.cos(u);
        const py = (R + r * Math.cos(v)) * Math.sin(u);
        const pz = r * Math.sin(v);
        const x1 = px * Math.cos(rotY) - pz * Math.sin(rotY);
        const z1 = px * Math.sin(rotY) + pz * Math.cos(rotY);
        const y1 = py * Math.cos(rotX) - z1 * Math.sin(rotX);
        const z2 = py * Math.sin(rotX) + z1 * Math.cos(rotX);
        const scale = 400 / (400 + z2);
        const sx = cx + x1 * scale;
        const sy = cy - y1 * scale;
        if (u === 0) ctx.moveTo(sx, sy);
        else ctx.lineTo(sx, sy);
      }
      ctx.stroke();
    }

    // Vertical rings
    for (let u = 0; u < Math.PI * 2; u += stepU) {
      ctx.beginPath();
      for (let v = 0; v <= Math.PI * 2; v += 0.1) {
        const px = (R + r * Math.cos(v)) * Math.cos(u);
        const py = (R + r * Math.cos(v)) * Math.sin(u);
        const pz = r * Math.sin(v);
        const x1 = px * Math.cos(rotY) - pz * Math.sin(rotY);
        const z1 = px * Math.sin(rotY) + pz * Math.cos(rotY);
        const y1 = py * Math.cos(rotX) - z1 * Math.sin(rotX);
        const z2 = py * Math.sin(rotX) + z1 * Math.cos(rotX);
        const scale = 400 / (400 + z2);
        const sx = cx + x1 * scale;
        const sy = cy - y1 * scale;
        if (v === 0) ctx.moveTo(sx, sy);
        else ctx.lineTo(sx, sy);
      }
      ctx.stroke();
    }

    ctx.shadowBlur = 0;
  }

  /* =====================================================
  DRAW: CMF — Large Rotating Color Blocks
  ====================================================== */
  function drawCMF() {
    const cols = 8;
    const rows = 6;
    const pad = 6;
    const cellW = (W - pad * (cols + 1)) / cols;
    const cellH = (H - pad * (rows + 1)) / rows;
    const totalW = cellW * cols + pad * (cols - 1);
    const totalH = cellH * rows + pad * (rows - 1);
    const startX = (W - totalW) / 2;
    const startY = (H - totalH) / 2;

    // Material drawing functions
    function drawGlossy(cx, cy, w, h, hue, sat, light) {
      const grad = ctx.createLinearGradient(cx, cy - h / 2, cx, cy + h / 2);
      grad.addColorStop(0, `hsl(${hue},${sat}%,${light + 20}%)`);
      grad.addColorStop(0.3, `hsl(${hue},${sat}%,${light}%)`);
      grad.addColorStop(1, `hsl(${hue},${sat * 0.8}%,${light - 10}%)`);
      ctx.fillStyle = grad;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 4);
      ctx.fill();

      ctx.fillStyle = `rgba(255,255,255,0.55)`;
      ctx.beginPath();
      roundedRect(cx - w / 2 + 2, cy - h / 2 + 2, w - 4, h * 0.28, 4);
      ctx.fill();
    }

    function drawMatte(cx, cy, w, h, hue, sat, light) {
      ctx.fillStyle = `hsl(${hue},${sat * 0.6}%,${light * 0.9}%)`;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 4);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      roundedRect(cx - w / 2, cy - h / 2, w, h, 4);
      ctx.clip();
      const dotCount = Math.floor(w * h * 0.25);
      for (let i = 0; i < dotCount; i++) {
        const dx = cx - w / 2 + Math.random() * w;
        const dy = cy - h / 2 + Math.random() * h;
        const alpha = 0.05 + Math.random() * 0.08;
        ctx.fillStyle = `rgba(255,255,255,${alpha})`;
        ctx.beginPath();
        ctx.arc(dx, dy, 0.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(0,0,0,${alpha * 0.8})`;
        ctx.beginPath();
        ctx.arc(dx + 0.5, dy + 0.5, 0.5, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    function drawMetallic(cx, cy, w, h, hue, sat, light) {
      const grad = ctx.createLinearGradient(
        cx - w / 2,
        cy - h / 2,
        cx + w / 2,
        cy + h / 2,
      );
      grad.addColorStop(0, `hsl(${hue},${sat}%,${light + 25}%)`);
      grad.addColorStop(0.3, `hsl(${hue},${sat * 0.6}%,${light}%)`);
      grad.addColorStop(0.6, `hsl(${hue},${sat}%,${light - 5}%)`);
      grad.addColorStop(1, `hsl(${hue},${sat * 0.7}%,${light - 18}%)`);
      ctx.fillStyle = grad;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 2);
      ctx.fill();

      ctx.strokeStyle = `hsla(${hue},80%,75%,0.45)`;
      ctx.lineWidth = 1.2;
      ctx.stroke();
    }

    function drawPlastic(cx, cy, w, h, hue, sat, light) {
      ctx.fillStyle = `hsl(${hue},${sat}%,${light}%)`;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 5);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      roundedRect(cx - w / 2, cy - h / 2, w, h, 5);
      ctx.clip();
      ctx.strokeStyle = `rgba(255,255,255,0.6)`;
      ctx.lineWidth = 2;
      ctx.stroke();

      const glowGrad = ctx.createRadialGradient(
        cx - w * 0.2,
        cy - h * 0.25,
        0,
        cx,
        cy,
        w * 0.5,
      );
      glowGrad.addColorStop(0, `rgba(255,255,255,0.4)`);
      glowGrad.addColorStop(1, `rgba(255,255,255,0)`);
      ctx.fillStyle = glowGrad;
      ctx.fillRect(cx - w / 2, cy - h / 2, w, h);
      ctx.restore();
    }

    function drawLeather(cx, cy, w, h, hue, sat, light) {
      const baseColor = `hsl(${hue},${sat * 0.5}%,${light * 0.7}%)`;
      ctx.fillStyle = baseColor;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 3);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      roundedRect(cx - w / 2, cy - h / 2, w, h, 3);
      ctx.clip();
      for (let i = 0; i < 15; i++) {
        const dx = cx - w / 2 + 4 + ((i * 6.7) % (w - 8));
        const dy = cy - h / 2 + 3 + ((i * 8.3) % (h - 6));
        ctx.fillStyle = `rgba(0,0,0,0.15)`;
        ctx.beginPath();
        ctx.arc(dx, dy, 0.6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(255,255,255,0.1)`;
        ctx.beginPath();
        ctx.arc(dx + 1.2, dy - 0.8, 0.4, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    function drawTextured(cx, cy, w, h, hue, sat, light) {
      ctx.fillStyle = `hsl(${hue},${sat}%,${light}%)`;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 3);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      roundedRect(cx - w / 2, cy - h / 2, w, h, 3);
      ctx.clip();
      ctx.strokeStyle = `rgba(255,255,255,0.18)`;
      ctx.lineWidth = 0.6;
      for (let lx = -w; lx < w; lx += 5) {
        ctx.beginPath();
        ctx.moveTo(cx - w / 2 + lx, cy - h / 2);
        ctx.lineTo(cx - w / 2 + lx + h, cy + h / 2);
        ctx.stroke();
      }
      for (let lx = -w; lx < w; lx += 5) {
        ctx.beginPath();
        ctx.moveTo(cx - w / 2 + lx + h, cy - h / 2);
        ctx.lineTo(cx - w / 2 + lx, cy + h / 2);
        ctx.stroke();
      }
      ctx.restore();
    }

    const materialDraw = [
      drawGlossy,
      drawMatte,
      drawMetallic,
      drawPlastic,
      drawLeather,
      drawTextured,
    ];

    for (let r = 0; r < rows; r++) {
      const drawFn = materialDraw[r];
      for (let c = 0; c < cols; c++) {
        const x = startX + pad + c * (cellW + pad) + cellW / 2;
        const y = startY + pad + r * (cellH + pad) + cellH / 2;
        const hue = ((c / cols) * 360 + (r / rows) * 40 + time * 8) % 360;
        const sat = 55 + 20 * Math.sin(time * 0.5 + r + c);
        const light = 25 + 15 * Math.cos(time * 0.4 + c);
        drawFn(x, y, cellW, cellH, hue, sat, light);
      }
    }
  }

  /* =====================================================
  DRAW: Electronics
  ====================================================== */
  function drawElectronics() {
    ctx.strokeStyle = "rgba(30,50,40,0.35)";
    ctx.lineWidth = 0.4;
    const gridSize = 20;
    for (let x = 0; x < W; x += gridSize) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, H);
      ctx.stroke();
    }
    for (let y = 0; y < H; y += gridSize) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(W, y);
      ctx.stroke();
    }

    const numLines = 7;
    const lineSpacing = H / (numLines + 1);
    for (let l = 0; l < numLines; l++) {
      const baseY = lineSpacing * (l + 0.5);
      ctx.strokeStyle =
        l === 3 ? "rgba(232,160,64,0.65)" : "rgba(100,180,140,0.3)";
      ctx.lineWidth = l === 3 ? 2 : 1.2;
      ctx.beginPath();
      const leftX = W * 0.08;
      const midX1 = W * 0.28;
      const midX2 = W * 0.58;
      const rightX = W * 0.92;
      ctx.moveTo(leftX, baseY);
      ctx.lineTo(midX1, baseY);
      ctx.lineTo(
        midX1 + gridSize,
        baseY + (l % 2 === 0 ? -gridSize * 0.6 : gridSize * 0.6),
      );
      ctx.lineTo(
        midX2,
        baseY + (l % 2 === 0 ? -gridSize * 0.6 : gridSize * 0.6),
      );
      ctx.lineTo(midX2 + gridSize, baseY);
      ctx.lineTo(rightX, baseY);
      ctx.stroke();

      const solderPoints = [leftX, midX1, midX2, rightX];
      solderPoints.forEach((sx) => {
        const sy =
          sx === midX1 || sx === midX2
            ? baseY + (l % 2 === 0 ? -gridSize * 0.6 : gridSize * 0.6)
            : baseY;
        ctx.fillStyle = "rgba(200,200,210,0.6)";
        ctx.beginPath();
        ctx.arc(sx, sy, 3.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "rgba(255,255,255,0.25)";
        ctx.beginPath();
        ctx.arc(sx - 1, sy - 1, 1.2, 0, Math.PI * 2);
        ctx.fill();
      });

      const pulsePos = (time * 1.8 + l * 0.7) % 1;
      const pulseX = leftX + pulsePos * (rightX - leftX);
      let pulseY = baseY;
      if (pulseX > midX1 && pulseX < midX1 + gridSize) {
        const t = (pulseX - midX1) / gridSize;
        pulseY = baseY + (l % 2 === 0 ? -gridSize * 0.6 : gridSize * 0.6) * t;
      } else if (pulseX >= midX1 + gridSize && pulseX <= midX2) {
        pulseY = baseY + (l % 2 === 0 ? -gridSize * 0.6 : gridSize * 0.6);
      } else if (pulseX > midX2 && pulseX < midX2 + gridSize) {
        const t = (pulseX - midX2) / gridSize;
        pulseY =
          baseY + (l % 2 === 0 ? -gridSize * 0.6 : gridSize * 0.6) * (1 - t);
      }
      const glow = ctx.createRadialGradient(
        pulseX,
        pulseY,
        0,
        pulseX,
        pulseY,
        8,
      );
      glow.addColorStop(0, "rgba(232,200,100,0.9)");
      glow.addColorStop(0.5, "rgba(232,160,64,0.3)");
      glow.addColorStop(1, "rgba(232,160,64,0)");
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(pulseX, pulseY, 8, 0, Math.PI * 2);
      ctx.fill();
    }

    const chipX = W * 0.4;
    const chipY = H * 0.32;
    const chipW = W * 0.2;
    const chipH = H * 0.36;
    ctx.fillStyle = "#0a0a0f";
    ctx.strokeStyle = "rgba(180,180,180,0.5)";
    ctx.lineWidth = 1.5;
    roundedRect(chipX, chipY, chipW, chipH, 3);
    ctx.fill();
    ctx.stroke();

    const pinCount = 8;
    const pinSpacing = chipH / (pinCount + 1);
    for (let i = 0; i < pinCount; i++) {
      const py = chipY + pinSpacing * (i + 1);
      ctx.fillStyle = "rgba(200,200,210,0.5)";
      ctx.fillRect(chipX - 8, py - 1.5, 10, 3);
      ctx.fillRect(chipX + chipW - 2, py - 1.5, 10, 3);
    }
    ctx.fillStyle = "rgba(232,160,64,0.7)";
    ctx.font = "8px monospace";
    ctx.textAlign = "center";
    ctx.fillText("IC-01", chipX + chipW / 2, chipY + chipH / 2 + 3);
    ctx.fillStyle = "rgba(255,255,255,0.3)";
    ctx.beginPath();
    ctx.arc(chipX + 8, chipY + 8, 3, 0, Math.PI * 2);
    ctx.fill();
  }

  /* =====================================================
  DRAW: Embedded Systems
  ====================================================== */
  function drawEmbedded() {
    for (let i = 0; i < 18; i++) {
      ctx.beginPath();
      const y = H * 0.18 + i * H * 0.035;
      for (let x = 0; x <= W; x += 5) {
        const distance = Math.abs(x - W * 0.5) / W;
        const amplitude = (1 - distance) * 30;
        const wave = Math.sin(x * 0.035 + time * 1.8 + i * 0.35) * amplitude;
        const yy = y + wave;
        if (x === 0) ctx.moveTo(x, yy);
        else ctx.lineTo(x, yy);
      }
      ctx.strokeStyle =
        i === 9 ? "#e8a040" : `rgba(220,220,220,${0.08 + i * 0.005})`;
      ctx.stroke();
    }
  }

  /* =====================================================
  DRAW: Fabrication — Refined Conveyor
  ====================================================== */
  function drawFabrication() {
    const beltCount = 5;
    const beltHeight = 14;
    const beltGap = 18;
    const startY = H * 0.15;
    const totalHeight = beltCount * beltHeight + (beltCount - 1) * beltGap;
    const offsetY = startY + (H - startY - totalHeight) / 2;

    for (let b = 0; b < beltCount; b++) {
      const beltY = offsetY + b * (beltHeight + beltGap);

      ctx.fillStyle = "#1a1a20";
      ctx.fillRect(0, beltY, W, beltHeight);
      ctx.strokeStyle = "rgba(255,255,255,0.08)";
      ctx.lineWidth = 0.5;
      ctx.strokeRect(0, beltY, W, beltHeight);

      const rollerSpacing = 32;
      const rollerShift = (time * 50 + b * 7) % rollerSpacing;
      ctx.strokeStyle = "rgba(180,180,180,0.25)";
      ctx.lineWidth = 0.6;
      for (
        let rx = -rollerSpacing + rollerShift;
        rx < W + rollerSpacing;
        rx += rollerSpacing
      ) {
        ctx.beginPath();
        ctx.moveTo(rx, beltY + 2);
        ctx.lineTo(rx, beltY + beltHeight - 2);
        ctx.stroke();
      }

      const parcelCount = 4 + b;
      const baseSpeed = 0.12 + b * 0.02;

      for (let p = 0; p < parcelCount; p++) {
        const phase = (((time * baseSpeed * 0.7 + p * 0.25) % 1) + 1) % 1;
        const px = phase * W;
        const py = beltY + beltHeight / 2;

        const hue = (b * 45 + p * 30 + time * 2) % 360;
        const sat = 60 + 20 * Math.sin(p * 1.7 + b);
        const light = 40 + 15 * Math.cos(p * 1.2 + b);

        const shapeType = (p + b) % 3;
        const size = 7 + (p % 3) * 3;

        ctx.save();
        ctx.translate(px, py);
        ctx.fillStyle = `hsl(${hue},${sat}%,${light}%)`;
        ctx.strokeStyle = `hsla(${hue},${sat}%,${light + 20}%,0.6)`;
        ctx.lineWidth = 1;

        ctx.shadowColor = `hsla(${hue},70%,60%,0.3)`;
        ctx.shadowBlur = 4;

        switch (shapeType) {
          case 0:
            roundedRect(-size / 2, -size / 2, size, size, 2);
            ctx.fill();
            ctx.stroke();
            break;
          case 1:
            ctx.beginPath();
            ctx.arc(0, 0, size / 2, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
            break;
          case 2:
            ctx.beginPath();
            ctx.moveTo(0, -size / 2);
            ctx.lineTo(-size / 2, size / 2);
            ctx.lineTo(size / 2, size / 2);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            break;
        }

        ctx.fillStyle = "rgba(255,255,255,0.5)";
        ctx.beginPath();
        ctx.arc(-size * 0.2, -size * 0.2, 1.2, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }
    }
  }

  /* =====================================================
  DRAW: Illustration & Visual Design
  ====================================================== */
  function drawVisual() {
    const cols = 10;
    const rows = 6;
    const cw = W / cols;
    const ch = H / rows;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const nx = (c + 0.5) / cols;
        const ny = (r + 0.5) / rows;
        const dx = nx - mouseX;
        const dy = ny - mouseY;
        const dist = Math.hypot(dx, dy);
        const hue =
          (330 +
            nx * 70 +
            ny * 95 +
            time * 12 +
            Math.sin(dist * 12 - time) * 35) %
          360;
        const sat = 55 + 35 * (1 - Math.min(1, dist * 1.8));
        const light = 18 + 32 * (1 - Math.min(1, dist * 1.5));
        const pad = 4 + 6 * (1 - Math.min(1, dist * 1.6));
        const x = c * cw + pad;
        const y = r * ch + pad;
        const w = cw - pad * 2;
        const h = ch - pad * 2;
        ctx.fillStyle = `hsla(${hue},${sat}%,${light}%,0.82)`;
        ctx.shadowColor = `hsla(${hue},80%,60%,0.18)`;
        ctx.shadowBlur = 12;
        roundedRect(x, y, w, h, 4);
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.fillStyle = "rgba(255,255,255,0.035)";
        ctx.fillRect(x + w * 0.22, y + h * 0.34, w * 0.56, h * 0.2);
        ctx.fillStyle = "rgba(255,190,100,0.18)";
        ctx.beginPath();
        ctx.arc(x + w * 0.18, y + h * 0.78, 1.4, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    const glow = ctx.createRadialGradient(
      mouseX * W,
      mouseY * H,
      0,
      mouseX * W,
      mouseY * H,
      100,
    );
    glow.addColorStop(0, "rgba(232,160,64,0.13)");
    glow.addColorStop(1, "rgba(232,160,64,0)");
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(mouseX * W, mouseY * H, 100, 0, Math.PI * 2);
    ctx.fill();
  }

  /* =====================================================
  DRAW: Digital Tools
  ====================================================== */
  function drawSoftware() {
    ctx.font = "10px monospace";
    ctx.textAlign = "left";
    const lines = [
      "> init_r2s();",
      "> load_design_system();",
      "> compile_geometry();",
      "> build.prototype();",
      "> test();",
      "> iterate();",
      "> system_ready_",
    ];
    lines.forEach((line, i) => {
      const alpha = 0.15 + 0.1 * Math.sin(time * 2 - i);
      ctx.fillStyle = i === 6 ? "#e8a040" : `rgba(220,220,220,${alpha})`;
      ctx.fillText(line, W * 0.2, H * 0.22 + i * 25);
    });
    ctx.strokeStyle = "rgba(232,160,64,0.35)";
    ctx.beginPath();
    ctx.moveTo(W * 0.18, H * 0.82);
    ctx.lineTo(W * 0.82, H * 0.82);
    ctx.stroke();
    const progress = (Math.sin(time) + 1) / 2;
    ctx.fillStyle = "#e8a040";
    ctx.fillRect(W * 0.18, H * 0.82 - 2, W * 0.64 * progress, 4);
  }

  /* =====================================================
  DRAW: Teaching — Double DNA Helix
  ====================================================== */
  function drawTeaching() {
    const amplitude = Math.min(W, H) * 0.22;
    const helixLength = W * 0.7;
    const startX = W * 0.15;
    const centerY = H / 2;
    const turns = 7;
    const waveSpeed = 0.5;

    const pairSteps = turns * 18;
    for (let i = 0; i <= pairSteps; i++) {
      const t = (i / pairSteps) * turns * Math.PI * 2;
      const progress = t / (turns * Math.PI * 2);
      const x = startX + progress * helixLength;
      const offset = Math.sin(t + time * waveSpeed) * amplitude;
      const y1 = centerY + offset;
      const y2 = centerY - offset;

      const hue = 180 + progress * 120;
      const alpha = 0.3 + 0.2 * Math.sin(time * 2 + i * 0.3);
      ctx.strokeStyle = `hsla(${hue},70%,60%,${alpha})`;
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(x, y1);
      ctx.lineTo(x, y2);
      ctx.stroke();
    }

    for (let strand = 0; strand < 2; strand++) {
      const phase = strand * Math.PI;
      ctx.strokeStyle =
        strand === 0 ? "rgba(100,220,180,0.7)" : "rgba(232,160,64,0.7)";
      ctx.lineWidth = 2;
      ctx.shadowColor =
        strand === 0 ? "rgba(100,220,180,0.3)" : "rgba(232,160,64,0.3)";
      ctx.shadowBlur = 6;
      ctx.beginPath();

      const steps = 200;
      for (let i = 0; i <= steps; i++) {
        const t = (i / steps) * turns * Math.PI * 2;
        const progress = t / (turns * Math.PI * 2);
        const x = startX + progress * helixLength;
        const y = centerY + Math.sin(t + phase + time * waveSpeed) * amplitude;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
    ctx.shadowBlur = 0;
  }

  /* =====================================================
  CAPABILITY DISPATCH
  ====================================================== */
  function drawCapability() {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = "#09090b";
    ctx.fillRect(0, 0, W, H);
    drawGrid();

    const key = buttons[activeIndex]?.dataset.cap;
    switch (key) {
      case "industrial":
        draw3DModel();
        break;
      case "mechanical":
        drawCMF();
        break;
      case "electronics":
        drawElectronics();
        break;
      case "embedded":
        drawEmbedded();
        break;
      case "fabrication":
        drawFabrication();
        break;
      case "visual":
        drawVisual();
        break;
      case "software":
        drawSoftware();
        break;
      case "teaching":
        drawTeaching();
        break;
    }

    time += 0.016;
    animationFrame = requestAnimationFrame(drawCapability);
  }

  function activateModule(index, manual = false) {
    if (index < 0 || index >= buttons.length) return;
    activeIndex = index;
    const button = buttons[index];
    const key = button.dataset.cap;
    if (!key || !modules[key]) return;

    buttons.forEach((item) => item.classList.remove("active"));
    button.classList.add("active");
    title.textContent = modules[key].title;
    description.textContent = modules[key].description;
    status.textContent = `MODULE_${String(index + 1).padStart(2, "0")}`;

    if (manual) {
      manualInteraction = true;
    }
  }

  buttons.forEach((button, index) => {
    button.addEventListener("click", () => {
      activateModule(index, true);
      clearInterval(moduleTimer);
      moduleTimer = setInterval(nextModule, 4200);
    });
  });

  function nextModule() {
    activeIndex = (activeIndex + 1) % buttons.length;
    activateModule(activeIndex);
  }

  function initCapability() {
    resizeCanvas();
    activateModule(0);
    drawCapability();
    moduleTimer = setInterval(nextModule, 4200);
  }

  window.addEventListener("resize", resizeCanvas);
  initCapability();
</script>

