---
import { getCollection } from "astro:content";
import { getLanguageFromPath, getLocalizedPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";
import { typeToRoute } from "../utils/routes";

const currentLanguage = getLanguageFromPath(Astro.url.pathname);

const homePath = getLocalizedPath("/", currentLanguage);

const projectsPath = getLocalizedPath("/projects", currentLanguage);

const labPath = getLocalizedPath("/lab", currentLanguage);

const artPath = getLocalizedPath("/art", currentLanguage);

const notesPath = getLocalizedPath("/notes", currentLanguage);

const aboutPath = getLocalizedPath("/about", currentLanguage);

/* Current-page highlight (B10) */
function isCurrent(base: string): boolean {
  if (base === "/" || base === "/zh" || base === "/nl") {
    return (
      Astro.url.pathname === "/" ||
      Astro.url.pathname === "/zh" ||
      Astro.url.pathname === "/nl"
    );
  }

  return (
    Astro.url.pathname === base ||
    Astro.url.pathname.startsWith(base + "/")
  );
}

/*
=========================================================
LANGUAGE SWITCH (NL | EN | 中文)
=========================================================
*/

const entries = await getCollection("entries");

const pathSegments = Astro.url.pathname
  .replace(/^\/+|\/+$/g, "")
  .split("/")
  .filter(Boolean);

const isPrefixedPath =
  pathSegments.length > 0 &&
  (pathSegments[0] === "zh" || pathSegments[0] === "nl");

const pathWithoutLanguage = isPrefixedPath
  ? pathSegments.slice(1)
  : pathSegments;

/*
=========================================================
PROJECT TRANSLATION CHECK (per target language)
=========================================================
*/

let detailType: string | undefined;
let detailSlug = "";

if (pathWithoutLanguage.length >= 2) {
  const section = pathWithoutLanguage[0];
  detailSlug = pathWithoutLanguage[1];

  detailType = Object.entries(typeToRoute).find(
    ([, route]) => route === section,
  )?.[0];
}

const langTargets = (["nl", "en", "zh"] as const).map((lang) => {
  const targetPath = getLocalizedPath(Astro.url.pathname, lang);

  let available = true;

  if (detailType && detailSlug) {
    /*
     * Content Collection ID:
     *
     * 3d-printing-abs-material-test/en
     * 3d-printing-abs-material-test/zh
     *
     * 项目 slug 是第一段
     */
    available = entries.some((entry) => {
      const entrySlug = entry.id.split("/")[0];

      return (
        entry.data.type === detailType &&
        entry.data.lang === lang &&
        entrySlug === detailSlug
      );
    });
  }

  return {
    lang,
    label: lang === "nl" ? "NL" : lang === "en" ? "EN" : "中文",
    href: available ? targetPath : Astro.url.pathname,
    available,
  };
});

/*
 * =========================================================
 * TRANSLATIONS
 * =========================================================
 */

const t = getTranslations(currentLanguage);
---

<nav>
  <div class="nav-inner">
    <!-- BRAND -->

    <div class="brand">
      <a href={homePath} class="brand-link">
        <div class="brand-mark">
          <span class="rgb-dot dot-r"></span>
          <span class="rgb-dot dot-y"></span>
          <span class="rgb-dot dot-b"></span>
        </div>
        <span> RrS // STUDIO </span>
      </a>
    </div>

    <!-- NAVIGATION -->

    <div class="links">
      <a href={homePath} aria-current={isCurrent(homePath) ? "page" : undefined}>
        {t.nav.home}
      </a>

      <a href={projectsPath} aria-current={isCurrent(projectsPath) ? "page" : undefined}>
        {t.nav.projects}
      </a>

      <a href={labPath} aria-current={isCurrent(labPath) ? "page" : undefined}>
        {t.nav.lab}
      </a>

      <a href={artPath} aria-current={isCurrent(artPath) ? "page" : undefined}>
        {t.nav.art}
      </a>

      <a href={notesPath} aria-current={isCurrent(notesPath) ? "page" : undefined}>
        {t.nav.notes}
      </a>

      <a href={aboutPath} aria-current={isCurrent(aboutPath) ? "page" : undefined}>
        {t.nav.about}
      </a>

      <div class="lang-switch" data-lang-active={currentLanguage}>
        {langTargets.map((target) => (
          <Fragment>
            {target.lang !== "nl" && <span class="lang-sep"></span>}
            <a
              href={target.href}
              class={`lang-pos lang-pos--${target.lang}`}
              data-language-available={target.available}
              data-language-message={t.language.unavailable}
            >
              {target.label}
            </a>
          </Fragment>
        ))}
      </div>

      <button class="theme-switch" onclick="window.__toggleTheme?.()" aria-label="Toggle theme">
        <span class="switch-knob"><span class="knob-face"></span></span>
        <span class="switch-stars" aria-hidden="true"></span>
        <span class="switch-cloud" aria-hidden="true"></span>
      </button>

      <button
        class="snd-switch"
        type="button"
        data-snd-btn
        onclick="this.classList.toggle('on', window.__r2sSnd?.toggle())"
        aria-label="Toggle sound effects"
      >
        <span class="snd-label">SND</span>
        <span class="snd-led" aria-hidden="true"></span>
      </button>
    </div>

    <!-- SYSTEM STATUS -->

    <div class="status">
      <span class="label">
        {t.system.status}
      </span>

      <span class="online">
        {t.system.online}
      </span>

      <span class="separator"> // </span>

      <span id="clock"> 00:00:00 </span>
    </div>
  </div>

  <!-- WARNING STRIPE -->

  <div class="warning-stripe"></div>

  <!-- =====================================================
       LANGUAGE SYSTEM ALERT

       注意：

       这个元素虽然写在 Navbar 中，
       JavaScript 会在页面加载后把它移动到 body。

       因此它不会被 nav 的 stacking context 限制。
       ===================================================== -->

  <div id="language-toast" class="language-toast" aria-hidden="true">
    <div class="target target-tl"></div>
    <div class="target target-tr"></div>
    <div class="target target-bl"></div>
    <div class="target target-br"></div>

    <div class="alert-panel">
      <!-- HEADER -->

      <div class="alert-header">
        <span class="header-line"></span>

        <span class="header-text"> SYSTEM // LANGUAGE // NOTICE </span>

        <span class="header-line"></span>
      </div>

      <!-- ICON -->

      <div class="alert-icon">!</div>

      <!-- MESSAGE -->

      <div class="alert-message"></div>

      <!-- META -->

      <div class="alert-meta">
        <span class="status-dot"></span>

        TRANSLATION // UNAVAILABLE
      </div>

      <!-- CORNERS -->

      <span class="corner corner-tl"></span>

      <span class="corner corner-tr"></span>

      <span class="corner corner-bl"></span>

      <span class="corner corner-br"></span>
    </div>
  </div>

  <!-- =====================================================
       JAVASCRIPT
       ===================================================== -->

  <script>
    /*
    =========================================================
    CLOCK
    =========================================================
    */

    function updateClock() {
      const el = document.getElementById("clock");

      if (el) {
        const now = new Date();

        el.textContent = now.toTimeString().split(" ")[0];
      }
    }

    // ClientRouter re-executes scripts per navigation — start once only
    if (!(window as unknown as { __r2sClockStarted?: boolean }).__r2sClockStarted) {
      (window as unknown as { __r2sClockStarted?: boolean }).__r2sClockStarted = true;

      setInterval(updateClock, 1000);
    }

    updateClock();

    /*
    =========================================================
    SOUND — nav click blip (engine defaults to OFF)
    =========================================================
    */

    document.querySelectorAll<HTMLAnchorElement>(".links a").forEach((a) => {
      a.addEventListener("click", () => {
        window.__r2sSnd?.click();
      });
    });

    /*
    =========================================================
    MOVE LANGUAGE TOAST TO BODY
    =========================================================

    这是整个修复的关键。

    Navbar 本身存在自己的 stacking context：

        nav
          z-index: 100

    如果 toast 留在 nav 里面，
    即使 toast 写：

        z-index: 2147483647

    它依然不能真正超越 nav 外面的
    更高层 stacking context。

    所以直接把 toast 移到 body。

    =========================================================
    */

    const toast = document.getElementById("language-toast");

    if (toast && toast.parentElement !== document.body) {
      document.body.appendChild(toast);
    }

    /*
    =========================================================
    LANGUAGE FALLBACK
    =========================================================
    */

    let toastTimer: number | undefined;

    /*
    使用 document delegation。

    这样即使 Astro 页面发生
    client-side navigation，
    语言按钮仍然可以工作。
    每次点击时实时查找 toast 元素，
    因为换页后旧元素会被替换。
    */

    const navState = window as unknown as { __r2sToastBound?: boolean };

    if (!navState.__r2sToastBound) {
      navState.__r2sToastBound = true;

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;

        const languageButton = target.closest(
          ".lang-switch a[data-language-available]",
        ) as HTMLAnchorElement | null;

        if (!languageButton) {
          return;
        }

        const toastLive = document.getElementById("language-toast");
        const messageLive = toastLive?.querySelector(".alert-message");

        if (!toastLive || !messageLive) {
          return;
        }

        /*
          =====================================================
          AVAILABLE
          =====================================================

          有翻译：

          让浏览器正常跳转。
          */

        const available = languageButton.dataset.languageAvailable === "true";

        if (available) {
          return;
        }

        /*
          =====================================================
          UNAVAILABLE
          =====================================================

          没有翻译：

          阻止页面跳转，
          显示提示框。
          */

        event.preventDefault();

        const message =
          languageButton.dataset.languageMessage || "Translation unavailable";

        messageLive.textContent = message;

        /*
          显示
          */

        toastLive.classList.add("show");

        toastLive.setAttribute("aria-hidden", "false");

        /*
          清除旧 timer
          */

        if (toastTimer) {
          window.clearTimeout(toastTimer);
        }

        /*
          3 秒后关闭
          */

        toastTimer = window.setTimeout(() => {
          toastLive.classList.remove("show");

          toastLive.setAttribute("aria-hidden", "true");
        }, 3000);
      });
    }
  </script>

  <!-- =====================================================
       STYLE
       ===================================================== -->

  <style>
    /*
    =========================================================
    NAVBAR
    =========================================================
    */

    nav {
      position: sticky;

      top: 0;

      z-index: 100;

      background: var(--surface-nav);

      backdrop-filter: blur(12px) saturate(1.2);

      border-bottom: 1px solid var(--border);

      transition: background 0.4s var(--ease-out);

      /* Subtle industrial panel texture */
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.02),
        0 2px 20px rgba(0, 0, 0, 0.4);
    }

    :root[data-theme="light"] nav {
      background: var(--surface-nav);
    }

    :root[data-theme="light"] .brand-link { color: #2a2a2a; }
    :root[data-theme="light"] .brand-link:hover { color: var(--accent); }
    :root[data-theme="light"] .links a { color: var(--text-dim); }
    :root[data-theme="light"] .links a:hover { color: var(--text-bright); }
    :root[data-theme="light"] .status .label { color: var(--text-tertiary); }
    :root[data-theme="light"] #clock { color: #333; }
    :root[data-theme="light"] .status .online { color: var(--terminal-green); }

    .nav-inner {
      height: 72px;

      padding: 0 40px;

      display: flex;

      align-items: center;

      justify-content: space-between;
    }

    /*
    =========================================================
    BRAND
    =========================================================
    */

    .brand {
      flex-shrink: 0;
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 900;
      font-size: 14px;
      letter-spacing: var(--tracking-label);
      color: var(--text-bright);
      text-decoration: none;
      transition: 0.2s;
    }

    .brand-link:hover {
      color: var(--accent);
    }

    .brand-link:active {
      transform: scale(0.94);
      transition: transform 0.08s var(--spring-snappy);
    }

    .brand-mark {
      position: relative;

      width: 22px;

      height: 22px;

      flex-shrink: 0;

      isolation: isolate;
    }

    .rgb-dot {
      position: absolute;

      width: 13px;

      height: 13px;

      border-radius: 50%;

      mix-blend-mode: screen;
    }

    .dot-r {
      top: 0;

      left: 50%;

      transform: translateX(-50%);

      background: #ff3333;

      opacity: 0.9;
    }

    .dot-y {
      bottom: 0;

      left: 0;

      background: #ffd400;

      opacity: 0.9;
    }

    .dot-b {
      bottom: 0;

      right: 0;

      background: #00b0ff;

      opacity: 0.9;
    }

    /*
    =========================================================
    NAV LINKS
    =========================================================
    */

    .links {
      display: flex;

      gap: 28px;

      align-items: center;
    }

    .links a {
      position: relative;

      font-size: var(--text-scale-2xs);

      letter-spacing: var(--tracking-wider);

      color: #aaa;

      padding: 8px 0;

      text-decoration: none;

      transition:
        color 0.2s var(--ease-out),
        transform 0.2s var(--spring-snappy);
    }

    .links a:active {
      transform: scale(0.93);
      transition: transform 0.08s var(--spring-snappy);
    }

    .links a::after {
      content: "";

      position: absolute;

      bottom: 0;

      left: 0;

      height: 2px;

      width: 0;

      background: var(--accent);

      transition: width 0.3s var(--spring-gentle);
    }

    .links a:hover {
      color: var(--text);
    }

    .links a:hover::after {
      width: 100%;
    }

    /* ── Current page (B10) ── */
    .links a[aria-current="page"] {
      color: var(--text-bright);
    }

    .links a[aria-current="page"]::after {
      width: 100%;
    }

    /* ========== LANGUAGE SWITCH ========== */

    .lang-switch {
      display: flex;
      align-items: baseline;
      gap: 5px;
      padding: 8px 0;
      margin-top: -1px;
      flex-shrink: 0;
    }

    .lang-pos {
      font-size: var(--text-scale-2xs);
      font-weight: 700;
      letter-spacing: var(--tracking-micro);
      color: #666;
      text-decoration: none;
      transition:
        color 0.2s var(--ease-out),
        transform 0.16s var(--spring-snappy);
    }
    .lang-pos:hover { color: var(--text-bright); }
    .lang-pos:active { transform: scale(0.95); }

    .lang-sep {
      width: 1px; height: 12px;
      background: #444;
      flex-shrink: 0;
    }

    [data-lang-active="en"] .lang-pos--en,
    [data-lang-active="zh"] .lang-pos--zh,
    [data-lang-active="nl"] .lang-pos--nl {
      color: var(--accent);
    }

    :root[data-theme="light"] .lang-sep {
      background: var(--border-divider);
    }

    /* ========== THEME SWITCH ========== */

    .theme-switch {
      position: relative; width: 44px; height: 22px; padding: 2px; margin-top: 2px;
      background: linear-gradient(180deg, #1c1c24 0%, #121218 100%);
      border: 1px solid #3a3a44; border-radius: 3px;
      cursor: pointer; flex-shrink: 0; overflow: hidden;
      transition: background 0.3s var(--ease-out), border-color 0.3s var(--ease-out), transform 0.16s var(--ease-out);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 1px 3px rgba(0,0,0,0.4);
    }
    .theme-switch:active { transform: scale(0.92); transition: transform 0.08s var(--spring-snappy); }
    .theme-switch:hover { border-color: var(--accent); }

    .switch-knob {
      position: absolute; top: 2px; left: 2px; z-index: 2;
      display: block; width: 16px; height: 16px; border-radius: 50%;
      transition: transform 0.4s var(--spring-bounce);
    }
    .knob-face {
      display: block; width: 100%; height: 100%; border-radius: 50%;
      background: radial-gradient(circle at 55% 40%, #999 0%, #ccc 30%, #888 60%, #555 100%);
      box-shadow: 0 1px 2px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.3);
      transition: background 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
    }
    :root[data-theme="light"] .switch-knob { transform: translateX(20px); }
    :root[data-theme="light"] .knob-face {
      background: radial-gradient(circle at 40% 40%, #ffe484 0%, #f7b731 50%, #e89a1a 100%);
      box-shadow: 0 0 4px rgba(247,183,49,0.6), 0 0 8px rgba(247,183,49,0.3), 0 1px 2px rgba(0,0,0,0.3);
    }

    .switch-stars {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none; opacity: 1;
      transition: opacity 0.3s var(--ease-out);
    }
    .switch-stars::before {
      content: "";
      position: absolute; top: 3px; right: 7px;
      width: 1.5px; height: 1.5px; border-radius: 50%; background: #fff;
      box-shadow:
        -5px 1px 0 0 rgba(255,255,255,0.9),
        -9px 5px 0 0 rgba(255,255,255,0.6),
        -3px 8px 0 0 rgba(255,255,255,0.5),
        -11px 2px 0 0 rgba(255,255,255,0.35),
        -7px 10px 0 0 rgba(255,255,255,0.4);
      animation: starTwinkle 3s ease-in-out infinite;
    }
    @keyframes starTwinkle { 0%, 100% { opacity: 0.7; } 50% { opacity: 1; } }
    :root[data-theme="light"] .switch-stars { opacity: 0; }

    .switch-cloud {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none; opacity: 0;
      transition: opacity 0.3s var(--ease-out);
    }
    .switch-cloud::before {
      content: "";
      position: absolute; top: 7px; left: 5px;
      width: 5px; height: 4px; border-radius: 50%;
      background: rgba(255,255,255,0.75);
      box-shadow:
        3px -2px 0 1px rgba(255,255,255,0.55),
        7px 0 0 1px rgba(255,255,255,0.5);
    }
    :root[data-theme="light"] .switch-cloud { opacity: 1; }

    :root[data-theme="light"] .theme-switch {
      background: linear-gradient(180deg, #87ceeb 0%, #b8e4f0 50%, #e0f0ff 100%);
      border-color: #8ab8cc;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 1px 2px rgba(0,0,0,0.08);
    }

    /* ========== SND SWITCH (B9) ========== */

    .snd-switch {
      display: inline-flex;

      align-items: center;

      gap: 5px;

      padding: 4px 8px;

      margin-top: 2px;

      background: rgba(255, 255, 255, 0.04);

      border: 1px solid #3a3a44;

      border-radius: 3px;

      cursor: pointer;

      flex-shrink: 0;

      transition:
        border-color 0.25s var(--ease-out),
        transform 0.12s var(--spring-snappy);
    }

    .snd-switch:active {
      transform: scale(0.92);
    }

    .snd-switch:hover {
      border-color: var(--accent);
    }

    .snd-label {
      font-family: var(--font-mono);

      font-size: 9px;

      font-weight: 700;

      letter-spacing: 1px;

      color: #888;

      transition: color 0.25s var(--ease-out);
    }

    .snd-led {
      width: 6px;

      height: 6px;

      border-radius: 50%;

      background: #333;

      transition:
        background 0.25s var(--ease-out),
        box-shadow 0.25s var(--ease-out);
    }

    .snd-switch.on .snd-led {
      background: var(--terminal-green);

      box-shadow: 0 0 6px rgba(58, 240, 79, 0.7);
    }

    .snd-switch.on .snd-label {
      color: var(--terminal-green);
    }

    :root[data-theme="light"] .snd-switch {
      border-color: var(--border-strong);

      background: rgba(0, 0, 0, 0.03);
    }

    /*
    =========================================================
    SYSTEM STATUS
    =========================================================
    */

    .status {
      font-size: var(--text-scale-3xs);

      letter-spacing: var(--tracking-label);

      display: flex;

      gap: 8px;

      align-items: center;
    }

    .label {
      color: var(--text-dim);
    }

    .online {
      color: var(--terminal-green);

      font-weight: bold;
    }

    .separator {
      color: #444;
    }

    #clock {
      color: var(--text-bright);
    }

    /* ── Vacuum tube cluster ── */

    /*
    =========================================================
    WARNING STRIPE
    =========================================================
    */

    .warning-stripe {
      height: 2px;

      width: 100%;

      background: #ff5f1f;

      border-top: 1px solid rgba(255, 95, 31, 0.25);

      border-bottom: 1px solid rgba(255, 95, 31, 0.25);

      opacity: 0.35;

      animation: warning-pulse 8s ease-in-out infinite;
    }

    @keyframes warning-pulse {
      0%,
      100% {
        opacity: 0.25;

        filter: brightness(0.65);
      }

      50% {
        opacity: 0.85;

        filter: brightness(1.15);
      }
    }

    /*
    =========================================================
    LANGUAGE SYSTEM OVERLAY
    =========================================================

    这个元素最终会被移动到 body。

    所以这里不再依赖 nav 的层级。

    =========================================================
    */

    .language-toast {
      position: fixed;

      inset: 0;

      width: 100vw;

      height: 100vh;

      display: flex;

      align-items: center;

      justify-content: center;

      padding: 40px;

      background:
        radial-gradient(
          circle at center,
          rgba(var(--accent-rgb), 0.035),
          transparent 45%
        ),
        rgba(0, 0, 0, 0.35);

      opacity: 0;

      pointer-events: none;

      z-index: 100000;

      isolation: isolate;

      transition:
        opacity 0.3s var(--ease-out),
        backdrop-filter 0.3s var(--ease-out);

      backdrop-filter: blur(0px);
    }

    /*
    =========================================================
    SHOW
    =========================================================
    */

    .language-toast.show {
      opacity: 1;

      pointer-events: auto;

      backdrop-filter: blur(2px);
    }

    .language-toast .alert-panel {
      transform: scale(0.85);
      transition: transform 0.5s var(--spring-expressive);
    }

    .language-toast.show .alert-panel {
      transform: scale(1);
    }

    /*
    =========================================================
    ALERT PANEL
    =========================================================
    */

    .alert-panel {
      position: relative;

      width: min(760px, 90vw);

      min-height: 360px;

      padding: 80px 70px 65px;

      display: flex;

      flex-direction: column;

      align-items: center;

      justify-content: center;

      text-align: center;

      background:
        linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
        rgba(5, 5, 7, 0.97);

      background-size:
        100% 6px,
        6px 100%;

      border: 1px solid var(--accent);

      box-shadow:
        0 0 0 1px rgba(var(--accent-rgb), 0.08),
        0 0 40px rgba(var(--accent-rgb), 0.16),
        0 0 120px rgba(var(--accent-rgb), 0.08),
        0 40px 120px rgba(0, 0, 0, 0.8);

      overflow: visible;
    }

