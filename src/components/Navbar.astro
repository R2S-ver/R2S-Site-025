---
import { getLanguageFromPath, getLocalizedPath } from "../utils/i18n";

const currentLanguage = getLanguageFromPath(Astro.url.pathname);

const homePath = getLocalizedPath("/", currentLanguage);
const projectsPath = getLocalizedPath("/projects", currentLanguage);
const labPath = getLocalizedPath("/lab", currentLanguage);
const galleryPath = getLocalizedPath("/gallery", currentLanguage);
const notesPath = getLocalizedPath("/notes", currentLanguage);
const aboutPath = getLocalizedPath("/about", currentLanguage);

// 当前页面对应的另一种语言
const languagePath = getLocalizedPath(
  Astro.url.pathname,
  currentLanguage === "en" ? "zh" : "en",
);
---

<nav>
  <div class="nav-inner">
    <div class="brand">
      <div class="logo">
        <span class="red"></span>
        <span class="yellow"></span>
        <span class="teal"></span>
      </div>

      <a href={homePath}>R2S // STUDIO</a>
    </div>

    <div class="links">
      <a href={homePath}>HOME</a>

      <a href={projectsPath}>PROJECTS</a>

      <a href={labPath}>LAB</a>

      <a href={galleryPath}>ART</a>

      <a href={notesPath}>NOTES</a>

      <a href={aboutPath}>ABOUT</a>

      <a href={languagePath} class="language">
        {currentLanguage === "en" ? "中文" : "EN"}
      </a>
    </div>

    <div class="status">
      <span class="label">SYS_STATUS:</span>

      <span class="online">ONLINE</span>

      <span class="separator">//</span>

      <span id="clock">00:00:00</span>
    </div>
  </div>

  <div class="warning-stripe"></div>

  <script>
    function updateClock() {
      const el = document.getElementById("clock");

      if (el) {
        const now = new Date();

        el.textContent = now.toTimeString().split(" ")[0];
      }
    }

    setInterval(updateClock, 1000);

    updateClock();
  </script>

  <style>
    nav {
      position: sticky;

      top: 0;

      z-index: 100;

      background: rgba(5, 5, 7, 0.88);

      backdrop-filter: blur(10px);

      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      height: 72px;

      padding: 0 40px;

      display: flex;

      align-items: center;

      justify-content: space-between;
    }

    .brand {
      display: flex;

      align-items: center;

      gap: 15px;

      font-weight: 900;

      line-height: 1;

      font-size: 14px;

      letter-spacing: 1px;
    }

    .brand a {
      color: white;
    }

    .logo {
      display: flex;
      width: 36px;
      height: 18px;
      overflow: hidden;
      border-radius: 2px;
      flex-shrink: 0;
    }

    .logo span {
      display: block;
      width: 12px;
      height: 18px;
    }

    .logo .red {
      background: var(--stripe-red);
    }

    .logo .yellow {
      background: var(--stripe-yellow);
    }

    .logo .teal {
      background: var(--stripe-teal);
    }

    .links {
      display: flex;

      gap: 28px;
    }

    .links a {
      position: relative;

      font-size: 12px;

      letter-spacing: 1.5px;

      color: #aaa;

      padding: 8px 0;

      transition: 0.25s;
    }

    .links a::after {
      content: "";

      position: absolute;

      bottom: 0;

      left: 0;

      height: 2px;

      width: 0;

      background: var(--accent);

      transition: 0.25s;
    }

    .links a:hover {
      color: white;
    }

    .links a:hover::after {
      width: 100%;
    }

    .status {
      font-size: 11px;

      letter-spacing: 1px;

      display: flex;

      gap: 8px;

      align-items: center;
    }

    .label {
      color: #777;
    }

    .online {
      color: var(--terminal-green);

      font-weight: bold;
    }

    .separator {
      color: #444;
    }

    #clock {
      color: white;
    }

    /* =========================
   INDUSTRIAL WARNING STRIPE
========================= */

    .warning-stripe {
      height: 2px;

      width: 100%;

      background: #ff5f1f;

      border-top: 1px solid rgba(255, 95, 31, 0.25);

      border-bottom: 1px solid rgba(255, 95, 31, 0.25);

      opacity: 0.35;

      animation: warning-pulse 8s ease-in-out infinite;
    }

    @keyframes warning-pulse {
      0%,
      100% {
        opacity: 0.25;

        filter: brightness(0.65);
      }

      50% {
        opacity: 0.85;

        filter: brightness(1.15);
      }
    }

    @media (max-width: 1000px) {
      .nav-inner {
        height: auto;

        padding: 20px;

        flex-direction: column;

        gap: 20px;
      }

      .links {
        flex-wrap: wrap;

        justify-content: center;
      }

      .status {
        display: none;
      }
    }
  </style>
</nav>
