---
import { Image } from "astro:assets";
import { getProjectImage } from "../utils/images";
import { getLanguageFromPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

interface Props {
  project: any;
  projectId: string;
  Content: any;
  translation?: any;
}

const { project, projectId, Content, translation } = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const translationSlug = translation ? translation.id.split("/")[0] : null;

const routeMap: Record<string, string> = {
  work: "projects",
  lab: "lab",
  note: "notes",
  gallery: "gallery",
};

const translationPath =
  translation && translationSlug
    ? language === "en"
      ? `/zh/${routeMap[project.data.type]}/${translationSlug}`
      : `/${routeMap[project.data.type]}/${translationSlug}`
    : null;

const cover = project.data.cover
  ? getProjectImage(projectId, project.data.cover)
  : null;

const date = project.data.date.toLocaleDateString(
  language === "zh" ? "zh-CN" : "en-US",
  {
    year: "numeric",
    month: "long",
  },
);
---

<main class="project">
  <section class="hero">
    <div class="cover">
      {cover && <Image src={cover} alt={project.data.title} />}
    </div>

    <div class="hero-text">
      <h1>
        {project.data.title}
      </h1>

      {
        project.data.description && (
          <p class="description">{project.data.description}</p>
        )
      }
    </div>
  </section>

  <section class="info">
    <div>
      <h3>{t.common.year}</h3>

      <p>
        {date}
      </p>
    </div>

    <div>
      <h3>{t.common.type}</h3>

      <p>
        {project.data.type}
      </p>
    </div>

    <div>
      <h3>{t.common.category}</h3>

      <p>
        {project.data.category}
      </p>
    </div>

    <div>
      <h3>{t.common.tools}</h3>

      <p>
        {project.data.tools?.join(" · ")}
      </p>
    </div>
  </section>

  <div class="tags">
    {project.data.tags?.map((tag: string) => <span class="tag">#{tag}</span>)}
  </div>

  <hr />

  <div class="content-layout">
    <aside class="toc">
      <h3>{t.common.contents}</h3>

      <nav id="toc-list" class="toc-list"></nav>
    </aside>

    <article>
      <Content />
    </article>
  </div>
</main>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const article = document.querySelector("article");
    const toc = document.querySelector("#toc-list");

    if (!article || !toc) return;

    const headings = article.querySelectorAll("h1");

    headings.forEach((heading, index) => {
      if (!heading.id) {
        heading.id = "section-" + index;
      }

      const link = document.createElement("a");

      link.href = "#" + heading.id;

      let title = heading.innerText.replace(/^\d+(\.\d+)*[\.\s-]*/, "");

      link.textContent = title;

      if (heading.tagName === "h2") {
        link.classList.add("sub");
      }

      toc.appendChild(link);
    });
  });
</script>

<style>
  .project {
    max-width: 1200px;

    margin: auto;

    padding: 0 40px;
  }

  .hero {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    gap: 60px;

    align-items: center;

    margin-bottom: 80px;

    max-width: 1000px;
  }

  .cover {
    width: 100%;

    aspect-ratio: 4 / 3;

    overflow: hidden;

    border-radius: 24px;
  }

  .cover :global(img) {
    width: 100%;

    height: 100%;

    object-fit: contain;

    display: block;

    background: #111;
  }

  .hero-text h1 {
    font-size: 56px;

    line-height: 1.15;

    margin-bottom: 25px;
  }

  .description {
    font-size: 22px;

    line-height: 1.5;

    color: #666;
  }

  .info {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 30px;

    margin-bottom: 40px;
  }

  .info h3 {
    font-size: 13px;

    text-transform: uppercase;

    color: #777;

    margin-bottom: 8px;

    letter-spacing: 1px;
  }

  .info p {
    font-size: 18px;
  }

  .tags {
    display: flex;

    gap: 10px;

    flex-wrap: wrap;

    margin-bottom: 60px;
  }

  .tag {
    background: rgba(255, 255, 255, 0.08);

    color: #ddd;

    border: 1px solid rgba(255, 255, 255, 0.2);

    padding: 6px 14px;

    border-radius: 999px;

    font-size: 13px;

    letter-spacing: 0.5px;
  }

  hr {
    border: none;

    border-top: 1px solid #ddd;

    margin-bottom: 60px;
  }

  /*
  ========================
  CONTENT + TOC
  ========================
  */

  .content-layout {
    position: relative;

    padding-left: 280px;
  }

  .toc {
    position: fixed;

    top: 120px;

    left: 40px;

    width: 220px;

    box-sizing: border-box;

    border-left: 1px solid rgba(255, 255, 255, 0.15);

    padding-left: 20px;

    font-family: var(--font-mono);
  }

  .toc h3 {
    font-size: 14px;

    letter-spacing: 2px;

    text-transform: uppercase;

    margin-bottom: 25px;

    color: var(--accent);

    font-weight: 900;
  }

  .content-layout article {
    max-width: 900px;

    margin: 0 auto;
  }

  .toc a {
    display: block;

    width: 100%;

    font-size: 13px;

    line-height: 1.6;

    color: #888;

    text-decoration: none;

    margin-bottom: 12px;

    padding: 4px 0;

    transition: 0.2s;
  }

  .toc a::before {
    content: "→";

    margin-right: 8px;

    opacity: 0.4;
  }

  .toc-list {
    display: flex;

    flex-direction: column;

    gap: 4px;
  }

  .toc a:hover::before {
    opacity: 1;
  }

  .toc a:hover {
    color: var(--stripe-teal);

    transform: translateX(5px);
  }

  .toc .sub {
    padding-left: 15px;

    font-size: 12px;
  }

  /*
  ========================
  ARTICLE
  ========================
  */

  article {
    font-size: 18px;

    line-height: 1.8;
  }

  :global(article h1) {
    margin-top: 80px;

    margin-bottom: 25px;

    font-size: 42px;

    line-height: 1.2;

    color: var(--retro-red) !important;

    font-weight: 900;
  }

  :global(article h2) {
    margin-top: 60px;

    margin-bottom: 20px;

    font-size: 32px;

    line-height: 1.3;

    color: var(--retro-yellow) !important;

    font-weight: 800;
  }

  :global(article h3) {
    margin-top: 40px;

    margin-bottom: 15px;

    font-size: 24px;

    line-height: 1.4;

    color: var(--retro-cyan) !important;

    font-weight: 700;
  }

  :global(article h2),
  :global(article h3) {
    position: relative;

    padding-left: 18px;
  }

  :global(article h2)::before {
    content: "";

    position: absolute;

    left: 0;

    top: 8px;

    width: 5px;

    height: 70%;

    background: var(--retro-yellow);
  }

  :global(article h3)::before {
    content: "";

    position: absolute;

    left: 0;

    top: 7px;

    width: 4px;

    height: 70%;

    background: var(--retro-cyan);
  }

  article p {
    margin-bottom: 20px;
  }

  article ul,
  article ol {
    padding-left: 30px;

    margin-bottom: 20px;
  }

  article li {
    margin-bottom: 8px;
  }

  article :global(img) {
    width: auto !important;

    height: auto !important;

    max-width: 850px !important;

    max-height: 800px !important;

    object-fit: contain !important;

    display: block;

    margin: 40px auto;

    border-radius: 16px;
  }

  article pre {
    background: #f5f5f5;

    padding: 20px;

    border-radius: 12px;

    overflow-x: auto;
  }

  /*
  ========================
  TABLE OF CONTENTS MOBILE
  ========================
  */

  @media (max-width: 1100px) {
    .content-layout {
      grid-template-columns: 1fr;

      padding-left: 0;
    }

    .toc {
      position: relative;

      top: auto;

      order: -1;

      margin-bottom: 40px;

      padding: 20px;

      border-left: none;

      border: 1px solid rgba(255, 255, 255, 0.15);

      border-radius: 12px;
    }

    .hero {
      grid-template-columns: 1fr;
    }

    .hero-text h1 {
      font-size: 40px;
    }

    .info {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .project {
      padding: 0 20px;
    }

    .info {
      grid-template-columns: 1fr;
    }

    .description {
      font-size: 18px;
    }

    article {
      font-size: 16px;
    }
  }
</style>
