---
import { getProjectImage } from "../utils/images";
import { Image } from "astro:assets";
import { getLanguageFromPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

const { project } = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

// project.id:
//
// 3d-printing-abs-material-test/en
// 3d-printing-abs-material-test/zh
//
// URL 只使用项目 slug
const slug = project.id.split("/")[0];

const image = project.data.cover
  ? getProjectImage(slug, project.data.cover)
  : null;

const date = project.data.date.toLocaleDateString(
  language === "zh" ? "zh-CN" : "en-US",
  {
    year: "numeric",
    month: "short",
  },
);

const routeMap: Record<string, string> = {
  work: "projects",
  lab: "lab",
  note: "note",
  art: "art",
};

// 中文页面统一使用 /zh 前缀
const languagePrefix = project.data.lang === "zh" ? "/zh" : "";

const url = `${languagePrefix}/${routeMap[project.data.type]}/${slug}`;

const type = project.data.type.toUpperCase();
---

<a href={url} class="card">
  <div class="corner"></div>

  <div class="card-header">
    <span>
      {t.card.projectNode}
      {type}
    </span>

    <span class="status">
      {t.card.online}
    </span>
  </div>

  {
    image && (
      <div class="image-wrapper">
        <div class="image-label">{t.card.imageStream}</div>

        <Image class="cover" src={image} alt={project.data.title} />
      </div>
    )
  }

  <div class="content">
    <h2>
      {project.data.title}
    </h2>

    <p class="description">
      {project.data.description}
    </p>

    {
      project.data.tags?.length && (
        <div class="tags">
          {project.data.tags.map((tag: string) => (
            <span>#{tag}</span>
          ))}
        </div>
      )
    }

    <div class="footer">
      <span>
        {t.card.category}
        {type}
      </span>

      <span>
        {t.card.archive}
        {date}
      </span>
    </div>
  </div>
</a>

<style>
  .card {
    display: block;

    position: relative;

    background: rgba(8, 8, 11, 0.92);

    border: 1px solid var(--border);

    color: white;

    text-decoration: none;

    overflow: hidden;

    min-height: 430px;

    font-family: var(--font-mono);

    transition:
      transform 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .card::before {
    content: "";

    position: absolute;

    left: 0;

    top: 0;

    height: 100%;

    width: 5px;

    background: var(--stripe-teal);
  }

  .corner {
    position: absolute;

    right: 0;

    top: 0;

    width: 40px;

    height: 40px;

    background: var(--accent);

    clip-path: polygon(100% 0, 100% 100%, 0 0);
  }

  .card:hover {
    transform: translateY(-8px);

    border-color: var(--accent);

    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
  }

  .card-header {
    display: flex;

    justify-content: space-between;

    padding: 16px 20px;

    border-bottom: 1px solid var(--border);

    font-size: 11px;

    letter-spacing: 1px;

    color: #777;
  }

  .status {
    color: var(--terminal-green);

    font-weight: bold;
  }

  .image-wrapper {
    height: 220px;

    background: #000;

    position: relative;

    overflow: hidden;

    border-bottom: 1px solid var(--border);
  }

  .image-label {
    position: absolute;

    top: 10px;

    left: 12px;

    z-index: 2;

    font-size: 10px;

    background: #000;

    border: 1px solid var(--accent);

    padding: 4px 8px;

    color: var(--accent);
  }

  .cover {
    width: 100%;

    height: 100%;

    object-fit: cover;

    transition: transform 0.5s;
  }

  .card:hover .cover {
    transform: scale(1.08);
  }

  .content {
    padding: 25px;
  }

  h2 {
    font-size: 28px;

    font-weight: 900;

    line-height: 1.1;

    margin-bottom: 15px;

    letter-spacing: -1px;
  }

  .description {
    font-size: 13px;

    color: #aaa;

    line-height: 1.7;

    margin-bottom: 25px;
  }

  .tags {
    display: flex;

    gap: 8px;

    flex-wrap: wrap;

    margin-bottom: 30px;
  }

  .tags span {
    font-size: 11px;

    padding: 5px 10px;

    border: 1px solid #333;

    background: #111;
  }

  .tags span:nth-child(3n + 1) {
    border-color: var(--stripe-red);

    color: #ff8888;
  }

  .tags span:nth-child(3n + 2) {
    border-color: var(--stripe-yellow);

    color: #ffe66d;
  }

  .tags span:nth-child(3n) {
    border-color: var(--stripe-teal);

    color: #66d5ff;
  }

  .footer {
    display: flex;

    justify-content: space-between;

    border-top: 1px dashed #333;

    padding-top: 15px;

    font-size: 10px;

    color: #777;
  }
</style>
