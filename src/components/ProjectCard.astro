---
import { getProjectImageUrl } from "../utils/images";
import { getLanguageFromPath } from "../utils/i18n";
import { buildEntryUrl } from "../utils/routes";
import { getTranslations } from "../utils/translations";

const { project } = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

// project.id:
//
// 3d-printing-abs-material-test/en
// 3d-printing-abs-material-test/zh
//
// URL 只使用项目 slug
const slug = project.id.split("/")[0];

const image = project.data.cover
  ? getProjectImageUrl(slug, project.data.cover)
  : null;

const date = project.data.date.toLocaleDateString(
  language === "zh" ? "zh-CN" : "en-US",
  {
    year: "numeric",
    month: "short",
  },
);

// URL 单一来源：utils/routes.ts 的 buildEntryUrl
// （历史教训：组件内自建路由映射曾产生 404）
const url = buildEntryUrl(project, project.data.lang);

const type = project.data.type.toUpperCase();
---

<a href={url} class="card">
  <div class="corner"></div>

  <span class="hud hud-tl" aria-hidden="true"></span>
  <span class="hud hud-tr" aria-hidden="true"></span>
  <span class="hud hud-bl" aria-hidden="true"></span>
  <span class="hud hud-br" aria-hidden="true"></span>

  <div class="card-header">
    <span>
      {t.card.projectNode}
      {type}
    </span>

    <span class="status">
      {t.card.online}
    </span>
  </div>

  {
    image && (
      <div class="image-wrapper">
        <div class="image-label">{t.card.imageStream}</div>

        {
          project.data.collaboration && project.data.collaboration.length > 0 && (
            <div class="collab-badge">
              {t.card.team}
            </div>
          )
        }

        <img class="cover" src={image} alt={project.data.title} loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="content">
    <div class="tape-label">
      <h2>
        {project.data.title}
      </h2>
    </div>

    <p class="description">
      {project.data.description}
    </p>

    {
      project.data.tags?.length && (
        <div class="tags">
          {project.data.tags.map((tag: string) => (
            <span>#{tag}</span>
          ))}
        </div>
      )
    }

    <div class="footer">
      <span>
        {t.card.category}
        {type}
      </span>

      <span class="footer-right">
        <span>
          {t.card.archive}
          {date}
        </span>

        <span class="tape-counter" aria-hidden="true">
          <span class="tc-reel"></span>
          000/100
        </span>
      </span>
    </div>
  </div>
</a>

<style>
  .card {
    display: block;

    position: relative;

    background:
      radial-gradient(circle at 13px 13px, rgba(255, 255, 255, 0.11) 0 1.7px, transparent 2.6px),
      radial-gradient(circle at calc(100% - 13px) 13px, rgba(255, 255, 255, 0.11) 0 1.7px, transparent 2.6px),
      radial-gradient(circle at 13px calc(100% - 13px), rgba(255, 255, 255, 0.11) 0 1.7px, transparent 2.6px),
      radial-gradient(circle at calc(100% - 13px) calc(100% - 13px), rgba(255, 255, 255, 0.11) 0 1.7px, transparent 2.6px),
      var(--surface-ink);

    border: 1px solid var(--border);

    color: var(--text-bright);

    text-decoration: none;

    overflow: hidden;

    min-height: 430px;

    font-family: var(--font-mono);

    transition:
      transform 0.4s var(--spring-bounce),
      border-color 0.45s var(--ease-warmup),
      box-shadow 0.45s var(--ease-warmup);
  }

  :root[data-theme="light"] .card {
    background:
      radial-gradient(circle at 13px 13px, rgba(0, 0, 0, 0.2) 0 1.7px, transparent 2.6px),
      radial-gradient(circle at calc(100% - 13px) 13px, rgba(0, 0, 0, 0.2) 0 1.7px, transparent 2.6px),
      radial-gradient(circle at 13px calc(100% - 13px), rgba(0, 0, 0, 0.2) 0 1.7px, transparent 2.6px),
      radial-gradient(circle at calc(100% - 13px) calc(100% - 13px), rgba(0, 0, 0, 0.2) 0 1.7px, transparent 2.6px),
      var(--paper);
  }

  .card:active {
    transform: scale(0.97);
    transition: transform 0.1s var(--spring-snappy);
  }

  /* ── Left accent stripe ── */
  .card::before {
    content: "";

    position: absolute;

    left: 0;

    top: 0;

    height: 100%;

    width: 5px;

    background: var(--stripe-teal);
  }

  .corner {
    position: absolute;

    right: 0;

    top: 0;

    width: 40px;

    height: 40px;

    background: var(--accent);

    clip-path: polygon(100% 0, 100% 100%, 0 0);
  }

  .card:hover {
    transform: translateY(-6px);

    border-color: var(--accent);

    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(var(--accent-rgb), 0.15);
  }

  /* ── Hover gloss sweep ── */
  .card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(255, 255, 255, 0.03) 40%,
      rgba(255, 255, 255, 0.06) 50%,
      rgba(255, 255, 255, 0.03) 60%,
      transparent 100%
    );
    transform: translateX(-100%);
    transition: transform 0.6s var(--ease-out);
    pointer-events: none;
  }

  .card:hover::after {
    transform: translateX(100%);
  }

  .card-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 8px;

    padding: 16px 20px;

    border-bottom: 1px solid var(--border);

    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-label);

    color: var(--text-dim);
  }

  .status {
    color: var(--terminal-green);

    font-weight: bold;
  }

  .image-wrapper {
    height: 220px;

    background: var(--bg);

    position: relative;

    overflow: hidden;

    border-bottom: 1px solid var(--border);
  }

  .image-label {
    position: absolute;

    top: 10px;

    left: 12px;

    z-index: 2;

    font-size: var(--text-scale-4xs);

    background: #000;

    border: 1px solid var(--accent);

    padding: 4px 8px;

    color: var(--accent);
  }

  :root[data-theme="light"] .image-label {
    background: var(--paper);
  }

  .collab-badge {
    position: absolute;

    top: 10px;

    right: 12px;

    z-index: 3;

    /* Typography */
    font-family: var(--font-mono);

    font-size: var(--text-scale-4xs);

    font-weight: 700;

    letter-spacing: var(--tracking-label);

    /* Shape — angular industrial tag */
    padding: 4px 10px;

    clip-path: polygon(
      6px 0,
      100% 0,
      calc(100% - 6px) 100%,
      0 100%
    );

    /* Background */
    background: rgba(8, 8, 11, 0.94);

    /* Text color — warm off-white */
    color: rgba(230, 220, 200, 0.9);

    /* Tri-color bottom border only */
    border-bottom: 1.5px solid transparent;

    border-image: linear-gradient(
      90deg,
      var(--stripe-red),
      var(--stripe-yellow),
      var(--stripe-teal)
    ) 1;

    /* Subtle text glow sweep */
    overflow: hidden;
  }

  /* ---- Tri-color accent glow sweep ---- */
  .collab-badge::before {
    content: "";

    position: absolute;

    top: 0;

    left: 0;

    width: 100%;

    height: 100%;

    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(255, 255, 255, 0.04) 45%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.04) 55%,
      transparent 100%
    );

    transform: translateX(-100%);

    animation: collabSweep 5s ease-in-out infinite;

    pointer-events: none;
  }

  @keyframes collabSweep {
    0% {
      transform: translateX(-100%);
    }

    35%,
    65% {
      transform: translateX(100%);
    }

    100% {
      transform: translateX(100%);
    }
  }

  /* ---- Corner notch — tri-color filled ---- */
  .collab-badge::after {
    content: "";

    position: absolute;

    bottom: 0;

    left: 0;

    width: 7px;

    height: 7px;

    background: linear-gradient(
      135deg,
      var(--stripe-red) 0%,
      var(--stripe-yellow) 100%
    );

    clip-path: polygon(0 100%, 100% 100%, 0 0);

    opacity: 0.6;
  }


  .cover {
    width: 100%;

    height: 100%;

    object-fit: cover;

    transition: transform 0.5s var(--spring-gentle);
  }

  .card:hover .cover {
    transform: scale(1.05);
  }

  .content {
    padding: 25px;
  }

  h2 {
    font-size: var(--text-scale-card);

    font-weight: 900;

    line-height: 1.1;

    margin-bottom: 15px;

    letter-spacing: var(--tracking-slight);
  }

  .description {
    font-size: var(--text-scale-xs);

    color: #aaa;

    line-height: 1.7;

    margin-bottom: 25px;
  }

  .tags {
    display: flex;

    gap: 8px;

    flex-wrap: wrap;

    margin-bottom: 30px;
  }

  .tags span {
    font-size: var(--text-scale-3xs);

    padding: 5px 10px;

    border: 1px solid var(--border-divider);

    background: #111;
  }

  .tags span:nth-child(3n + 1) {
    border-color: var(--stripe-red);

    color: var(--stripe-red-soft);
  }

  .tags span:nth-child(3n + 2) {
    border-color: var(--stripe-yellow);

    color: var(--stripe-yellow-soft);
  }

  .tags span:nth-child(3n) {
    border-color: var(--stripe-teal);

    color: var(--stripe-teal-soft);
  }

  .footer {
    display: flex;

    justify-content: space-between;

    border-top: 1px dashed var(--border-divider);

    padding-top: 15px;

    font-size: var(--text-scale-4xs);

    color: var(--text-dim);
  }

  /* ═══════════════════════════════════════════
     BEAUTIFY 2026-08 — HUD brackets, cassette
     label title, tape counter, CRT power-on
     ═══════════════════════════════════════════ */

  /* ── HUD corner brackets (A4, Arknights-style) ── */
  .hud {
    position: absolute;

    width: 14px;

    height: 14px;

    pointer-events: none;

    z-index: 2;

    opacity: 0;

    transition: opacity 0.3s var(--ease-out);
  }

  .hud::before,
  .hud::after {
    content: "";

    position: absolute;

    background: var(--accent);
  }

  .hud::before {
    width: 100%;

    height: 1px;
  }

  .hud::after {
    width: 1px;

    height: 100%;
  }

  .hud-tl {
    top: 6px;
    left: 6px;
  }

  .hud-tr {
    top: 6px;
    right: 6px;
    transform: rotate(90deg);
  }

  .hud-br {
    bottom: 6px;
    right: 6px;
    transform: rotate(180deg);
  }

  .hud-bl {
    bottom: 6px;
    left: 6px;
    transform: rotate(270deg);
  }

  .card:hover .hud {
    opacity: 0.85;
  }

  /* ── Cassette label strip title (A2) ── */
  .content .tape-label {
    margin-bottom: 15px;
  }

  .tape-label h2 {
    margin: 0;

    font-size: 20px;

    font-weight: 800;

    line-height: 1.15;

    letter-spacing: var(--tracking-slight);

    color: #1a1815;
  }

  :root[data-theme="light"] .tape-label h2 {
    color: #1a1815;
  }

  /* ── CRT power-on hover (B4) ── */
  .image-wrapper::after {
    content: "";

    position: absolute;

    inset: 0;

    z-index: 3;

    pointer-events: none;

    opacity: 0;

    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 44%,
      rgba(255, 255, 255, 0.5) 50%,
      transparent 56%,
      transparent 100%
    );
  }

  .card:hover .image-wrapper::after {
    animation: crtOn 0.38s steps(3) 1;
  }

  @keyframes crtOn {
    0% {
      opacity: 0;
      transform: scaleY(0.02);
      filter: brightness(6);
    }
    35% {
      opacity: 1;
      transform: scaleY(1);
    }
    55% {
      opacity: 0.9;
      transform: scaleY(0.92) translateY(1px);
      filter: brightness(2.4);
    }
    100% {
      opacity: 0;
      transform: scaleY(1);
      filter: brightness(1);
    }
  }

  .card:hover .cover {
    animation: crtJitter 0.3s steps(2) 1;
  }

  @keyframes crtJitter {
    0% {
      transform: scale(1.06);
    }
    40% {
      transform: scale(1.028) translateY(1px);
    }
    100% {
      transform: scale(1.05);
    }
  }

  /* ── Tape counter (B11) ── */
  .footer-right {
    display: flex;

    align-items: center;

    gap: 14px;
  }

  .tape-counter {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: var(--text-dim);

    transition: color 0.25s var(--ease-out);
  }

  .tc-reel {
    width: 9px;

    height: 9px;

    border-radius: 50%;

    border: 2px solid currentColor;

    border-top-color: var(--accent);

    transition: transform 0.5s var(--spring-gentle);
  }

  .card:hover .tc-reel {
    transform: rotate(360deg);
  }

  .card:hover .tape-counter {
    color: var(--terminal-green);
  }
</style>
