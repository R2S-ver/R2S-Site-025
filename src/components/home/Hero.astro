---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";

import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const projectsPath = getLocalizedPath("/projects", language);
---

<section class="hero">
  <div class="hero-left">
    <div class="data-tag">R2S_STUDIO // DESIGN_SYSTEM_v1.0</div>

    <div class="title-wrapper">
      <div class="tri-bar">
        <div></div>
        <div></div>
        <div></div>
      </div>

      <h1>
        {t.hero.title.line1}

        <br />

        <span>
          {t.hero.title.line2}
        </span>
      </h1>
    </div>

    <div class="cassette">
      <div class="barcode"></div>

      <span>
        {t.hero.cassette}
      </span>
    </div>

    <p class="description">
      {t.hero.description.line1}

      <br />
      <br />

      {t.hero.description.line2}
    </p>

    <a href={projectsPath} class="button">
      {t.hero.button}
    </a>
  </div>

  <div class="terminal">
    <div class="terminal-header">
      SYS.BOOT // KERNEL_CORE_v5.5

      <br />

      DATA_DECK:

      <span> [MAGNETIC_TAPE_OPTIMIZED] </span>
    </div>

    <div class="terminal-content">
      <div>
        &gt; CRISP_FONT_RENDERING...
        <span>STABILIZED.</span>
      </div>

      <div>
        &gt; RADAR_GRID_VECTOR_DENSITY...
        <span>MAXIMIZED.</span>
      </div>

      <div>
        &gt; CONTRAST_RATIO_CORRECTION...
        <span>COMPLETED.</span>
      </div>

      <br />

      <div>
        &gt; COLD_BOOT:
        <span>OPERATIONAL.</span>
      </div>

      <div>
        &gt; INGESTING_ROTTERDAM_FAB_DATA...
        <span>ONLINE.</span>
      </div>

      <div>
        &gt; CONTRAST_ENHANCEMENT:
        <span>RE-ENGAGED.</span>
      </div>

      <div>
        &gt; LOGS:
        <span>ALL_CORE_STYLES_COMPLIED.</span>
      </div>

      <br />

      <span class="cursor"> _ </span>
    </div>
  </div>
</section>

<style>
  .hero {
    max-width: 1400px;

    margin: auto;

    min-height: calc(100vh - 75px);

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 100px;

    padding: 80px 40px;
  }

  .hero-left {
    flex: 1;
  }

  .data-tag {
    display: inline-block;

    font-family: var(--font-mono);

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 2px;

    color: var(--accent);

    border: 1px solid var(--accent);

    padding: 8px 15px;

    margin-bottom: 35px;
  }

  .title-wrapper {
    display: flex;

    align-items: center;

    gap: 25px;
  }

  .tri-bar {
    width: 12px;

    height: 190px;

    display: flex;

    flex-direction: column;
  }

  .tri-bar div {
    flex: 1;
  }

  .tri-bar div:nth-child(1) {
    background: var(--stripe-red);
  }

  .tri-bar div:nth-child(2) {
    background: var(--stripe-yellow);
  }

  .tri-bar div:nth-child(3) {
    background: var(--stripe-teal);
  }

  h1 {
    font-family: var(--font-mono);

    font-size: clamp(80px, 10vw, 110px);

    font-weight: 900;

    line-height: 0.9;

    letter-spacing: -6px;

    text-shadow: 0 0 40px rgba(0, 176, 255, 0.15);
  }

  h1 span {
    color: var(--accent);
  }

  .cassette {
    display: flex;

    align-items: center;

    gap: 20px;

    margin-top: 45px;

    font-family: var(--font-mono);

    font-size: 12px;

    color: var(--accent);
  }

  .barcode {
    width: 140px;

    height: 35px;

    background: repeating-linear-gradient(
      90deg,
      white 0px,
      white 2px,
      transparent 2px,
      transparent 6px
    );

    opacity: 0.8;
  }

  .description {
    margin-top: 35px;

    max-width: 620px;

    font-size: 18px;

    line-height: 1.8;

    color: #ddd;

    border-left: 3px solid var(--accent);

    padding-left: 20px;
  }

  .description strong {
    color: white;
  }

  .button {
    margin-top: 40px;

    display: inline-block;

    padding: 16px 34px;

    border: 1px solid var(--accent);

    font-family: var(--font-mono);

    font-weight: bold;

    letter-spacing: 1px;

    transition: 0.25s;
  }

  .button:hover {
    background: var(--accent);

    color: black;
  }

  /* ==========================
   TERMINAL HUD
========================== */

  .terminal {
    width: 430px;

    padding: 32px;

    background: rgba(0, 0, 0, 0.75);

    border: 1px solid var(--accent);

    box-shadow: 0 0 30px rgba(255, 95, 31, 0.12);

    font-family: var(--font-mono);

    font-size: 13px;

    position: relative;
  }

  /* corner decoration */

  .terminal::before {
    content: "";

    position: absolute;

    top: -1px;

    left: -1px;

    width: 60px;

    height: 3px;

    background: var(--accent);
  }

  .terminal-header {
    padding-bottom: 18px;

    margin-bottom: 20px;

    border-bottom: 1px dashed rgba(255, 95, 31, 0.4);

    font-weight: bold;

    color: white;

    line-height: 1.8;
  }

  .terminal-header span {
    color: var(--accent);
  }

  .terminal-content {
    line-height: 2;

    color: #00ff88;
  }

  .terminal-content div {
    transition: 0.2s;
  }

  .terminal-content div:hover {
    padding-left: 8px;
  }

  .terminal-content span {
    color: #00ff88;

    font-weight: bold;
  }

  .cursor {
    color: var(--accent);

    animation: blink 1s infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column;

      align-items: flex-start;

      padding: 60px 25px;
    }

    .terminal {
      width: 100%;
    }
  }
</style>
