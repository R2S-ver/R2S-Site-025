---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);
const projectsPath = getLocalizedPath("/projects", language);
---

<section class="hero">
  <div class="hero-left">
    <div class="data-tag type-line">R2S_STUDIO // DESIGN_SYSTEM_v1.0</div>

    <div class="title-wrapper">
      <div class="tri-bar">
        <div></div><div></div><div></div>
      </div>
      <h1>
        <span class="type-line">{t.hero.title.line1}</span>
        <br />
        <span class="type-line accent">{t.hero.title.line2}</span>
      </h1>
    </div>

    <div class="cassette">
      <div class="barcode"></div>
      <span class="type-line">{t.hero.cassette}</span>
    </div>

    <p class="description type-line">
      {t.hero.description.line1}
      <br /><br />
      {t.hero.description.line2}
    </p>

    <a href={projectsPath} class="button type-line">
      {t.hero.button}
    </a>
  </div>

  <div class="terminal">
    <div class="terminal-header">
      SYS.BOOT // KERNEL_CORE_v5.5<br />
      DATA_DECK: <span>[MAGNETIC_TAPE_OPTIMIZED]</span>
    </div>
    <div class="terminal-content" id="terminal-log">
    </div>
    <div class="crt-fade-top"></div>
    <div class="crt-fade-bot"></div>
  </div>
</section>

<script>
  // ── Terminal boot lines ──
  const bootLines = [
    { text: "CRISP_FONT_RENDERING...", result: "STABILIZED." },
    { text: "RADAR_GRID_VECTOR_DENSITY...", result: "MAXIMIZED." },
    { text: "CONTRAST_RATIO_CORRECTION...", result: "COMPLETED." },
    { text: "", result: "" },
    { text: "COLD_BOOT:", result: "OPERATIONAL." },
    { text: "INGESTING_ROTTERDAM_FAB_DATA...", result: "ONLINE." },
    { text: "CONTRAST_ENHANCEMENT:", result: "RE-ENGAGED." },
    { text: "LOGS:", result: "ALL_CORE_STYLES_COMPILED." },
  ];

  const termEl = document.getElementById("terminal-log");
  const leftLines = document.querySelectorAll<HTMLElement>(".type-line");

  // Hide left-side text initially
  leftLines.forEach((el) => {
    el.dataset.original = el.innerHTML;
    el.innerHTML = "";
    el.style.visibility = "visible";
    el.style.opacity = "1";
  });

  // ── Typewriter engine ──
  function typeElement(el: HTMLElement, html: string, speed: number): Promise<void> {
    return new Promise((resolve) => {
      // For simple text, type char by char
      const temp = document.createElement("div");
      temp.innerHTML = html;
      const text = temp.textContent || "";
      let i = 0;
      el.innerHTML = "";
      el.classList.add("typing");

      const timer = setInterval(() => {
        if (i < text.length) {
          el.textContent = text.slice(0, i + 1);
          i++;
        } else {
          // Restore full HTML (for <br>, <span> etc.)
          el.innerHTML = html;
          el.classList.remove("typing");
          clearInterval(timer);
          resolve();
        }
      }, speed);
    });
  }

  function typeTerminalLine(
    parent: HTMLElement,
    label: string,
    result: string,
    speed: number,
  ): Promise<void> {
    return new Promise((resolve) => {
      if (!label) {
        const br = document.createElement("br");
        parent.appendChild(br);
        resolve();
        return;
      }
      const div = document.createElement("div");
      div.innerHTML = `&gt; ${label} `;
      parent.appendChild(div);

      const span = document.createElement("span");
      div.appendChild(span);

      // Type the label
      const text = `> ${label} `;
      let i = 0;
      const timer = setInterval(() => {
        if (i < text.length) {
          div.innerHTML = "";
          const typed = text.slice(0, i + 1);
          div.appendChild(document.createTextNode(typed));
          div.appendChild(span);
          i++;
        } else {
          clearInterval(timer);
          // Reveal result with a short delay
          setTimeout(() => {
            span.textContent = result;
            span.style.color = "#00ff88";
            resolve();
          }, 120);
        }
      }, speed);
    });
  }

  // ── Live system log lines (after initial boot) ──
  const liveLogs = [
    { text: "ACQUIRING_PARTICLE_SIGNAL...", result: "LOCKED." },
    { text: "NEURAL_MESH_DENSITY:", result: "0.847"},
    { text: "RENDER_PIPELINE_FLUSH...", result: "OK." },
    { text: "MEMORY_HEAP_FRAGMENTATION:", result: "12%"},
    { text: "KERNEL_TIMER_SYNC...", result: "CALIBRATED." },
    { text: "BACKBUFFER_SWAP_CHAIN:", result: "VSYNC_ON."},
    { text: "THERMAL_THROTTLE_STATUS:", result: "NOMINAL."},
    { text: "FRAME_PACING_DELTA:", result: "2.1ms"},
    { text: "GPU_COMMAND_BUFFER...", result: "FLUSHED."},
    { text: "AUDIO_DSP_LATENCY_CHECK...", result: "PASSED."},
    { text: "NETWORK_SOCKET_POOL:", result: "HEALTHY."},
    { text: "SHADER_CACHE_REBUILD...", result: "DONE."},
    { text: "PHYSICS_TICK_RATE:", result: "60Hz"},
    { text: "ASSET_STREAMING_QUEUE...", result: "EMPTY."},
    { text: "INPUT_LAG_MEASUREMENT:", result: "0.8ms"},
    { text: "RAY_TRACING_BVH_UPDATE...", result: "READY."},
  ];

  async function typeTerminalSequence() {
    // Initial boot lines
    for (const line of bootLines) {
      await typeTerminalLine(termEl, line.text, line.result, 8);
    }
    const cursor = document.createElement("span");
    cursor.className = "cursor";
    cursor.textContent = " _";
    termEl.appendChild(cursor);

    // Live scrolling log — continuously add lines
    let logIndex = 0;
    function addLiveLine() {
      const line = liveLogs[logIndex % liveLogs.length];
      // Remove cursor temporarily
      cursor.remove();
      typeTerminalLine(termEl, line.text, line.result, 6).then(() => {
        termEl.appendChild(cursor);
        // Scroll to bottom
        termEl.scrollTop = termEl.scrollHeight;
      });
      // Remove old lines if too many
      while (termEl.children.length > 20) {
        termEl.firstChild?.remove();
      }
      logIndex++;
    }

    // Start live logging with varying intervals
    setInterval(addLiveLine, 1200 + Math.random() * 800);
    // First live line sooner
    setTimeout(addLiveLine, 600);
  }

  async function typeLeftSequence() {
    const lines = Array.from(leftLines);
    // Brief initial pause so the terminal starts first visually
    await new Promise((r) => setTimeout(r, 300));
    for (const line of lines) {
      await typeElement(line, line.dataset.original || "", 10);
      await new Promise((r) => setTimeout(r, 40));
    }
  }

  // ── Run both sides in parallel ──
  typeTerminalSequence();
  typeLeftSequence();
</script>

<style>
  .hero {
    max-width: 1400px;
    margin: auto;
    min-height: calc(100vh - 75px);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 100px;
    padding: 120px 40px 80px;
  }

  .hero-left {
    flex: 1;
  }

  .data-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2px;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 8px 15px;
    margin-bottom: 35px;
    animation: tagIn 0.5s ease-out both;
    animation-delay: 0.15s;
  }

  @keyframes tagIn {
    from { opacity: 0; box-shadow: 0 0 0px var(--accent); }
    to   { opacity: 1; box-shadow: 0 0 12px rgba(232,120,53,0.25); }
  }

  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .tri-bar {
    width: 12px;
    height: 190px;
    display: flex;
    flex-direction: column;
    animation: triGrow 0.6s ease-out both;
    animation-delay: 0.1s;
  }

  @keyframes triGrow {
    from { opacity: 0; height: 0; }
    to   { opacity: 1; height: 190px; }
  }

  .tri-bar div { flex: 1; transform-origin: bottom; }
  .tri-bar div:nth-child(1) { background: var(--stripe-red);  animation: barGrow 0.5s ease-out both; animation-delay: 0.15s; }
  .tri-bar div:nth-child(2) { background: var(--stripe-yellow); animation: barGrow 0.5s ease-out both; animation-delay: 0.25s; }
  .tri-bar div:nth-child(3) { background: var(--stripe-teal);  animation: barGrow 0.5s ease-out both; animation-delay: 0.35s; }

  @keyframes barGrow {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(80px, 10vw, 110px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -6px;
    text-shadow: 0 0 40px rgba(0, 176, 255, 0.15);
  }

  h1 .accent { color: var(--accent); }

  /* Typewriter cursor */
  .type-line.typing::after {
    content: "_";
    color: var(--terminal-green);
    animation: blink 0.7s infinite;
    font-weight: 400;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .cassette {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 45px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .barcode {
    width: 140px;
    height: 35px;
    background: repeating-linear-gradient(
      90deg,
      white 0px,
      white 2px,
      transparent 2px,
      transparent 6px
    );
    opacity: 0;
    animation: barcodeIn 0.6s ease-out forwards;
    animation-delay: 0.4s;
  }

  @keyframes barcodeIn {
    from { opacity: 0; width: 0; }
    to   { opacity: 0.8; width: 140px; }
  }

  .description {
    margin-top: 35px;
    max-width: 620px;
    font-size: 18px;
    line-height: 1.8;
    color: #ddd;
    border-left: 3px solid var(--accent);
    padding-left: 20px;
  }

  .button {
    margin-top: 40px;
    display: inline-block;
    padding: 16px 34px;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-weight: bold;
    letter-spacing: 1px;
    transition: 0.25s;
    opacity: 0;
    animation: btnTextIn 0.5s ease-out forwards, btnBorderIn 0.3s ease-out forwards;
    animation-delay: 0.7s, 1.1s;
  }

  @keyframes btnTextIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes btnBorderIn {
    from { border-color: transparent; }
    to   { border-color: var(--accent); }
  }

  .button:hover {
    background: var(--accent);
    color: black;
  }

  /* ── Terminal HUD ── */
  .terminal {
    width: 430px;
    padding: 32px;
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid var(--accent);
    box-shadow: 0 0 30px rgba(255, 95, 31, 0.12);
    font-family: var(--font-mono);
    font-size: 13px;
    position: relative;
    opacity: 0;
    animation: termPowerOn 0.5s ease-out forwards;
    animation-delay: 0.05s;
  }

  @keyframes termPowerOn {
    from {
      opacity: 0;
      box-shadow: 0 0 0px rgba(255, 95, 31, 0);
    }
    40% {
      opacity: 1;
      box-shadow: 0 0 60px rgba(255, 95, 31, 0.3);
    }
    to {
      opacity: 1;
      box-shadow: 0 0 30px rgba(255, 95, 31, 0.12);
    }
  }

  .terminal::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 60px;
    height: 3px;
    background: var(--accent);
  }

  .terminal-header {
    padding-bottom: 18px;
    margin-bottom: 20px;
    border-bottom: 1px dashed rgba(255, 95, 31, 0.4);
    font-weight: bold;
    color: white;
    line-height: 1.8;
  }

  .terminal-header span { color: var(--accent); }

  .terminal-content {
    line-height: 2;
    color: #00ff88;
    height: 240px;
    overflow-y: hidden;
    position: relative;
  }

  /* CRT fade strips — absolutely pinned within .terminal */
  .crt-fade-top {
    position: absolute;
    top: 105px;
    left: 32px;
    right: 32px;
    height: 50px;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,1) 0%, transparent 100%);
  }
  .crt-fade-bot {
    position: absolute;
    bottom: 32px;
    left: 32px;
    right: 32px;
    height: 50px;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0,0,0,1) 0%, transparent 100%);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1s infinite;
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      padding: 60px 25px;
    }
    .terminal { width: 100%; }
  }
</style>
