---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);
const projectsPath = getLocalizedPath("/projects", language);
---

<section class="hero">
  <!-- ── Decorative background ── -->
  <div class="hero-bg" aria-hidden="true">
    <div class="orbital-ring"></div>
    <div class="orbital-ring ring-2"></div>
    <div class="grid-cross cross-tl"></div>
    <div class="grid-cross cross-tr"></div>
    <div class="grid-cross cross-bl"></div>
    <div class="grid-cross cross-br"></div>
    <div class="coords coord-top">N 51°55′ // LON 004°28′</div>
    <div class="coords coord-bot">SIGMA-09 // TELEMETRY ACTIVE</div>
  </div>

  <div class="hero-left">
    <div class="data-tag type-line">
      <span class="tag-dot"></span>
      R2S_STUDIO // DESIGN_SYSTEM_v1.0
    </div>

    <div class="title-wrapper">
      <div class="tri-bar">
        <div></div><div></div><div></div>
      </div>
      <h1>
        <span class="type-line">{t.hero.title.line1}</span>
        <br />
        <span class="type-line accent">{t.hero.title.line2}</span>
      </h1>
    </div>

    <div class="cassette">
      <div class="barcode"></div>
      <span class="type-line">{t.hero.cassette}</span>
    </div>

    <p class="description type-line">
      {t.hero.description.line1}
      <br />
      {t.hero.description.line2}
    </p>

    <a href={projectsPath} class="button type-line">
      <span class="btn-icon">&#9654;</span>
      {t.hero.button}
    </a>
  </div>

  <div class="terminal">
    <div class="telemetry-strip" aria-hidden="true">
      <span>SYS.ONLINE</span>
      <span class="tel-sep">//</span>
      <span>LINK:ESTABLISHED</span>
      <span class="tel-sep">//</span>
      <span>SIGNAL:97%</span>
    </div>
    <div class="terminal-header">
      SYS.BOOT // KERNEL_CORE_v5.5<br />
      DATA_DECK: <span>[MAGNETIC_TAPE_OPTIMIZED]</span>
    </div>
    <div class="terminal-content" id="terminal-log"></div>
    <div class="crt-fade-top"></div>
    <div class="crt-fade-bot"></div>
  </div>
</section>

<script>
  // ── Terminal boot lines ──
  const bootLines = [
    { text: "CRISP_FONT_RENDERING...", result: "STABILIZED." },
    { text: "RADAR_GRID_VECTOR_DENSITY...", result: "MAXIMIZED." },
    { text: "CONTRAST_RATIO_CORRECTION...", result: "COMPLETED." },
    { text: "", result: "" },
    { text: "COLD_BOOT:", result: "OPERATIONAL." },
    { text: "INGESTING_ROTTERDAM_FAB_DATA...", result: "ONLINE." },
    { text: "CONTRAST_ENHANCEMENT:", result: "RE-ENGAGED." },
    { text: "LOGS:", result: "ALL_CORE_STYLES_COMPILED." },
  ];

  const termEl = document.getElementById("terminal-log");
  const leftLines = document.querySelectorAll<HTMLElement>(".type-line");

  // Hide left-side text initially
  leftLines.forEach((el) => {
    el.dataset.original = el.innerHTML;
    el.innerHTML = "";
    el.style.visibility = "visible";
    el.style.opacity = "1";
  });

  // ── Typewriter engine ──
  function typeElement(
    el: HTMLElement,
    html: string,
    speed: number,
  ): Promise<void> {
    return new Promise((resolve) => {
      const temp = document.createElement("div");
      temp.innerHTML = html;
      const text = temp.textContent || "";
      let i = 0;
      el.innerHTML = "";
      el.classList.add("typing");

      const timer = setInterval(() => {
        if (i < text.length) {
          el.textContent = text.slice(0, i + 1);
          i++;
        } else {
          el.innerHTML = html;
          el.classList.remove("typing");
          clearInterval(timer);
          resolve();
        }
      }, speed);
    });
  }

  function typeTerminalLine(
    parent: HTMLElement,
    label: string,
    result: string,
    speed: number,
  ): Promise<void> {
    return new Promise((resolve) => {
      if (!label) {
        const br = document.createElement("br");
        parent.appendChild(br);
        resolve();
        return;
      }
      const div = document.createElement("div");
      div.innerHTML = `&gt; ${label} `;
      parent.appendChild(div);

      const span = document.createElement("span");
      div.appendChild(span);

      const text = `> ${label} `;
      let i = 0;
      const timer = setInterval(() => {
        if (i < text.length) {
          div.innerHTML = "";
          const typed = text.slice(0, i + 1);
          div.appendChild(document.createTextNode(typed));
          div.appendChild(span);
          i++;
        } else {
          clearInterval(timer);
          setTimeout(() => {
            span.textContent = result;
            span.style.color = "#00ff88";
            resolve();
          }, 120);
        }
      }, speed);
    });
  }

  const liveLogs = [
    { text: "ACQUIRING_PARTICLE_SIGNAL...", result: "LOCKED." },
    { text: "NEURAL_MESH_DENSITY:", result: "0.847" },
    { text: "RENDER_PIPELINE_FLUSH...", result: "OK." },
    { text: "MEMORY_HEAP_FRAGMENTATION:", result: "12%" },
    { text: "KERNEL_TIMER_SYNC...", result: "CALIBRATED." },
    { text: "BACKBUFFER_SWAP_CHAIN:", result: "VSYNC_ON." },
    { text: "THERMAL_THROTTLE_STATUS:", result: "NOMINAL." },
    { text: "FRAME_PACING_DELTA:", result: "2.1ms" },
    { text: "GPU_COMMAND_BUFFER...", result: "FLUSHED." },
    { text: "AUDIO_DSP_LATENCY_CHECK...", result: "PASSED." },
    { text: "NETWORK_SOCKET_POOL:", result: "HEALTHY." },
    { text: "SHADER_CACHE_REBUILD...", result: "DONE." },
    { text: "PHYSICS_TICK_RATE:", result: "60Hz" },
    { text: "ASSET_STREAMING_QUEUE...", result: "EMPTY." },
    { text: "INPUT_LAG_MEASUREMENT:", result: "0.8ms" },
    { text: "RAY_TRACING_BVH_UPDATE...", result: "READY." },
  ];

  async function typeTerminalSequence() {
    for (const line of bootLines) {
      await typeTerminalLine(termEl, line.text, line.result, 8);
    }
    const cursor = document.createElement("span");
    cursor.className = "cursor";
    cursor.textContent = " _";
    termEl.appendChild(cursor);

    let logIndex = 0;
    function addLiveLine() {
      const line = liveLogs[logIndex % liveLogs.length];
      cursor.remove();
      typeTerminalLine(termEl, line.text, line.result, 6).then(() => {
        termEl.appendChild(cursor);
        termEl.scrollTop = termEl.scrollHeight;
      });
      while (termEl.children.length > 20) {
        termEl.firstChild?.remove();
      }
      logIndex++;
    }

    setInterval(addLiveLine, 1200 + Math.random() * 800);
    setTimeout(addLiveLine, 600);
  }

  async function typeLeftSequence() {
    const lines = Array.from(leftLines);
    await new Promise((r) => setTimeout(r, 300));
    for (const line of lines) {
      await typeElement(line, line.dataset.original || "", 10);
      await new Promise((r) => setTimeout(r, 40));
    }
  }

  typeTerminalSequence();
  typeLeftSequence();
</script>

<style>
  .hero {
    max-width: 1400px;
    margin: auto;
    min-height: calc(100vh - 75px);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 100px;
    padding: 120px 40px 80px;
    position: relative;
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════
     DECORATIVE BACKGROUND — Cassette / NASA-punk
     ═══════════════════════════════════════════ */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Orbital rings (Lone Star style) */
  .orbital-ring {
    position: absolute;
    top: 50%;
    right: 205px;
    width: 440px;
    height: 440px;
    margin-top: -220px;
    border-radius: 50%;
    border: 1px dashed rgba(232, 160, 64, 0.25);
    animation: ringPulse 6s ease-in-out infinite;
  }
  .orbital-ring.ring-2 {
    width: 520px;
    height: 520px;
    margin-top: -260px;
    right: 165px;
    border-color: rgba(100, 200, 180, 0.16);
    border-style: dotted;
    animation-delay: 1.5s;
    transform: rotate(15deg);
  }
  @keyframes ringPulse {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }

  /* Coordinate cross markers */
  .grid-cross {
    position: absolute;
    width: 24px;
    height: 24px;
    opacity: 0.3;
  }
  .grid-cross::before,
  .grid-cross::after {
    content: "";
    position: absolute;
    background: var(--accent);
  }
  .grid-cross::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    transform: translateY(-0.5px);
  }
  .grid-cross::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-0.5px);
  }
  .cross-tl {
    top: 30px;
    left: 30px;
  }
  .cross-tr {
    top: 30px;
    right: 30px;
  }
  .cross-bl {
    bottom: 30px;
    left: 30px;
  }
  .cross-br {
    bottom: 30px;
    right: 30px;
  }

  /* Coordinate labels */
  .coords {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 1.5px;
    color: rgba(232, 160, 64, 0.4);
  }
  .coord-top {
    top: 10px;
    right: 40px;
  }
  .coord-bot {
    bottom: 10px;
    left: 40px;
  }

  /* ═══════════════════════════════════════════
     LEFT COLUMN
     ═══════════════════════════════════════════ */
  .hero-left {
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .data-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 8px 14px;
    margin-bottom: 35px;
    animation: tagIn 0.5s ease-out both;
    animation-delay: 0.15s;
    background: rgba(232, 120, 53, 0.04);
  }
  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: dotBlink 2s infinite;
  }
  @keyframes dotBlink {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 4px var(--accent);
    }
    50% {
      opacity: 0.3;
      box-shadow: 0 0 1px var(--accent);
    }
  }
  @keyframes tagIn {
    from {
      opacity: 0;
      box-shadow: 0 0 0px var(--accent);
    }
    to {
      opacity: 1;
      box-shadow: 0 0 12px rgba(232, 120, 53, 0.25);
    }
  }

  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .tri-bar {
    width: 12px;
    height: 190px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    animation: triGrow 0.6s ease-out both;
    animation-delay: 0.1s;
  }
  @keyframes triGrow {
    from {
      opacity: 0;
      height: 0;
    }
    to {
      opacity: 1;
      height: 190px;
    }
  }
  .tri-bar div {
    flex: 1;
    transform-origin: bottom;
  }
  .tri-bar div:nth-child(1) {
    background: var(--stripe-red);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.15s;
  }
  .tri-bar div:nth-child(2) {
    background: var(--stripe-yellow);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.25s;
  }
  .tri-bar div:nth-child(3) {
    background: var(--stripe-teal);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.35s;
  }
  @keyframes barGrow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(80px, 10vw, 110px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -6px;
    text-shadow: 0 0 40px rgba(0, 176, 255, 0.15);
  }
  h1 .accent {
    color: var(--accent);
  }

  /* Typewriter cursor */
  .type-line.typing::after {
    content: "_";
    color: var(--terminal-green);
    animation: blink 0.7s infinite;
    font-weight: 400;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .cassette {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 45px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .barcode {
    width: 140px;
    height: 35px;
    background: repeating-linear-gradient(
      90deg,
      #fff 0px,
      #fff 1px,
      transparent 1px,
      transparent 4px,
      #fff 4px,
      #fff 7px,
      transparent 7px,
      transparent 8px,
      #fff 8px,
      #fff 9px,
      transparent 9px,
      transparent 12px,
      #fff 12px,
      #fff 15px,
      transparent 15px,
      transparent 17px,
      #fff 17px,
      #fff 18px,
      transparent 18px,
      transparent 23px,
      #fff 23px,
      #fff 26px,
      transparent 26px,
      transparent 28px,
      #fff 28px,
      #fff 30px,
      transparent 30px,
      transparent 35px,
      #fff 35px,
      #fff 36px,
      transparent 36px,
      transparent 38px,
      #fff 38px,
      #fff 42px,
      transparent 42px,
      transparent 43px,
      #fff 43px,
      #fff 46px,
      transparent 46px,
      transparent 50px,
      #fff 50px,
      #fff 52px,
      transparent 52px,
      transparent 54px,
      #fff 54px,
      #fff 58px,
      transparent 58px,
      transparent 60px
    );
    opacity: 0;
    animation: barcodeIn 0.6s ease-out forwards;
    animation-delay: 0.4s;
  }
  @keyframes barcodeIn {
    from {
      opacity: 0;
      width: 0;
    }
    to {
      opacity: 0.8;
      width: 140px;
    }
  }

  .description {
    margin-top: 35px;
    max-width: 620px;
    font-size: 18px;
    line-height: 1.8;
    color: #ddd;
    border-left: 3px solid var(--accent);
    padding-left: 20px;
  }

  .button {
    margin-top: 40px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 34px;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-weight: bold;
    letter-spacing: 1px;
    transition: 0.25s;
    opacity: 0;
    animation:
      btnTextIn 0.5s ease-out forwards,
      btnBorderIn 0.3s ease-out forwards;
    animation-delay: 0.7s, 1.1s;
    position: relative;
    overflow: hidden;
  }
  .button::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(232, 160, 64, 0.15),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s;
  }
  .button:hover::before {
    opacity: 1;
  }

  .btn-icon {
    font-size: 10px;
    color: var(--accent);
  }
  @keyframes btnTextIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes btnBorderIn {
    from {
      border-color: transparent;
    }
    to {
      border-color: var(--accent);
    }
  }
  .button:hover {
    background: var(--accent);
    color: black;
  }
  .button:hover .btn-icon {
    color: black;
  }

  /* ═══════════════════════════════════════════
     TERMINAL HUD
     ═══════════════════════════════════════════ */
  .terminal {
    width: 430px;
    padding: 32px;
    background: rgba(5, 5, 10, 0.85);
    border: 1px solid var(--accent);
    box-shadow:
      0 0 30px rgba(255, 95, 31, 0.12),
      inset 0 0 80px rgba(232, 120, 53, 0.02);
    font-family: var(--font-mono);
    font-size: 13px;
    position: relative;
    z-index: 1;
    opacity: 0;
    animation: termPowerOn 0.5s ease-out forwards;
    animation-delay: 0.05s;
  }
  @keyframes termPowerOn {
    from {
      opacity: 0;
      box-shadow: 0 0 0px rgba(255, 95, 31, 0);
    }
    40% {
      opacity: 1;
      box-shadow: 0 0 60px rgba(255, 95, 31, 0.3);
    }
    to {
      opacity: 1;
      box-shadow: 0 0 30px rgba(255, 95, 31, 0.12);
    }
  }
  .terminal::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 60px;
    height: 3px;
    background: var(--accent);
  }
  .terminal::after {
    content: "";
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 40px;
    height: 2px;
    background: rgba(232, 160, 64, 0.5);
  }

  /* Telemetry strip above terminal header */
  .telemetry-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(255, 95, 31, 0.15);
    font-size: 9px;
    letter-spacing: 1px;
    color: rgba(232, 160, 64, 0.55);
    font-weight: 700;
  }
  .tel-sep {
    color: rgba(255, 255, 255, 0.12);
  }

  .terminal-header {
    padding-bottom: 18px;
    margin-bottom: 20px;
    border-bottom: 1px dashed rgba(255, 95, 31, 0.4);
    font-weight: bold;
    color: white;
    line-height: 1.8;
  }
  .terminal-header span {
    color: var(--accent);
  }

  .terminal-content {
    line-height: 2;
    color: #00ff88;
    height: 240px;
    overflow-y: hidden;
    position: relative;
  }

  /* CRT fade strips */
  .crt-fade-top {
    position: absolute;
    top: 165px;
    left: 32px;
    right: 32px;
    height: 50px;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(5, 5, 10, 1) 0%,
      transparent 100%
    );
  }
  .crt-fade-bot {
    position: absolute;
    bottom: 38px;
    left: 32px;
    right: 32px;
    height: 90px;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to top, rgba(5, 5, 10, 1) 0%, transparent 100%);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1s infinite;
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      padding: 60px 25px;
    }
    .terminal {
      width: 100%;
    }
    .hero-bg {
      display: none;
    }
  }
</style>
