---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);
const projectsPath = getLocalizedPath("/projects", language);
---

<section class="hero">
  <!-- ── Decorative background ── -->
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-cross cross-tl" data-plx="6"></div>
    <div class="grid-cross cross-tr" data-plx="10"></div>
    <div class="grid-cross cross-bl" data-plx="8"></div>
    <div class="grid-cross cross-br" data-plx="12"></div>
    <div class="coords coord-top" data-plx="5">N 51°55′ // LON 004°28′</div>
    <div class="coords coord-bot" data-plx="7">SIGMA-09 // TELEMETRY ACTIVE</div>
    <div class="radar" data-plx="9"></div>
  </div>

  <div class="hero-left">
    <div class="data-tag type-line">
      <span class="tag-dot"></span>
      RrS_STUDIO // DESIGN_SYSTEM_v1.0
    </div>

    <div class="title-wrapper">
      <div class="tri-bar">
        <div></div><div></div><div></div>
      </div>
      <h1>
        <span class="type-line">{t.hero.title.line1}</span>
        <br />
        <span class="type-line accent">{t.hero.title.line2}</span>
      </h1>
    </div>

    <div class="cassette">
      <div class="barcode"></div>
      <span class="type-line">{t.hero.cassette}</span>
    </div>

    <p class="description type-line">
      {t.hero.description.line1}
      <br />
      {t.hero.description.line2}
    </p>

    <a href={projectsPath} class="button type-line">
      <span class="btn-icon">&#9654;</span>
      {t.hero.button}
    </a>
  </div>

  <!-- ── Cassette deck (A1) — SYS.BOOT terminal restored as the tape window (B2) ── -->
  <div class="cassette-deck" data-hero-deck>
    <div class="telemetry-strip" aria-hidden="true">
      <span>SYS.ONLINE</span>
      <span class="tel-sep">//</span>
      <span>LINK:ESTABLISHED</span>
      <span class="tel-sep">//</span>
      <span>SIGNAL:97%</span>
    </div>

    <div class="deck-shell">
      <span class="screw screw-tl" aria-hidden="true"></span>
      <span class="screw screw-tr" aria-hidden="true"></span>
      <span class="screw screw-bl" aria-hidden="true"></span>
      <span class="screw screw-br" aria-hidden="true"></span>

      <div class="deck-top">
        <span class="deck-title">RrS_STUDIO // DATA_DECK_v5.5</span>
        <span class="side-tag">SIDE_A</span>
      </div>

      <div class="deck-body">
        <div class="reel-unit">
          <div class="reel idle-spin" aria-hidden="true">
            <div class="reel-scroll">
              <div class="reel-face"></div>
            </div>
          </div>
          <span class="reel-cap">SPOOL_A</span>
        </div>

        <div class="terminal tape-window">
          <div class="terminal-header">
            SYS.BOOT // KERNEL_CORE_v5.5<br />
            DATA_DECK: <span>[MAGNETIC_TAPE_OPTIMIZED]</span>
          </div>
          <div class="terminal-content" id="terminal-log"></div>
          <div class="crt-fade-top"></div>
          <div class="crt-fade-bot"></div>
        </div>

        <div class="reel-unit">
          <div class="reel idle-spin" aria-hidden="true">
            <div class="reel-scroll">
              <div class="reel-face"></div>
            </div>
          </div>
          <span class="reel-cap">SPOOL_B</span>
        </div>
      </div>

      <div class="deck-controls">
        <button class="deck-btn" type="button" data-cmd="rew" aria-label="Rewind">
          <span class="btn-sym">&#9198;</span> REW
        </button>
        <button class="deck-btn play-btn" type="button" data-cmd="play" aria-label="Play or pause">
          <span class="btn-sym play-sym">&#9654;</span> PLAY
        </button>
        <button class="deck-btn" type="button" data-cmd="ff" aria-label="Fast forward">
          FF <span class="btn-sym">&#9197;</span>
        </button>
        <div class="counter-window">
          <span id="deck-counter">000</span>
          <span class="counter-unit">TAPE_CNT</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ── Terminal boot lines ──
  const bootLines = [
    { text: "CRISP_FONT_RENDERING...", result: "STABILIZED." },
    { text: "RADAR_GRID_VECTOR_DENSITY...", result: "MAXIMIZED." },
    { text: "CONTRAST_RATIO_CORRECTION...", result: "COMPLETED." },
    { text: "", result: "" },
    { text: "COLD_BOOT:", result: "OPERATIONAL." },
    { text: "INGESTING_ROTTERDAM_FAB_DATA...", result: "ONLINE." },
    { text: "CONTRAST_ENHANCEMENT:", result: "RE-ENGAGED." },
    { text: "LOGS:", result: "ALL_CORE_STYLES_COMPILED." },
  ];

  const termEl = document.getElementById("terminal-log");
  const leftLines = document.querySelectorAll<HTMLElement>(".type-line");

  // Hide left-side text initially
  leftLines.forEach((el) => {
    el.dataset.original = el.innerHTML;
    el.innerHTML = "";
    el.style.visibility = "visible";
    el.style.opacity = "1";
  });

  // ── Typewriter engine ──
  function typeElement(
    el: HTMLElement,
    html: string,
    speed: number,
  ): Promise<void> {
    return new Promise((resolve) => {
      const temp = document.createElement("div");
      temp.innerHTML = html;
      const text = temp.textContent || "";
      let i = 0;
      el.innerHTML = "";
      el.classList.add("typing");

      const timer = setInterval(() => {
        if (i < text.length) {
          el.textContent = text.slice(0, i + 1);
          i++;
        } else {
          el.innerHTML = html;
          el.classList.remove("typing");
          clearInterval(timer);
          resolve();
        }
      }, speed);
    });
  }

  function typeTerminalLine(
    parent: HTMLElement,
    label: string,
    result: string,
    speed: number,
  ): Promise<void> {
    return new Promise((resolve) => {
      if (!label) {
        const br = document.createElement("br");
        parent.appendChild(br);
        resolve();
        return;
      }
      const div = document.createElement("div");
      div.innerHTML = `&gt; ${label} `;
      parent.appendChild(div);

      const span = document.createElement("span");
      div.appendChild(span);

      const text = `> ${label} `;
      let i = 0;
      const timer = setInterval(() => {
        if (i < text.length) {
          div.innerHTML = "";
          const typed = text.slice(0, i + 1);
          div.appendChild(document.createTextNode(typed));
          div.appendChild(span);
          i++;
        } else {
          clearInterval(timer);
          setTimeout(() => {
            span.textContent = result;
            span.style.color = "var(--terminal-green)";
            resolve();
          }, 120);
        }
      }, speed);
    });
  }

  const liveLogs = [
    { text: "ACQUIRING_PARTICLE_SIGNAL...", result: "LOCKED." },
    { text: "NEURAL_MESH_DENSITY:", result: "0.847" },
    { text: "RENDER_PIPELINE_FLUSH...", result: "OK." },
    { text: "MEMORY_HEAP_FRAGMENTATION:", result: "12%" },
    { text: "KERNEL_TIMER_SYNC...", result: "CALIBRATED." },
    { text: "BACKBUFFER_SWAP_CHAIN:", result: "VSYNC_ON." },
    { text: "THERMAL_THROTTLE_STATUS:", result: "NOMINAL." },
    { text: "FRAME_PACING_DELTA:", result: "2.1ms" },
    { text: "GPU_COMMAND_BUFFER...", result: "FLUSHED." },
    { text: "AUDIO_DSP_LATENCY_CHECK...", result: "PASSED." },
    { text: "NETWORK_SOCKET_POOL:", result: "HEALTHY." },
    { text: "SHADER_CACHE_REBUILD...", result: "DONE." },
    { text: "PHYSICS_TICK_RATE:", result: "60Hz" },
    { text: "ASSET_STREAMING_QUEUE...", result: "EMPTY." },
    { text: "INPUT_LAG_MEASUREMENT:", result: "0.8ms" },
    { text: "RAY_TRACING_BVH_UPDATE...", result: "READY." },
  ];

  async function typeTerminalSequence() {
    if (!termEl) return;
    for (const line of bootLines) {
      await typeTerminalLine(termEl, line.text, line.result, 8);
    }
    const cursor = document.createElement("span");
    cursor.className = "cursor";
    cursor.textContent = " _";
    termEl.appendChild(cursor);

    let logIndex = 0;
    function addLiveLine() {
      const line = liveLogs[logIndex % liveLogs.length];
      cursor.remove();
      if (!termEl) return;
      typeTerminalLine(termEl, line.text, line.result, 6).then(() => {
        if (!termEl) return;
        termEl.appendChild(cursor);
        termEl.scrollTop = termEl.scrollHeight;
      });
      while (termEl.children.length > 14) {
        termEl.firstChild?.remove();
      }
      logIndex++;
    }

    setInterval(addLiveLine, 1200 + Math.random() * 800);
    setTimeout(addLiveLine, 600);
  }

  async function typeLeftSequence() {
    const lines = Array.from(leftLines);
    await new Promise((r) => setTimeout(r, 300));
    for (const line of lines) {
      await typeElement(line, line.dataset.original || "", 10);
      await new Promise((r) => setTimeout(r, 40));
    }
  }

  typeTerminalSequence();
  typeLeftSequence();

  // ── Reels + tape counter driven by scroll (B1) ──
  const deck = document.querySelector<HTMLElement>("[data-hero-deck]");
  const reelScrolls = deck?.querySelectorAll<HTMLElement>(".reel-scroll");
  const counterEl = document.getElementById("deck-counter");

  function updateReels() {
    const delta = window.scrollY * 0.6;
    const deg = delta % 360;
    reelScrolls?.forEach((r) => {
      r.style.transform = `rotate(${deg}deg)`;
    });
    if (counterEl) {
      const v = Math.abs(Math.floor(delta / 3.6)) % 1000;
      counterEl.textContent = String(v).padStart(3, "0");
    }
  }

  window.addEventListener("scroll", updateReels, { passive: true });
  updateReels();

  // ── Deck transport buttons (PLAY/REW/FF) + synthesized sound ──
  deck?.querySelectorAll<HTMLButtonElement>(".deck-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const snd = window.__r2sSnd;
      const cmd = btn.dataset.cmd;

      if (cmd === "play") {
        const paused = deck.classList.toggle("paused");
        btn.classList.toggle("engaged", !paused);
        const sym = btn.querySelector(".play-sym");
        if (sym) sym.innerHTML = paused ? "&#9654;" : "&#10074;&#10074;";
        if (paused) snd?.load(); else snd?.play();
        if (!paused && termEl) termEl.scrollTop = termEl.scrollHeight;
      } else if (cmd === "rew") {
        snd?.rewind();
        deck.classList.add("rewinding");
        let n = 0;
        const tick = setInterval(() => {
          if (!counterEl) return;
          counterEl.textContent = String(
            (Number(counterEl.textContent) + 997) % 1000,
          ).padStart(3, "0");
          if (++n > 24) clearInterval(tick);
        }, 24);
        setTimeout(() => deck.classList.remove("rewinding"), 700);
      } else if (cmd === "ff") {
        snd?.click();
        let n = 0;
        const tick = setInterval(() => {
          if (!counterEl) return;
          counterEl.textContent = String(
            (Number(counterEl.textContent) + 1) % 1000,
          ).padStart(3, "0");
          if (++n > 12) clearInterval(tick);
        }, 34);
      }
    });
  });

  // ── Mouse parallax on hero decoration (B3) ──
  if (
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    window.matchMedia("(pointer: fine)").matches
  ) {
    const hero = document.querySelector<HTMLElement>(".hero");
    const layers = hero?.querySelectorAll<HTMLElement>("[data-plx]");
    let mx = 0;
    let my = 0;
    let raf = 0;

    hero?.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      mx = (e.clientX - rect.left) / rect.width - 0.5;
      my = (e.clientY - rect.top) / rect.height - 0.5;

      if (!raf) {
        raf = requestAnimationFrame(() => {
          raf = 0;
          layers?.forEach((el) => {
            const f = parseFloat(el.dataset.plx || "0");
            el.style.transform = `translate(${mx * f}px, ${my * f}px)`;
          });
        });
      }
    });
  }
</script>

<style>
  .hero {
    max-width: var(--container-wide);
    margin: auto;
    min-height: calc(100vh - 75px);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 60px;
    padding: 15px 40px 80px;
    position: relative;
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════
     DECORATIVE BACKGROUND — Cassette / NASA-punk
     ═══════════════════════════════════════════ */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Coordinate cross markers */
  .grid-cross {
    position: absolute;
    width: 24px;
    height: 24px;
    opacity: 0.3;
  }
  .grid-cross::before,
  .grid-cross::after {
    content: "";
    position: absolute;
    background: var(--accent);
  }
  .grid-cross::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    transform: translateY(-0.5px);
  }
  .grid-cross::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-0.5px);
  }
  .cross-tl {
    top: 90px;
    left: 30px;
  }
  .cross-tr {
    top: 90px;
    right: 30px;
  }
  .cross-bl {
    bottom: 30px;
    left: 30px;
  }
  .cross-br {
    bottom: 30px;
    right: 30px;
  }

  /* Coordinate labels */
  .coords {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--text-scale-5xs);
    letter-spacing: var(--tracking-wider);
    color: rgba(232, 160, 64, 0.4);
  }
  .coord-top {
    top: 10px;
    right: 40px;
  }
  .coord-bot {
    bottom: 10px;
    left: 40px;
  }

  /* Radar sweep (B6) — Arknights-style slow instrument scan */
  .radar {
    position: absolute;
    top: 90px;
    left: 56%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    border: 1px solid rgba(232, 148, 58, 0.14);
    opacity: 0.5;
    pointer-events: none;
    overflow: hidden;
  }
  .radar::before,
  .radar::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(232, 148, 58, 0.1);
  }
  .radar::before {
    inset: 30%;
  }
  .radar::after {
    inset: 60%;
  }
  .radar::before,
  .radar::after {
    pointer-events: none;
  }
  .radar {
    background:
      linear-gradient(
        rgba(232, 148, 58, 0.05),
        rgba(232, 148, 58, 0.05)
      )
      center / 100% 1px no-repeat,
      linear-gradient(
        rgba(232, 148, 58, 0.05),
        rgba(232, 148, 58, 0.05)
      )
      center / 1px 100% no-repeat,
      conic-gradient(
        from 0deg,
        rgba(232, 148, 58, 0.28) 0deg,
        transparent 38deg,
        transparent 360deg
      );
    animation: radarSpin 9s linear infinite;
  }
  @keyframes radarSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ═══════════════════════════════════════════
     LEFT COLUMN
     ═══════════════════════════════════════════ */
  .hero-left {
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .data-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-scale-4xs);
    font-weight: 900;
    letter-spacing: var(--tracking-tag);
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 8px 14px;
    margin-bottom: 35px;
    animation: tagIn 0.5s ease-out both;
    animation-delay: 0.15s;
    background: rgba(232, 120, 53, 0.04);
  }
  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: dotBlink 2s infinite;
  }
  @keyframes dotBlink {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 4px var(--accent);
    }
    50% {
      opacity: 0.3;
      box-shadow: 0 0 1px var(--accent);
    }
  }
  @keyframes tagIn {
    from {
      opacity: 0;
      box-shadow: 0 0 0px var(--accent);
    }
    to {
      opacity: 1;
      box-shadow: 0 0 12px rgba(232, 120, 53, 0.25);
    }
  }

  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .tri-bar {
    width: 12px;
    height: 190px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    animation: triGrow 0.6s ease-out both;
    animation-delay: 0.1s;
  }
  @keyframes triGrow {
    from {
      opacity: 0;
      height: 0;
    }
    to {
      opacity: 1;
      height: 190px;
    }
  }
  .tri-bar div {
    flex: 1;
    /* clip-path avoids nested transform compositing issues —
       <main> has a pageIn animation with translateY which
       creates a compositing layer; using clip-path here keeps
       the bars on the paint layer so they don't vanish */
  }
  .tri-bar div:nth-child(1) {
    background: var(--stripe-red);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.15s;
  }
  .tri-bar div:nth-child(2) {
    background: var(--stripe-yellow);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.25s;
  }
  .tri-bar div:nth-child(3) {
    background: var(--stripe-teal);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.35s;
  }
  @keyframes barGrow {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-scale-hero);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: var(--tracking-hero);
    min-height: 1.8em;
  }
  h1 .accent {
    color: var(--accent);
  }

  /* Typewriter cursor */
  .type-line.typing::after {
    content: "_";
    color: var(--terminal-green);
    animation: blink 0.7s infinite;
    font-weight: 400;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .cassette {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 45px;
    font-family: var(--font-mono);
    font-size: var(--text-scale-2xs);
    color: var(--accent);
  }

  .barcode {
    width: 140px;
    height: 35px;
    background: repeating-linear-gradient(
      90deg,
      #fff 0px,
      #fff 1px,
      transparent 1px,
      transparent 4px,
      #fff 4px,
      #fff 7px,
      transparent 7px,
      transparent 8px,
      #fff 8px,
      #fff 9px,
      transparent 9px,
      transparent 12px,
      #fff 12px,
      #fff 15px,
      transparent 15px,
      transparent 17px,
      #fff 17px,
      #fff 18px,
      transparent 18px,
      transparent 23px,
      #fff 23px,
      #fff 26px,
      transparent 26px,
      transparent 28px,
      #fff 28px,
      #fff 30px,
      transparent 30px,
      transparent 35px,
      #fff 35px,
      #fff 36px,
      transparent 36px,
      transparent 38px,
      #fff 38px,
      #fff 42px,
      transparent 42px,
      transparent 43px,
      #fff 43px,
      #fff 46px,
      transparent 46px,
      transparent 50px,
      #fff 50px,
      #fff 52px,
      transparent 52px,
      transparent 54px,
      #fff 54px,
      #fff 58px,
      transparent 58px,
      transparent 60px
    );
    opacity: 0;
    animation: barcodeIn 0.6s ease-out forwards;
    animation-delay: 0.4s;
  }
  @keyframes barcodeIn {
    from {
      opacity: 0;
      width: 0;
    }
    to {
      opacity: 0.8;
      width: 140px;
    }
  }

  .description {
    margin-top: 35px;
    max-width: 620px;
    font-size: var(--text-scale-body);
    line-height: 1.8;
    color: var(--text-soft);
    border-left: 3px solid var(--accent);
    padding-left: 20px;
    min-height: 3.6em;
  }

  .button {
    margin-top: 40px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 34px;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-weight: bold;
    letter-spacing: var(--tracking-label);
    transition:
      background 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      transform 0.2s var(--spring-snappy),
      border-color 0.35s var(--ease-out);
    opacity: 0;
    animation:
      btnTextIn 0.5s ease-out forwards,
      btnBorderIn 0.3s ease-out forwards;
    animation-delay: 0.7s, 1.1s;
    position: relative;
    overflow: hidden;
  }

  .button:active {
    transform: scale(0.94);
    transition: transform 0.08s var(--spring-snappy);
  }
  .button::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(232, 160, 64, 0.15),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s;
  }
  .button:hover::before {
    opacity: 1;
  }

  .btn-icon {
    font-size: var(--text-scale-4xs);
    color: var(--accent);
  }
  @keyframes btnTextIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes btnBorderIn {
    from {
      border-color: transparent;
    }
    to {
      border-color: var(--accent);
    }
  }
  .button:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .button:hover .btn-icon {
    color: var(--on-accent);
  }

  /* ═══════════════════════════════════════════
     CASSETTE DECK (A1) — right module
     ═══════════════════════════════════════════ */
  .cassette-deck {
    width: 440px;
    flex-shrink: 0;
    margin-top: 60px;
    position: relative;
    z-index: 1;
    opacity: 0;
