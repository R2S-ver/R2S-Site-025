---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const aboutPath = getLocalizedPath("/about", language);
---

<section class="about-preview">
  <div class="panel">
    <div class="header">
      {t.aboutPreview.header}
    </div>

    <div class="content">
      <div class="id-block">
        <div class="label">
          {t.aboutPreview.operator}
        </div>

        <h2>R2S Studio</h2>

        <div class="status">
          {t.aboutPreview.status}
        </div>
      </div>

      <div class="description">
        <p>
          {t.aboutPreview.description.line1}
        </p>

        <p>
          {t.aboutPreview.description.line2}
        </p>
      </div>
    </div>

    <div class="footer">
      <span>
        {t.aboutPreview.location}
      </span>

      <span>
        {t.aboutPreview.field}
      </span>

      <a href={aboutPath}>
        {t.aboutPreview.access}
      </a>
    </div>
  </div>
</section>

<style>
  .about-preview {
    margin: 0 auto 120px;

    font-family: var(--font-mono);
  }

  .panel {
    max-width: 1320px;

    width: calc(100% - 80px);

    margin: 0 auto;

    background: rgba(8, 8, 12, 0.9);

    border: 1px solid var(--border);

    border-radius: 6px;

    position: relative;

    overflow: hidden;
  }

  @media (max-width: 800px) {
    .panel { max-width: none; margin: 0 16px; }
  }

  .panel::before {
    content: "";

    position: absolute;

    right: 0;

    top: 0;

    width: 60px;

    height: 60px;

    background: var(--stripe-yellow);

    clip-path: polygon(100% 0, 100% 100%, 0 0);
  }

  .header {
    padding: 18px 25px;

    border-bottom: 1px dashed var(--border);

    font-size: 11px;

    letter-spacing: 2px;

    color: var(--accent);
  }

  .content {
    display: flex;

    gap: 80px;

    padding: 50px;

    align-items: center;
  }

  .id-block {
    min-width: 300px;

    border-right: 1px solid var(--border);
  }

  .label {
    font-size: 11px;

    color: #777;

    margin-bottom: 15px;
  }

  h2 {
    font-size: 48px;

    line-height: 1;

    font-weight: 900;

    color: white;

    margin-bottom: 20px;

    letter-spacing: -2px;
  }

  .status {
    font-size: 11px;

    color: var(--terminal-green);

    font-weight: bold;
  }

  .description {
    max-width: 600px;
  }

  .description p {
    color: #bbb;

    font-size: 15px;

    line-height: 1.9;

    margin-bottom: 20px;
  }

  .description strong {
    color: white;
  }

  .footer {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 20px 25px;

    border-top: 1px solid var(--border);

    font-size: 11px;

    color: #888;
  }

  .footer a {
    color: var(--terminal-green);

    font-weight: bold;

    transition:
      color 0.2s var(--ease-out),
      transform 0.2s var(--spring-snappy);
  }

  .footer a:hover {
    color: var(--accent);
  }

  .footer a:active {
    transform: scale(0.93);
    transition: transform 0.08s var(--spring-snappy);
  }

  @media (max-width: 900px) {
    .content {
      flex-direction: column;

      gap: 30px;

      padding: 35px;

      align-items: flex-start;
    }

    .id-block {
      border-right: none;

      border-bottom: 1px solid var(--border);

      padding-bottom: 25px;

      width: 100%;
    }

    .footer {
      flex-direction: column;

      align-items: flex-start;

      gap: 15px;
    }

    h2 {
      font-size: 38px;
    }
  }

  :root[data-theme="light"] .about-preview .panel {
    background: #e8e3da;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.06), 0 1px 0 rgba(255,255,255,0.6);
  }
  :root[data-theme="light"] .about-preview .header { color: #444; }
  :root[data-theme="light"] .about-preview h2 { color: #1a1a1a; }
  :root[data-theme="light"] .about-preview .description p { color: #555; }
  :root[data-theme="light"] .about-preview .label { color: #777; }
  :root[data-theme="light"] .about-preview .status { color: #00703c; }
  :root[data-theme="light"] .about-preview .footer a { color: #00703c; }
  :root[data-theme="light"] .about-preview .footer { color: #555; }
</style>
