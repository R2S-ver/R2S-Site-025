---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const aboutPath = getLocalizedPath("/about", language);
---

<section class="about-preview">
  <div class="panel" data-reveal>
    <div class="header">
      {t.aboutPreview.header}
    </div>

    <div class="content">
      <div class="id-block">
        <div class="label">
          {t.aboutPreview.operator}
        </div>

        <h2>RrSuika</h2>

        <div class="status">
          {t.aboutPreview.status}
        </div>
      </div>

      <div class="description">
        <p>
          {t.aboutPreview.description.line1}
        </p>

        <p>
          {t.aboutPreview.description.line2}
        </p>
      </div>
    </div>

    <div class="footer">
      <span>
        {t.aboutPreview.location}
      </span>

      <span>
        {t.aboutPreview.field}
      </span>

      <a href={aboutPath}>
        {t.aboutPreview.access}
      </a>
    </div>
  </div>
</section>

<style>
  .about-preview {
    margin: 0 auto var(--section-gap);

    font-family: var(--font-mono);
  }

  .panel {
    max-width: var(--container-main);

    width: calc(100% - 80px);

    margin: 0 auto;

    background: var(--surface-deep);

    border: 1px solid var(--border);

    border-radius: var(--radius-md);

    position: relative;

    overflow: hidden;
  }

  @media (max-width: 800px) {
    .panel { max-width: none; margin: 0 16px; }
  }

  .header {
    padding: 18px 25px;

    border-bottom: 1px dashed var(--border);

    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-tag);

    color: var(--accent);
  }

  .content {
    display: flex;

    gap: 80px;

    padding: 50px;

    align-items: center;
  }

  .id-block {
    min-width: 300px;

    border-right: 1px solid var(--border);
  }

  .label {
    font-size: var(--text-scale-3xs);

    color: #9a9a9a;

    margin-bottom: 15px;
  }

  h2 {
    font-size: var(--text-scale-h2);

    line-height: 1;

    font-weight: 900;

    color: var(--text-bright);

    margin-bottom: 20px;

    letter-spacing: var(--tracking-tight);
  }

  .status {
    font-size: var(--text-scale-3xs);

    color: var(--terminal-green);

    font-weight: bold;
  }

  .description {
    max-width: 600px;
  }

  .description p {
    color: #c8c8c8;

    font-size: var(--text-scale-sm);

    line-height: 1.9;

    margin-bottom: 20px;
  }

  .description strong {
    color: var(--text-bright);
  }

  .footer {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 20px 25px;

    border-top: 1px solid var(--border);

    font-size: var(--text-scale-3xs);

    color: #9a9a9a;
  }

  .footer a {
    color: var(--terminal-green);

    font-weight: bold;

    transition:
      color 0.2s var(--ease-out),
      transform 0.2s var(--spring-snappy);
  }

  .footer a:hover {
    color: var(--accent);
  }

  .footer a:active {
    transform: scale(0.93);
    transition: transform 0.08s var(--spring-snappy);
  }

  @media (max-width: 900px) {
    .content {
      flex-direction: column;

      gap: 30px;

      padding: 35px;

      align-items: flex-start;
    }

    .id-block {
      border-right: none;

      border-bottom: 1px solid var(--border);

      padding-bottom: 25px;

      width: 100%;
    }

    .footer {
      flex-direction: column;

      align-items: flex-start;

      gap: 15px;
    }

    h2 {
      font-size: 38px;
    }
  }

  :root[data-theme="light"] .about-preview .panel {
    background: var(--paper);
    box-shadow: var(--shadow-paper);
  }
  :root[data-theme="light"] .about-preview .header { color: #333; }
  :root[data-theme="light"] .about-preview h2 { color: var(--text-bright); }
  :root[data-theme="light"] .about-preview .description p { color: #404040; }
  :root[data-theme="light"] .about-preview .label { color: var(--text-dim); }
  :root[data-theme="light"] .about-preview .status { color: #00703c; }
  :root[data-theme="light"] .about-preview .footer a { color: #00703c; }
  :root[data-theme="light"] .about-preview .footer { color: var(--text-soft); }
</style>
