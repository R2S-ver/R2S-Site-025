---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const { entries = [] } = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const routeMap = {
  work: "projects",
  lab: "lab",
  art: "art",
  note: "notes",
};
---

<section class="latest">
  <div class="panel">
    <div class="header">
      {t.latest.header}
    </div>

    <div class="logs">
      {
        entries.map((entry, index) => {
          const route = routeMap[entry.data.type];

          const basePath = getLocalizedPath(`/${route}`, language);

          const date = entry.data.date.toLocaleDateString(
            language === "zh" ? "zh-CN" : "en-US",
            {
              year: "numeric",
              month: "short",
            },
          );

          return (
            <a href={`${basePath}/${entry.id}`} class="log">
              <div class="log-left">
                <div class="entry">
                  ENTRY_{String(index + 1).padStart(3, "0")}
                </div>

                <h3>{entry.data.title}</h3>

                <p>{entry.data.description}</p>
              </div>

              <div class="meta">
                <span>
                  {t.latest.type}
                  {entry.data.type.toUpperCase()}
                </span>

                <span>{date}</span>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="footer">
      &gt; DATABASE_STATUS:

      <span>
        {t.latest.updated}
      </span>
    </div>
  </div>
</section>

<style>
  .latest {
    max-width: 1400px;

    margin: 0 auto 120px;

    padding: 0 40px;

    font-family: var(--font-mono);
  }

  .panel {
    background: rgba(8, 8, 12, 0.9);

    border: 1px solid var(--border);
  }

  .header {
    padding: 18px 25px;

    border-bottom: 1px dashed var(--border);

    font-size: 11px;

    letter-spacing: 2px;

    color: var(--accent);
  }

  .logs {
    display: flex;

    flex-direction: column;
  }

  .log {
    display: flex;

    justify-content: space-between;

    gap: 40px;

    padding: 25px;

    border-bottom: 1px solid var(--border);

    text-decoration: none;

    color: white;

    transition: 0.25s;

    position: relative;
  }

  .log::before {
    content: "";

    position: absolute;

    left: 0;

    top: 0;

    height: 100%;

    width: 4px;

    background: transparent;

    transition: 0.25s;
  }

  .log:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .log:hover::before {
    background: var(--accent);
  }

  .entry {
    font-size: 10px;

    color: var(--terminal-green);

    letter-spacing: 2px;

    margin-bottom: 10px;
  }

  .log h3 {
    font-size: 22px;

    margin-bottom: 8px;

    font-weight: 900;
  }

  .log p {
    font-size: 12px;

    color: #999;

    max-width: 700px;

    line-height: 1.7;
  }

  .meta {
    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-end;

    gap: 10px;

    font-size: 11px;

    color: #777;

    white-space: nowrap;
  }

  .footer {
    padding: 18px 25px;

    font-size: 11px;

    color: #777;
  }

  .footer span {
    color: var(--terminal-green);

    font-weight: bold;
  }

  @media (max-width: 800px) {
    .latest {
      padding: 0 20px;
    }

    .log {
      flex-direction: column;

      gap: 20px;
    }

    .meta {
      align-items: flex-start;
    }
  }
</style>
