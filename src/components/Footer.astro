---
import { getLanguageFromPath, getLocalizedPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const aboutPath = getLocalizedPath("/about", language);
---

<footer class="footer">
  <div class="footer-line">
    <div class="tri-color">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="system">
      {t.footer.system}
    </div>

    <div class="status">
      {t.footer.status}
      <span>{t.footer.online}</span>
    </div>
  </div>

  <div class="footer-main">
    <div class="identity">
      <h3>R2S_STUDIO</h3>

      <p>
        {t.footer.identity}
      </p>

      <div class="meta">
        <div>
          <span class="meta-label">{t.footer.location}</span>
          <strong> ROTTERDAM // NL </strong>
        </div>

        <div>
          <span class="meta-label">{t.footer.statusLabel}</span>
          <strong class="green">
            {t.footer.operational}
          </strong>
        </div>

        <div>
          <span class="meta-label">{t.footer.version}</span>
          <strong> 2026.V5.5 </strong>
        </div>
      </div>
    </div>

    <div class="links">
      <div class="title">
        {t.footer.uplink}
      </div>

      <a
        href="https://github.com/R2S-ver"
        target="_blank"
        rel="noopener noreferrer"
      >
        &gt; {t.footer.github}
      </a>

      <a href="mailto:ranrsuika@gmail.com">
        &gt; {t.footer.email}
      </a>

      <div class="qq">&gt; QQ: 2385568240</div>

      <a href={aboutPath}>
        &gt; {t.footer.about}
      </a>
    </div>

    <div class="barcode"></div>
  </div>

  <div class="copyright">
    <span>
      © {new Date().getFullYear()} R2S Studio
    </span>

    <span>
      {t.footer.copyright}
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;

    border-top: 1px solid var(--border);

    background: rgba(5, 5, 7, 0.8);

    font-family: var(--font-mono);

    color: #aaa;

    transition: background 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }

  :root[data-theme="light"] .footer {
    background: #e8e3da;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.06), 0 1px 0 rgba(255,255,255,0.6);
    color: #555;
  }
  :root[data-theme="light"] .footer .system { color: #8b4513; }
  :root[data-theme="light"] .footer .identity h3 { color: #1a1a1a; }
  :root[data-theme="light"] .footer .identity p { color: #555; }
  :root[data-theme="light"] .footer .links a { color: #555; }
  :root[data-theme="light"] .footer .links a:hover { color: var(--accent); }
  :root[data-theme="light"] .footer .qq { color: #555; }
  :root[data-theme="light"] .footer .qq:hover { color: var(--accent); }
  :root[data-theme="light"] .footer .copyright { color: #888; }
  :root[data-theme="light"] .footer .meta strong { color: #333; }
  :root[data-theme="light"] .footer .green { color: #00703c !important; }
  :root[data-theme="light"] .footer .barcode {
    filter: invert(1);
    opacity: 0.2;
  }

  .footer-line {
    height: 70px;

    border-bottom: 1px solid var(--border);

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 40px;

    font-size: 11px;

    letter-spacing: 1px;
  }

  .tri-color {
    display: flex;

    width: 90px;

    height: 8px;
  }

  .tri-color span {
    flex: 1;
  }

  .tri-color span:nth-child(1) {
    background: var(--stripe-red);
  }

  .tri-color span:nth-child(2) {
    background: var(--stripe-yellow);
  }

  .tri-color span:nth-child(3) {
    background: var(--stripe-teal);
  }

  .system {
    color: var(--accent);

    font-weight: bold;
  }

  .status span {
    color: var(--terminal-green);

    font-weight: bold;
  }

  .footer-main {
    position: relative;

    max-width: 1400px;

    margin: auto;

    padding: 60px 40px;

    display: flex;

    justify-content: space-between;

    gap: 60px;
  }

  .identity h3 {
    font-size: 32px;

    font-weight: 900;

    letter-spacing: -1px;

    color: var(--text);

    margin-bottom: 12px;
  }

  .identity p {
    font-size: 13px;

    color: #888;
  }

  .meta {
    margin-top: 30px;

    display: flex;

    flex-direction: column;

    gap: 10px;

    font-size: 12px;
  }

  .meta > div {
    display: grid;
    grid-template-columns: 10ch 1fr;
  }

  .meta-label {
    text-align: right;
    padding-right: 0.5ch;
  }

  .meta strong {
    color: var(--text);
  }

  .green {
    color: var(--terminal-green) !important;
  }

  .links {
    display: flex;

    flex-direction: column;

    gap: 15px;

    min-width: 180px;
  }

  .links .title {
    color: var(--accent);

    font-size: 12px;

    font-weight: bold;

    margin-bottom: 10px;
  }

  .links a {
    color: #ccc;

    font-size: 13px;

    transition:
      color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .links a:hover {
    color: var(--accent);

    transform: translateX(5px);
  }

  .links a:active {
    transform: scale(0.95);
  }

  .qq {
    color: #ccc;

    font-size: 13px;

    transition: color 0.2s var(--ease-out);
  }

  .qq:hover {
    color: var(--accent);
  }

  .barcode {
    position: absolute;

    right: 42px;

    bottom: 15px;

    width: 125px;

    height: 45px;

    opacity: 0.3;

    background: repeating-linear-gradient(
      90deg,
      #fff 0px,
      #fff 1px,
      transparent 1px,
      transparent 4px,
      #fff 4px,
      #fff 7px,
      transparent 7px,
      transparent 8px,
      #fff 8px,
      #fff 9px,
      transparent 9px,
      transparent 12px,
      #fff 12px,
      #fff 15px,
      transparent 15px,
      transparent 17px,
      #fff 17px,
      #fff 18px,
      transparent 18px,
      transparent 23px,
      #fff 23px,
      #fff 26px,
      transparent 26px,
      transparent 28px,
      #fff 28px,
      #fff 30px,
      transparent 30px,
      transparent 35px,
      #fff 35px,
      #fff 36px,
      transparent 36px,
      transparent 38px,
      #fff 38px,
      #fff 42px,
      transparent 42px,
      transparent 43px,
      #fff 43px,
      #fff 46px,
      transparent 46px,
      transparent 50px,
      #fff 50px,
      #fff 52px,
      transparent 52px,
      transparent 54px,
      #fff 54px,
      #fff 58px,
      transparent 58px,
      transparent 60px
    );
  }

  .copyright {
    border-top: 1px dashed var(--border);

    max-width: 1400px;

    margin: auto;

    padding: 25px 40px;

    display: flex;

    justify-content: space-between;

    font-size: 11px;

    color: #666;

    letter-spacing: 1px;
  }

  @media (max-width: 800px) {
    .footer-line {
      padding: 0 20px;

      flex-direction: column;

      height: auto;

      gap: 15px;

      padding-top: 20px;

      padding-bottom: 20px;
    }

    .footer-main {
      padding: 40px 20px;

      flex-direction: column;
    }

    .barcode {
      position: static;
    }

    .copyright {
      padding: 20px;

      flex-direction: column;

      gap: 10px;
    }
  }
</style>
