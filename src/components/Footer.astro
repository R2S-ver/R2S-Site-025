---
import { getLanguageFromPath, getLocalizedPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const aboutPath = getLocalizedPath("/about", language);
---

<footer class="footer">
  <div class="footer-line">
    <div class="tri-color">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="system">
      {t.footer.system}
    </div>

    <div class="status">
      {t.footer.status}
      <span>{t.footer.online}</span>
    </div>
  </div>

  <div class="footer-main">
    <div class="identity">
      <h3>R2S_STUDIO</h3>

      <p>
        {t.footer.identity}
      </p>

      <div class="meta">
        <div>
          {t.footer.location}
          <strong> ROTTERDAM // NL </strong>
        </div>

        <div>
          {t.footer.statusLabel}
          <strong class="green">
            {t.footer.operational}
          </strong>
        </div>

        <div>
          {t.footer.version}
          <strong> 2026.V5.5 </strong>
        </div>
      </div>
    </div>

    <div class="links">
      <div class="title">
        {t.footer.uplink}
      </div>

      <a
        href="https://github.com/R2S-ver"
        target="_blank"
        rel="noopener noreferrer"
      >
        &gt; {t.footer.github}
      </a>

      <a href="mailto:ranrsuika@gmail.com">
        &gt; {t.footer.email}
      </a>

      <div class="qq">
        &gt; QQ: 2385568240
      </div>

      <a href={aboutPath}>
        &gt; {t.footer.about}
      </a>
    </div>

    <div class="barcode"></div>
  </div>

  <div class="copyright">
    <span>
      © {new Date().getFullYear()} R2S Studio
    </span>

    <span>
      {t.footer.copyright}
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;

    border-top: 1px solid var(--border);

    background: rgba(5, 5, 7, 0.8);

    font-family: var(--font-mono);

    color: #aaa;
  }

  .footer-line {
    height: 70px;

    border-bottom: 1px solid var(--border);

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 40px;

    font-size: 11px;

    letter-spacing: 1px;
  }

  .tri-color {
    display: flex;

    width: 90px;

    height: 8px;
  }

  .tri-color span {
    flex: 1;
  }

  .tri-color span:nth-child(1) {
    background: var(--stripe-red);
  }

  .tri-color span:nth-child(2) {
    background: var(--stripe-yellow);
  }

  .tri-color span:nth-child(3) {
    background: var(--stripe-teal);
  }

  .system {
    color: var(--accent);

    font-weight: bold;
  }

  .status span {
    color: var(--terminal-green);

    font-weight: bold;
  }

  .footer-main {
    position: relative;

    max-width: 1400px;

    margin: auto;

    padding: 60px 40px;

    display: flex;

    justify-content: space-between;

    gap: 60px;
  }

  .identity h3 {
    font-size: 32px;

    font-weight: 900;

    letter-spacing: -1px;

    color: white;

    margin-bottom: 12px;
  }

  .identity p {
    font-size: 13px;

    color: #888;
  }

  .meta {
    margin-top: 30px;

    display: flex;

    flex-direction: column;

    gap: 10px;

    font-size: 12px;
  }

  .meta strong {
    color: white;
  }

  .green {
    color: var(--terminal-green) !important;
  }

  .links {
    display: flex;

    flex-direction: column;

    gap: 15px;

    min-width: 180px;
  }

  .links .title {
    color: var(--accent);

    font-size: 12px;

    font-weight: bold;

    margin-bottom: 10px;
  }

  .links a {
    color: #ccc;

    font-size: 13px;

    transition: 0.2s;
  }

  .links a:hover {
    color: var(--accent);

    transform: translateX(5px);
  }

  .qq {
    color: #ccc;

    font-size: 13px;

    transition: 0.2s;
  }

  .qq:hover {
    color: var(--accent);
  }

  .barcode {
    position: absolute;

    right: 40px;

    bottom: 45px;

    width: 120px;

    height: 45px;

    opacity: 0.3;

    background: repeating-linear-gradient(
      90deg,
      #fff 0px,
      #fff 2px,
      transparent 2px,
      transparent 5px
    );
  }

  .copyright {
    border-top: 1px dashed var(--border);

    max-width: 1400px;

    margin: auto;

    padding: 25px 40px;

    display: flex;

    justify-content: space-between;

    font-size: 11px;

    color: #666;

    letter-spacing: 1px;
  }

  @media (max-width: 800px) {
    .footer-line {
      padding: 0 20px;

      flex-direction: column;

      height: auto;

      gap: 15px;

      padding-top: 20px;

      padding-bottom: 20px;
    }

    .footer-main {
      padding: 40px 20px;

      flex-direction: column;
    }

    .barcode {
      position: static;
    }

    .copyright {
      padding: 20px;

      flex-direction: column;

      gap: 10px;
    }
  }
</style>
