---
import { getProjectImage } from "../utils/images";
import { getLanguageFromPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

interface Props {
  project: any;
  projectId: string;
}

const { project, projectId } = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const gallery: { file: string; title: string }[] = project.data.gallery || [];

const images = gallery.map((item) => ({
  src: getProjectImage(projectId, item.file),
  title: item.title,
}));

const date = project.data.date.toLocaleDateString(
  language === "zh" ? "zh-CN" : "en-US",
  { year: "numeric", month: "long" },
);
---

<main class="art-page">
  <section class="art-hero">
    <p class="hero-tag">VISUAL_ASSET // {project.data.category?.toUpperCase()}</p>
    <h1>{project.data.title}</h1>
    {project.data.description && <p class="hero-desc">{project.data.description}</p>}
    <div class="hero-meta">
      <span>{date}</span>
      {project.data.tools?.length && <span>{project.data.tools.join(" · ")}</span>}
    </div>
  </section>

  <div class="masonry">
    {images.map((img, i) => (
      <div class="masonry-item" data-index={i}>
        <img src={img.src} alt={img.title} loading={i < 6 ? "eager" : "lazy"} />
        <span class="caption">{img.title}</span>
      </div>
    ))}
  </div>

  <aside class="lightbox" id="lightbox" aria-hidden="true">
    <div class="lightbox-bg"></div>
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <button class="lightbox-prev" aria-label="Previous">&lsaquo;</button>
    <button class="lightbox-next" aria-label="Next">&rsaquo;</button>
    <div class="lightbox-body">
      <img src="" alt="" id="lightbox-img" />
      <p class="lightbox-caption" id="lightbox-caption"></p>
      <span class="lightbox-counter" id="lightbox-counter"></span>
    </div>
  </aside>
</main>

<script>
  const images = document.querySelectorAll(".masonry-item");
  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxCaption = document.getElementById("lightbox-caption")!;
  const lightboxCounter = document.getElementById("lightbox-counter")!;
  const btnClose = document.querySelector(".lightbox-close")!;
  const btnPrev = document.querySelector(".lightbox-prev")!;
  const btnNext = document.querySelector(".lightbox-next")!;
  const bg = document.querySelector(".lightbox-bg")!;

  let currentIndex = 0;

  function open(index: number) {
    currentIndex = index;
    updateLightbox();
    lightbox.setAttribute("aria-hidden", "false");
    lightbox.classList.add("active");
    document.body.style.overflow = "hidden";
  }

  function close() {
    lightbox.setAttribute("aria-hidden", "true");
    lightbox.classList.remove("active");
    document.body.style.overflow = "";
  }

  function prev() {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    updateLightbox();
  }

  function next() {
    currentIndex = (currentIndex + 1) % images.length;
    updateLightbox();
  }

  function updateLightbox() {
    const item = images[currentIndex];
    const img = item.querySelector("img") as HTMLImageElement;
    const caption = item.querySelector(".caption")!.textContent;
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightboxCaption.textContent = caption;
    lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;
  }

  images.forEach((item, i) => {
    item.addEventListener("click", () => open(i));
  });

  btnClose.addEventListener("click", close);
  bg.addEventListener("click", close);
  btnPrev.addEventListener("click", (e) => { e.stopPropagation(); prev(); });
  btnNext.addEventListener("click", (e) => { e.stopPropagation(); next(); });

  document.addEventListener("keydown", (e) => {
    if (lightbox.classList.contains("active")) {
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") prev();
      if (e.key === "ArrowRight") next();
    }
  });

  // Swipe support
  let touchStartX = 0;
  lightbox.addEventListener("touchstart", (e) => {
    touchStartX = (e as TouchEvent).touches[0].clientX;
  });
  lightbox.addEventListener("touchend", (e) => {
    const diff = touchStartX - (e as TouchEvent).changedTouches[0].clientX;
    if (Math.abs(diff) > 50) {
      diff > 0 ? next() : prev();
    }
  });
</script>

<style>
  .art-page {
    max-width: 1400px;
    margin: auto;
    padding: 0 40px 80px;
  }

  /* ── Hero ── */
  .art-hero {
    text-align: center;
    padding: 60px 20px 50px;
  }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--accent);
    margin-bottom: 20px;
    opacity: 0.8;
  }

  .art-hero h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 18px;
  }

  .hero-desc {
    font-size: 18px;
    color: #888;
    max-width: 640px;
    margin: 0 auto 20px;
    line-height: 1.7;
  }

  .hero-meta {
    display: flex;
    justify-content: center;
    gap: 30px;
    font-size: 13px;
    color: #666;
    font-family: var(--font-mono);
    letter-spacing: 1px;
  }

  /* ── Masonry ── */
  .masonry {
    column-count: 3;
    column-gap: 20px;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 20px;
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0a0a0f;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .masonry-item:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
  }

  .masonry-item img {
    width: 100%;
    display: block;
    transition: transform 0.5s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.03);
  }

  .masonry-item .caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px 16px 14px;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    color: #fff;
    font-size: 14px;
    font-family: var(--font-mono);
    letter-spacing: 0.5px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .masonry-item:hover .caption {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-bg {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 10, 0.96);
  }

  .lightbox-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 92vw;
    max-height: 92vh;
    z-index: 1;
  }

  .lightbox-body img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 4px 60px rgba(0,0,0,0.5);
  }

  .lightbox-caption {
    color: #ccc;
    font-size: 15px;
    margin-top: 16px;
    font-family: var(--font-mono);
    letter-spacing: 0.5px;
    text-align: center;
  }

  .lightbox-counter {
    color: #666;
    font-size: 12px;
    margin-top: 6px;
    font-family: var(--font-mono);
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 28px;
    z-index: 2;
    font-size: 42px;
    color: #888;
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s;
  }

  .lightbox-close:hover {
    color: #fff;
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    font-size: 56px;
    color: #888;
    background: none;
    border: none;
    cursor: pointer;
    padding: 20px 16px;
    transition: color 0.2s;
    user-select: none;
  }

  .lightbox-prev { left: 12px; }
  .lightbox-next { right: 12px; }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    color: #fff;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .masonry {
      column-count: 2;
    }
  }

  @media (max-width: 700px) {
    .art-page {
      padding: 0 16px 60px;
    }

    .masonry {
      column-count: 1;
      column-gap: 14px;
    }

    .masonry-item {
      margin-bottom: 14px;
    }

    .art-hero {
      padding: 40px 10px 30px;
    }

    .hero-meta {
      flex-direction: column;
      gap: 8px;
    }

    .lightbox-prev,
    .lightbox-next {
      font-size: 36px;
      padding: 12px 8px;
    }

    .lightbox-close {
      font-size: 32px;
      top: 12px;
      right: 16px;
    }

    .lightbox-caption {
      font-size: 13px;
    }
  }
</style>
